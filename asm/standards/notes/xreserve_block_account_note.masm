# xreserve_block_account_note — the shipped, root-pinned block_account admin note script.
#
# The production admin surface for `block_account` under the network account: a fixed-root note whose
# parameter (the account id to block) is CREATOR-COMMITTED in note storage (never NOTE_ARGS, which the
# network executor controls). It stages the note storage into memory, marshals the account id onto the
# stack in the proc's Inputs order, and `call`s the BLK_MANAGER-gated `blocklist_admin::block_account`
# (the sender gate lives in the proc; the note sender is kernel-forced, so a non-BLK_MANAGER creator
# traps there). A scheme-2 NetworkAccountTarget routing attachment addresses the note at the faucet
# (routing-only, added by the Rust factory).
#
# Note storage layout (2 felts): [account_id_suffix, account_id_prefix] — the account to block.

use miden::protocol::active_note
use xreserve::blocklist_admin

# CONSTANTS
# =================================================================================================

# Absolute memory address where the creator-committed params are staged (word-aligned; the mint-note
# INTENT_PTR convention).
const PARAM_PTR = 1024

# The exact note-storage item count for this admin op: [account_id_suffix, account_id_prefix] = 2 felts.
const BLOCK_ACCOUNT_NOTE_NUM_ITEMS = 2

# ERRORS
# =================================================================================================

# The note must carry exactly the 2 param felts; a wrong count is a malformed admin note.
const ERR_XRESERVE_BLOCK_ACCOUNT_NOTE_STORAGE = "block_account note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `block_account` admin note and drives the BLK_MANAGER-gated blocklist add.
#!
#! Stages the creator-committed param (`[account_id_suffix, account_id_prefix]`) into memory at
#! PARAM_PTR, marshals it onto the stack as `[account_id_suffix, account_id_prefix, pad(14)]`, and
#! `call`s `blocklist_admin::block_account`. The note ARGS are unused (executor-controlled).
#!
#! Requires that the account exposes:
#! - xreserve::blocklist_admin::block_account procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is the executor-controlled note-argument word, which this script drops unread.
#! - pad(16) is the 16-element call-boundary pad the note script hands the account procedure.
#!
#! Note storage is assumed to be as follows:
#! - account_id_suffix is item 0 and account_id_prefix is item 1 — the account to block.
#!
#! Panics if:
#! - the note storage does not carry exactly 2 items.
#! - the note sender does not hold the BLK_MANAGER role (blocklist_admin::block_account's role gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # stage the creator-committed params into memory; the executor-controlled note ARGS are ignored.
    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.BLOCK_ACCOUNT_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_BLOCK_ACCOUNT_NOTE_STORAGE
    # => [pad(16)]

    # marshal deepest-first so account_id_suffix (item 0) lands on top, matching the proc's Inputs
    # order [account_id_suffix, account_id_prefix, pad(14)]. Felt-by-felt mem_load (the deposit-intent
    # parser convention) avoids any word-load element-order ambiguity.
    push.PARAM_PTR add.1 mem_load
    # => [account_id_prefix, pad(16)]

    push.PARAM_PTR mem_load
    # => [account_id_suffix, account_id_prefix, pad(16)]

    # (the call consumes the top 16: [account_id_suffix, account_id_prefix, pad(14)])
    call.blocklist_admin::block_account
    # => [pad(18)]

    drop drop
    # => [pad(16)]
end
