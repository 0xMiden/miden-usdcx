# xreserve_grant_role_note — the shipped, root-pinned grant_role admin note script (F5).
#
# The production admin surface for the STOCK `grant_role` under the network account: a fixed-root note
# whose parameters are CREATOR-COMMITTED in note storage (never NOTE_ARGS, which the network executor
# controls). It stages the note storage into memory, marshals the creator's params onto the stack in
# the proc's Inputs order, and `call`s the OWNER-or-role-admin-gated stock
# `miden::standards::access::rbac::grant_role` (the sender gate lives in the proc; the note sender is
# kernel-forced, so an unauthorized creator traps there). The absolute-path `call` resolves to the
# SAME proc root the faucet exposes via the RBAC component re-exports
# (`account_components/access/rbac.masm`). A scheme-2 NetworkAccountTarget routing attachment addresses
# the note at the faucet (routing-only, added by the Rust factory).
#
# Note storage layout (3 felts): [role_symbol, account_suffix, account_prefix].

use miden::protocol::active_note

# CONSTANTS
# =================================================================================================

# Absolute memory address where the creator-committed params are staged (word-aligned; the mint-note
# INTENT_PTR convention, shared with the set_attester reference note).
const PARAM_PTR = 1024

# The exact note-storage item count for this admin op:
# [role_symbol, account_suffix, account_prefix] = 3 felts.
const GRANT_ROLE_NOTE_NUM_ITEMS = 3

# ERRORS
# =================================================================================================

# The note must carry exactly the 3 param felts; a wrong count is a malformed admin note.
const ERR_XRESERVE_GRANT_ROLE_NOTE_STORAGE = "grant_role note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `grant_role` admin note and drives the owner-or-role-admin-gated role grant.
#!
#! Stages the creator-committed params (`[role_symbol, account_suffix, account_prefix]`) into memory
#! at PARAM_PTR, marshals them onto the stack as `[role_symbol, account_suffix, account_prefix,
#! pad(13)]`, and `call`s the stock `rbac::grant_role`. The note ARGS are unused (executor-controlled).
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note storage does not carry exactly 3 items.
#! - the note sender is neither the owner nor a role admin (grant_role's authorization gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # stage the creator-committed params into memory; the executor-controlled note ARGS are ignored.
    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.GRANT_ROLE_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_GRANT_ROLE_NOTE_STORAGE
    # => [pad(16)]

    # marshal deepest-first (offset 2 down to 0) so role_symbol lands on top, matching the proc's
    # Inputs [role_symbol, account_suffix, account_prefix, pad(13)].
    push.PARAM_PTR add.2 mem_load
    # => [account_prefix, pad(16)]

    push.PARAM_PTR add.1 mem_load
    # => [account_suffix, account_prefix, pad(16)]

    push.PARAM_PTR mem_load
    # => [role_symbol, account_suffix, account_prefix, pad(16)]
    # (the call consumes the top 16: [role_symbol, account_suffix, account_prefix, pad(13)])

    call.::miden::standards::access::rbac::grant_role
    # => [pad(16)]

    exec.::miden::core::sys::truncate_stack
end
