# xreserve_identifier_init_note — the shipped, root-pinned identifier_init admin note script.
#
# The production admin surface for the minimized `init_identifier` under the network account
# (the identifier is the ONE domain-config field the account-id fixpoint forces past build
# time; `domain`/`source_domain`/`xreserve_contract` are build-seeded and have no runtime
# writer). A fixed-root note whose parameter is CREATOR-COMMITTED in note storage (never
# NOTE_ARGS, which the network executor controls). It stages the note storage into memory,
# marshals the creator's identifier Word onto the stack in the proc's Inputs order, and `call`s
# the OWNER-gated + init-once `identifier_init::init_identifier` (the sender gate lives in the
# proc; the note sender is kernel-forced, so a non-owner creator traps there). A scheme-2
# NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only, added
# by the Rust factory).
#
# Note storage layout (4 felts): [IDENTIFIER] — the pre-hashed bytes32_to_key Word (the mint
# path's identifier compare reads the stored form). The proc additionally
# derives `bytes32_to_key(account_id_to_bytes32(get_id()))` ON-CHAIN and rejects a committed
# identifier that does not equal it, so this note can only ever seed its target's own identity.

use miden::protocol::active_note
use xreserve::identifier_init

# CONSTANTS
# =================================================================================================

# Absolute memory address where the creator-committed param is staged (word-aligned; the
# admin-note convention the other admin notes share).
const PARAM_PTR = 1024

# The exact note-storage item count for this admin op: [IDENTIFIER] = 4 felts.
const IDENTIFIER_INIT_NOTE_NUM_ITEMS = 4

# ERRORS
# =================================================================================================

# The note must carry exactly the 4 identifier felts; a wrong count is a malformed admin note.
const ERR_XRESERVE_IDENTIFIER_INIT_NOTE_STORAGE = "identifier_init note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `identifier_init` admin note and drives the owner-gated, init-once identifier
#! write.
#!
#! Stages the creator-committed param (`[IDENTIFIER]`) into memory at PARAM_PTR, marshals it onto
#! the stack as `[IDENTIFIER, pad(12)]`, and `call`s `identifier_init::init_identifier`. The note
#! ARGS are unused (executor-controlled).
#!
#! Requires that the account exposes:
#! - xreserve::identifier_init::init_identifier procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is executor-controlled and dropped unread.
#!
#! Note storage is assumed to be as follows:
#! - IDENTIFIER is the pre-hashed bytes32_to_key Word, stored verbatim (4 felts, items 0..4).
#!
#! Panics if:
#! - the note storage does not carry exactly 4 items.
#! - the note sender is not the registered owner (init_identifier's owner gate).
#! - the identifier was already initialized (init_identifier's init-once gate).
#! - the committed identifier is the empty word (init_identifier's non-empty guard).
#! - the committed identifier is not the faucet's own-id key (init_identifier's
#!   own-id binding).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # stage the creator-committed param into memory; the executor-controlled note ARGS are ignored.
    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.IDENTIFIER_INIT_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_IDENTIFIER_INIT_NOTE_STORAGE
    # => [pad(16)]

    # marshal the identifier Word with the word-load primitive (the stock convention
    # for a note-storage word staged by get_storage). The identifier is word- aligned
    # at PARAM_PTR, so `padw` grows the stack by one word and `mem_loadw_le` overwrites
    # it with mem[PARAM_PTR..PARAM_PTR+4] — element-0-on-top, matching the Rust
    # factory's `[identifier[0], identifier[1], identifier[2], identifier[3]]` storage
    # order.
    padw mem_loadw_le.PARAM_PTR
    # => [IDENTIFIER, pad(16)]

    call.identifier_init::init_identifier
    # => [pad(20)]

    dropw
    # => [pad(16)]
end
