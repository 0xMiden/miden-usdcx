# xreserve_pause_note — the root-pinned pause admin note script.
#
# The admin surface for `pause` under the network account: a fixed-root, PARAM-LESS note whose sole
# job is to cross into the faucet account context and `call` the DOM_PAUSER-gated
# `pause_admin::pause`. The sender gate lives in the proc (the note sender is kernel-forced, so a
# non-DOM_PAUSER creator traps there). The executor-controlled NOTE_ARGS are dropped unread. A
# scheme-2 NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only).

use xreserve::pause_admin

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `pause` admin note and drives the DOM_PAUSER-gated emergency halt.
#!
#! Drops the executor-controlled note ARGS (the op is param-less) and `call`s `pause_admin::pause`.
#!
#! Requires that the account exposes:
#! - xreserve::pause_admin::pause procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is executor-controlled and dropped unread.
#!
#! Panics if:
#! - the note sender does not hold the DOM_PAUSER role (pause_admin::pause's role gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    call.pause_admin::pause
    # => [pad(16)]
end
