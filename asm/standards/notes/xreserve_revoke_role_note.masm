# xreserve_revoke_role_note — the root-pinned revoke_role admin note script.
#
# The admin surface for the STOCK `revoke_role` under the network account: a fixed-root note whose
# parameters are CREATOR-COMMITTED in note storage (never NOTE_ARGS). It stages the note storage into
# memory, marshals the creator's params onto the stack in the proc's Inputs order, and `call`s the
# role-admin-gated stock `miden::standards::access::rbac::revoke_role` (the gate is the revoked role's
# EFFECTIVE admin — its delegated admin, else the built-in ADMIN role; the sender gate lives in the
# proc; the note sender is kernel-forced, so an unauthorized creator traps there). The `call` resolves
# to the SAME proc root the faucet exposes via the RBAC component re-exports. A scheme-2
# NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only).
#
# Note storage layout (3 felts): [role_symbol, account_suffix, account_prefix].

use miden::protocol::active_note
use miden::standards::access::rbac

# CONSTANTS
# =================================================================================================

const PARAM_PTR = 1024
const REVOKE_ROLE_NOTE_NUM_ITEMS = 3

# ERRORS
# =================================================================================================

const ERR_XRESERVE_REVOKE_ROLE_NOTE_STORAGE = "revoke_role note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `revoke_role` admin note and drives the role-admin-gated role revocation (the
#! gate is the revoked role's EFFECTIVE admin — see the module header).
#!
#! Stages the creator-committed params (`[role_symbol, account_suffix, account_prefix]`) into memory
#! at PARAM_PTR, marshals them onto the stack as `[role_symbol, account_suffix, account_prefix,
#! pad(13)]`, and `call`s the stock `rbac::revoke_role`. The note ARGS are unused.
#!
#! Requires that the account exposes:
#! - miden::standards::access::rbac::revoke_role procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is executor-controlled and dropped unread.
#!
#! Note storage is assumed to be as follows:
#! - role_symbol is the RoleSymbol felt of the role to revoke (item 0).
#! - account_suffix and account_prefix are the two AccountId felts of the member (items 1 and 2).
#!
#! Panics if:
#! - the note storage does not carry exactly 3 items.
#! - the note sender does not hold the revoked role's effective admin role (revoke_role's
#!   authorization gate, ERR_SENDER_NOT_ROLE_ADMIN).
#! - the account does not hold the role (revoke_role's membership check).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.REVOKE_ROLE_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_REVOKE_ROLE_NOTE_STORAGE
    # => [pad(16)]

    push.PARAM_PTR add.2 mem_load
    push.PARAM_PTR add.1 mem_load
    push.PARAM_PTR mem_load
    # => [role_symbol, account_suffix, account_prefix, pad(16)]

    call.rbac::revoke_role
    # => [pad(19)]

    drop drop drop
    # => [pad(16)]
end
