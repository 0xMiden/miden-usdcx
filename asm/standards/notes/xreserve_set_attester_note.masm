# xreserve_set_attester_note — the root-pinned set_attester admin note script.
#
# The admin surface for `set_attester` under the network account: A scheme-2 NetworkAccountTarget routing
# attachment addresses the note at the faucet (routing-only).
#
# Note storage layout (17 felts): [pub_key(16), attester_idx]. A zero pub_key disables that index.

use xreserve::attestation

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `set_attester` admin note and drives the `ADMIN`-role-gated attester-key write.
#!
#! Requires that the account exposes:
#! - xreserve::attestation::set_attester procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is unused.
#!
#! Panics if:
#! - the note storage is malformed, or the note sender does not hold the `ADMIN` role — both are
#!   `attestation::set_attester`'s own conditions.
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    call.attestation::set_attester
    # => [pad(16)]
end
