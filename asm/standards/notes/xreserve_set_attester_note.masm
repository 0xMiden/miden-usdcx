# xreserve_set_attester_note — the root-pinned set_attester admin note script.
#
# The admin surface for `set_attester` under the network account: a fixed-root note whose parameters
# are CREATOR-COMMITTED in note storage. It binds the note to its target faucet, stages the note
# storage into memory, marshals the creator's params onto the stack in the proc's Inputs order, and
# `call`s the `ADMIN`-role-gated `attester_admin::set_attester` (the sender gate lives in the proc;
# the note sender is kernel-forced, so a creator without the `ADMIN` role traps there).
#
# The scheme-2 NetworkAccountTarget attachment the note carries is enforced here as a CONSUME GATE,
# not merely routing metadata: the standard
# `network_account_target::active_account_matches_target_account` requires the consuming account to
# be the attachment's target, so a foreign account exposing the same procedure cannot race-consume
# the routed note and nullify it (the same binding the standard network-account config notes apply).
#
# Note storage layout (5 felts): [pk_commitment(4), enabled]. `enabled` is 1 (allowlist) or 0 (remove).

use miden::protocol::active_note
use miden::standards::attachments::network_account_target
use xreserve::attester_admin

# CONSTANTS
# =================================================================================================

# The exact note-storage item count for this admin op: [pk_commitment(4), enabled] = 5 felts.
const SET_ATTESTER_NOTE_NUM_ITEMS = 5

# ERRORS
# =================================================================================================

# The note must carry exactly the 5 param felts; a wrong count is a malformed admin note.
const ERR_XRESERVE_SET_ATTESTER_NOTE_STORAGE = "set_attester note storage item count is invalid"

# The consuming account must be the faucet the note's NetworkAccountTarget attachment addresses.
const ERR_XRESERVE_SET_ATTESTER_NOTE_WRONG_FAUCET = "set_attester note is not bound to the consuming faucet"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `set_attester` admin note and drives the `ADMIN`-role-gated attester-allowlist write.
#!
#! Enforces that the consuming account is the note's NetworkAccountTarget, stages the
#! creator-committed params (`[pk_commitment(4), enabled]`) into memory at address zero, marshals
#! them onto the stack as `[PK_COMMITMENT, enabled, pad(11)]`, and `call`s
#! `attester_admin::set_attester`.
#!
#! Requires that the account exposes:
#! - xreserve::attester_admin::set_attester procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is unused.
#!
#! Note storage is assumed to be as follows:
#! - PK_COMMITMENT is the Poseidon2 pubkey commitment to write (4 felts, items 0..4).
#! - enabled is 1 (allowlist: write the enabled marker) or 0 (remove: write EMPTY_WORD) (item 4).
#!
#! Panics if:
#! - the consuming account is not the note's NetworkAccountTarget (a foreign consumer), or the
#!   target attachment is missing/malformed.
#! - the note storage does not carry exactly 5 items.
#! - the note sender does not hold the `ADMIN` role (attester_admin::set_attester's authority gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # faucet binding: enforce the note's scheme-2 NetworkAccountTarget attachment as a consume gate,
    # so a foreign account cannot race-consume this routed note.
    exec.network_account_target::active_account_matches_target_account
    assert.err=ERR_XRESERVE_SET_ATTESTER_NOTE_WRONG_FAUCET
    # => [pad(16)]

    # stage the creator-committed params into memory at address zero.
    push.0 exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.SET_ATTESTER_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_SET_ATTESTER_NOTE_STORAGE
    # => [pad(16)]

    # marshal params deepest-first so pk_commitment element 0 lands on top, matching the
    # proc's Inputs order [PK_COMMITMENT, enabled, pad(11)]. felt-by-felt mem_load avoids any
    # word-load element-order ambiguity.
    push.4 mem_load
    # => [enabled, pad(16)]

    push.3 mem_load
    # => [pk_commitment_3, enabled, pad(16)]

    push.2 mem_load
    # => [pk_commitment_2, pk_commitment_3, enabled, pad(16)]

    push.1 mem_load
    # => [pk_commitment_1, pk_commitment_2, pk_commitment_3, enabled, pad(16)]

    push.0 mem_load
    # => [PK_COMMITMENT, enabled, pad(16)]

    call.attester_admin::set_attester
    # => [pad(21)]

    dropw drop
    # => [pad(16)]
end
