# xreserve_set_min_burn_size_note — the shipped, root-pinned set_min_burn_size admin note script (F5).
#
# The production admin surface for `set_min_burn_size` under the network account: a fixed-root note
# whose parameter is CREATOR-COMMITTED in note storage (never NOTE_ARGS, which the network executor
# controls). It stages the note storage into memory, marshals the creator's param onto the stack in
# the proc's Inputs order, and `call`s the OWNER-gated `min_burn_admin::set_min_burn_size` (the sender
# gate lives in the proc; the note sender is kernel-forced, so a non-owner creator traps there). A
# scheme-2 NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only,
# added by the Rust factory).
#
# Note storage layout (1 felt): [new_min]. `new_min` is the new minimum burn size (AssetAmount).

use miden::protocol::active_note
use miden::core::sys
use xreserve::min_burn_admin

# CONSTANTS
# =================================================================================================

# Absolute memory address where the creator-committed param is staged (word-aligned; the mint-note
# INTENT_PTR convention, shared with the set_attester reference note).
const PARAM_PTR = 1024

# The exact note-storage item count for this admin op: [new_min] = 1 felt.
const SET_MIN_BURN_SIZE_NOTE_NUM_ITEMS = 1

# ERRORS
# =================================================================================================

# The note must carry exactly the 1 param felt; a wrong count is a malformed admin note.
const ERR_XRESERVE_SET_MIN_BURN_SIZE_NOTE_STORAGE = "set_min_burn_size note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `set_min_burn_size` admin note and drives the owner-gated minBurnSize write.
#!
#! Stages the creator-committed param (`[new_min]`) into memory at PARAM_PTR, marshals it onto the
#! stack as `[new_min, pad(15)]`, and `call`s `min_burn_admin::set_min_burn_size`. The note ARGS are
#! unused (executor-controlled).
#!
#! Requires that the account exposes:
#! - xreserve::min_burn_admin::set_min_burn_size procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Note storage is assumed to be as follows:
#! - new_min is the new minimum burn size as an AssetAmount felt (item 0).
#!
#! Panics if:
#! - the note storage does not carry exactly 1 item.
#! - the note sender is not the registered owner (min_burn_admin::set_min_burn_size's owner gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # stage the creator-committed param into memory; the executor-controlled note ARGS are ignored.
    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.SET_MIN_BURN_SIZE_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_SET_MIN_BURN_SIZE_NOTE_STORAGE
    # => [pad(16)]

    push.PARAM_PTR mem_load
    # => [new_min, pad(16)]
    # (the call consumes the top 16: [new_min, pad(15)])

    call.min_burn_admin::set_min_burn_size
    # => [pad(16)]

    exec.sys::truncate_stack
end
