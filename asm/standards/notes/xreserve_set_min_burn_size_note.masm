# xreserve_set_min_burn_size_note — the root-pinned set_min_burn_size admin note script.
#
# The admin surface for the minimum burn size under the network account: a fixed-root note whose
# parameter is CREATOR-COMMITTED in note storage. The note targets the STOCK
# `min_burn_amount::set_min_burn_amount` account procedure
# (authority-gated: under `Authority::OwnerControlled` the sender gate resolves to the Ownable2Step
# owner, and it lives in the proc — a non-owner creator traps there). The stock setter itself accepts
# `new_min = 0`, so THIS SCRIPT carries the zero-floor guard at the only runtime write path:
# `new_min >= 1` is asserted BEFORE the call. A scheme-2 NetworkAccountTarget routing attachment
# addresses the note at the faucet (routing-only).
#
# Note storage layout (1 felt): [new_min]. `new_min` is the new minimum burn size (AssetAmount).

use miden::protocol::active_note
use {FUNGIBLE_ASSET_MAX_AMOUNT} from miden::protocol::asset
use miden::standards::faucets::policies::burn::min_burn_amount

# CONSTANTS
# =================================================================================================

# Absolute memory address where the creator-committed param is staged (word-aligned; the
# admin-note convention the other admin notes share).
const PARAM_PTR = 1024

# The exact note-storage item count for this admin op: [new_min] = 1 felt.
const SET_MIN_BURN_SIZE_NOTE_NUM_ITEMS = 1

# The smallest admissible minimum burn size. The stock MinBurnAmount policy asserts
# `min <= amount`, so a floor of one rejects zero-amount burns without a bespoke
# burn policy; the builder seeds the slot under the same floor.
const MIN_BURN_SIZE_FLOOR = 1

# ERRORS
# =================================================================================================

# The note must carry exactly the 1 param felt; a wrong count is a malformed admin note.
const ERR_XRESERVE_SET_MIN_BURN_SIZE_NOTE_STORAGE = "set_min_burn_size note storage item count is invalid"

# The zero-floor guard: the stock setter accepts 0, so the note rejects any
# new_min below the floor BEFORE calling it.
const ERR_XRESERVE_MIN_BURN_BELOW_FLOOR = "minimum burn size must be at least one"

# The upper-range guard: the stock check_policy asserts `min_burn_amount <= amount`, and every
# real burn amount is <= FUNGIBLE_ASSET_MAX_AMOUNT, so a min above that maximum can never be
# satisfied — no burn would pass and all redemptions would halt. The stock setter does no range
# check, so the note rejects `new_min > FUNGIBLE_ASSET_MAX_AMOUNT` BEFORE calling it.
const ERR_XRESERVE_MIN_BURN_ABOVE_MAX = "min burn size exceeds the maximum asset amount"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `set_min_burn_size` admin note and drives the owner-gated minimum-burn write
#! through the STOCK `set_min_burn_amount`, enforcing both range bounds first.
#!
#! Both bounds are this note's own: the stock setter accepts 0, which would make every burn legal,
#! and an over-large floor would halt all redemptions.
#!
#! Requires that the account exposes:
#! - miden::standards::faucets::policies::burn::min_burn_amount::set_min_burn_amount procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is unused.
#!
#! Note storage is assumed to be as follows:
#! - new_min is the new minimum burn size as an AssetAmount felt (item 0), at least 1.
#!
#! Panics if:
#! - the note storage does not carry exactly 1 item.
#! - new_min is below the floor (ERR_XRESERVE_MIN_BURN_BELOW_FLOOR).
#! - new_min exceeds FUNGIBLE_ASSET_MAX_AMOUNT (ERR_XRESERVE_MIN_BURN_ABOVE_MAX, the
#!   upper-range guard — an out-of-range floor would halt all redemptions).
#! - the note sender is not authorized per the installed Authority (the stock setter's
#!   authority::assert_authorized -> the Ownable2Step owner).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # stage the creator-committed param into memory.
    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.SET_MIN_BURN_SIZE_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_SET_MIN_BURN_SIZE_NOTE_STORAGE
    # => [pad(16)]

    push.PARAM_PTR mem_load
    # => [new_min, pad(16)]

    # the zero-floor guard: new_min >= 1, asserted BEFORE the stock call.
    # `neq.0` suffices for the floor of one — an AssetAmount felt is non-negative, so
    # `new_min != 0` is exactly `new_min >= 1`.
    dup neq.0 assert.err=ERR_XRESERVE_MIN_BURN_BELOW_FLOOR
    # => [new_min, pad(16)]

    # the upper-range guard: new_min <= FUNGIBLE_ASSET_MAX_AMOUNT, asserted BEFORE the stock
    # call. `lte.CONST` compares the AssetAmount felt against the max (the stock fungible-asset
    # bound-check idiom); a value above the max would make the stock `min <= amount` policy
    # unsatisfiable for every burn.
    dup lte.FUNGIBLE_ASSET_MAX_AMOUNT assert.err=ERR_XRESERVE_MIN_BURN_ABOVE_MAX
    # => [new_min, pad(16)]

    call.min_burn_amount::set_min_burn_amount
    # => [pad(17)]

    drop
    # => [pad(16)]
end
