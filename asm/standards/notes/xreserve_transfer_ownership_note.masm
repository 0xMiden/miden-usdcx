# xreserve_transfer_ownership_note — the root-pinned transfer_ownership admin note.
#
# The admin surface for the STOCK `transfer_ownership` under the network account: a fixed-root note
# whose parameters are CREATOR-COMMITTED in note storage. It stages the note storage into memory,
# marshals the creator's params onto the stack in the proc's Inputs order, and `call`s the
# current-OWNER-gated stock `miden::standards::access::ownable2step::transfer_ownership` (the note
# sender is kernel-forced, so a non-owner creator traps there). This is step 1 of the 2-step transfer:
# it sets the pending (nominated) owner; the current owner is UNCHANGED until the nominee accepts. The
# `call` resolves to the SAME proc root the faucet exposes via the Ownable2Step component re-exports.
# A scheme-2 NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only).
#
# Note storage layout (2 felts): [new_owner_suffix, new_owner_prefix].

use miden::protocol::active_note
use miden::standards::access::ownable2step

# CONSTANTS
# =================================================================================================

const PARAM_PTR = 1024
const TRANSFER_OWNERSHIP_NOTE_NUM_ITEMS = 2

# ERRORS
# =================================================================================================

const ERR_XRESERVE_TRANSFER_OWNERSHIP_NOTE_STORAGE = "transfer_ownership note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `transfer_ownership` admin note and nominates the pending owner (step 1 of 2).
#!
#! Stages the creator-committed params (`[new_owner_suffix, new_owner_prefix]`) into memory at
#! PARAM_PTR, marshals them onto the stack as `[new_owner_suffix, new_owner_prefix, pad(14)]`, and
#! `call`s the stock `ownable2step::transfer_ownership`.
#!
#! Requires that the account exposes:
#! - miden::standards::access::ownable2step::transfer_ownership procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is unused.
#!
#! Note storage is assumed to be as follows:
#! - new_owner_suffix and new_owner_prefix are the two AccountId felts of the nominated owner
#!   (items 0 and 1).
#!
#! Panics if:
#! - the note storage does not carry exactly 2 items.
#! - the note sender is not the current owner (transfer_ownership's owner gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    push.PARAM_PTR exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.TRANSFER_OWNERSHIP_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_TRANSFER_OWNERSHIP_NOTE_STORAGE
    # => [pad(16)]

    push.PARAM_PTR add.1 mem_load
    push.PARAM_PTR mem_load
    # => [new_owner_suffix, new_owner_prefix, pad(16)]

    call.ownable2step::transfer_ownership
    # => [pad(18)]

    drop drop
    # => [pad(16)]
end
