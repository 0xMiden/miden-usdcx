# xreserve_unpause_note — the shipped, root-pinned unpause admin note script (F5).
#
# The production admin surface for `unpause` under the network account: a fixed-root, PARAM-LESS note
# whose sole job is to cross into the faucet account context and `call` the DOM_PAUSER-gated
# `pause_admin::unpause`. The sender gate lives in the proc (the note sender is kernel-forced, so a
# non-DOM_PAUSER creator traps there). The executor-controlled NOTE_ARGS are dropped and never read.
# A scheme-2 NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only,
# added by the Rust factory).

use miden::core::sys
use xreserve::pause_admin

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `unpause` admin note and drives the DOM_PAUSER-gated resume.
#!
#! Drops the executor-controlled note ARGS (the op is param-less) and `call`s `pause_admin::unpause`.
#!
#! Requires that the account exposes:
#! - xreserve::pause_admin::unpause procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold the DOM_PAUSER role (pause_admin::unpause's role gate).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    call.pause_admin::unpause
    # => [pad(16)]

    exec.sys::truncate_stack
end
