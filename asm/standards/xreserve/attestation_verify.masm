# xreserve::attestation_verify
#
# FAUCET(01)-owned mint-time deposit-attestation verify shell (P5-01 slice D5d): keccak the
# DepositIntent payload, gate the candidate attester pubkey against the xReserveAttesters
# allowlist (R-MINT-13), and ECDSA-verify the Circle signature over keccak256(payload)
# (R-MINT-14). Built as ONE slice: the SAME word-aligned pubkey local region feeds BOTH the
# allowlist-commitment lookup AND verify_prehash, so a pubkey checked against the allowlist can
# only pass with its OWN signature (the load-bearing seam). Consumes the built/proven primitives
# BY REFERENCE: xreserve::encoding::pubkey_commitment (04 ATT), keccak256::hash_bytes +
# ecdsa_k256_keccak::verify_prehash (precompiles), active_account::get_map_item (kernel). Module
# home + nested path per D-1A. Loop history: crates/xusdc-encoding/TEST-LEDGER-01-MINT-SHELL.md.

use miden::protocol::active_account
use miden::core::crypto::hashes::keccak256
use miden::core::crypto::dsa::ecdsa_k256_keccak
use miden::core::word
use xreserve::encoding

# CONSTANTS
# =================================================================================================

# Attester allowlist (frozen §5.5 XReserveAttesterAdmin): the xReserveAttesters StorageMap slot,
# keyed by Poseidon2(33-byte compressed pubkey) -> enabled-marker Word (absent / EMPTY_WORD = not
# allowlisted). The later set_attester admin setter co-owns this SAME slot. The map-slot
# DECLARATION is Rust-side (StorageSlot::with_map; canary-proven); this const is the MASM slot id.
pub const XRESERVE_ATTESTERS_SLOT = word("xusdc::xreserve::attester_admin::xreserve_attesters")

# ERRORS
# =================================================================================================

# R-MINT-13: the candidate pubkey's Poseidon2 commitment is not enabled in xReserveAttesters.
const ERR_XRESERVE_BAD_PK_COMMITMENT = "deposit attester pubkey commitment is not allowlisted"

# R-MINT-14: the ECDSA signature does not verify over keccak256(payload) for the candidate pubkey.
const ERR_XRESERVE_SIG_INVALID = "deposit attestation signature verification failed"

# PUBLIC INTERFACE
# =================================================================================================

#! Verifies the mint-time deposit attestation: keccak the payload, gate the attester pubkey
#! against the xReserveAttesters allowlist (R-MINT-13), and ECDSA-verify the signature over the
#! keccak digest (R-MINT-14).
#!
#! The candidate pubkey is materialized ONCE into the word-aligned pubkey local region; that same
#! region feeds BOTH the allowlist commitment (pubkey_commitment) and the signature check
#! (verify_prehash pk_ptr), so an allowlisted commitment cannot be paired with a foreign
#! signature. Consumes the 04 / precompile / kernel primitives by reference.
#!
#! Locals (@locals(40), word-aligned sub-regions, mirroring the precompile-canary verify_prehash
#! materialization): loc[0..9] candidate pubkey (9 felts), loc[12..20] keccak digest (8 felts),
#! loc[20..37] signature (17 felts).
#!
#! Inputs:  [intent_ptr, len_bytes]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent payload preimage.
#! - len_bytes is the payload length in bytes (keccak's hashed extent; equals the bytes the
#!   attester signed).
#!
#! Panics if:
#! - the pubkey or signature advice is missing or short (fail-closed materialization).
#! - the candidate pubkey's commitment is not allowlisted (R-MINT-13).
#! - the signature does not verify over the payload digest (R-MINT-14).
#!
#! Invocation: exec
@locals(40)
pub proc verify_attestation
    # => [intent_ptr, len_bytes]

    # keccak the full payload -> 8-limb digest, stored to the digest local region. hash_bytes
    # consumes [intent_ptr, len_bytes] and leaves the digest above a restored depth-16 floor.
    exec.keccak256::hash_bytes
    # => [DIGEST_U32[8], pad(16)]

    loc_storew_le.12 dropw
    loc_storew_le.16 dropw
    # => [pad(16)]

    # materialize the candidate pubkey (9 felts) then the signature (17 felts) from the advice
    # stack into word-aligned locals. ONE pubkey read into loc[0..9] -- the seam region. Missing or
    # short advice traps in adv_push*, fail-closed (never defaults). Advice seed order [PK, SIG].
    adv_pushw loc_storew_le.0 dropw
    adv_pushw loc_storew_le.4 dropw
    adv_push loc_store.8
    # => [pad(16)]

    adv_pushw loc_storew_le.20 dropw
    adv_pushw loc_storew_le.24 dropw
    adv_pushw loc_storew_le.28 dropw
    adv_pushw loc_storew_le.32 dropw
    adv_push loc_store.36
    # => [pad(16)]

    # allowlist gate (R-MINT-13): load the pubkey from loc[0..9] (the seam region) and consume the
    # 04-owned pubkey_commitment to get COMM, then read xReserveAttesters[COMM].
    loc_load.8
    padw loc_loadw_le.4
    padw loc_loadw_le.0
    # => [PK_W0, PK_W1, pk8, pad(16)]

    exec.encoding::pubkey_commitment
    # => [COMM, pad(16)]

    push.XRESERVE_ATTESTERS_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, COMM, pad(16)]

    exec.active_account::get_map_item
    # => [VALUE, pad(16)]

    swapw dropw
    # => [VALUE, pad(12)]

    # allowlist gate (R-MINT-13): the stored value must be a non-empty enabled marker -- an
    # absent / EMPTY_WORD value means the candidate pubkey's commitment is not allowlisted.
    exec.word::eqz
    # => [is_empty, pad(12)]

    assertz.err=ERR_XRESERVE_BAD_PK_COMMITMENT
    # => [pad(16)]

    # the ECDSA verify (R-MINT-14): verify_prehash over the SAME pubkey region (loc[0..9]), the digest
    # (loc[12..20]), and the signature (loc[20..37]).
    locaddr.20 locaddr.12 locaddr.0
    # => [pk_ptr, digest_ptr, sig_ptr, pad(16)]

    exec.ecdsa_k256_keccak::verify_prehash
    # => [result, pad(16)]

    # assert R-MINT-14: the signature must verify over the payload digest for the candidate pubkey.
    assert.err=ERR_XRESERVE_SIG_INVALID
    # => [pad(16)]
end
