# xreserve::attestation_verify
#
# The mint-time deposit-attestation check. Its contract is documented on `verify_attestation`
# itself; this file ensures a mint proceeds only for a deposit Circle actually signed.

use miden::protocol::active_account
use miden::core::crypto::hashes::keccak256
use miden::core::crypto::dsa::ecdsa_k256_keccak
use miden::core::crypto::hashes::poseidon2
use miden::core::word
use {XRESERVE_ATTESTERS_SLOT, ATTESTER_ENABLED_MARKER} from xreserve::attester_admin

# CONSTANTS
# =================================================================================================

# `verify_attestation` memory locals.
const DIGEST_LO_LOC = 0
const DIGEST_HI_LOC = 4

# The number of elements in a packed secp256k1 pubkey.
const PUBKEY_FELTS = 16

# ERRORS
# =================================================================================================

# The candidate pubkey's Poseidon2 commitment is not enabled in xReserveAttesters.
const ERR_XRESERVE_DISALLOWED_PUB_KEY = "deposit attester pubkey commitment is not allowlisted"

# The ECDSA signature does not verify over keccak256(payload) for the candidate pubkey.
const ERR_XRESERVE_SIG_INVALID = "deposit attestation signature verification failed"

# PUBLIC INTERFACE
# =================================================================================================

#! Verifies the mint-time deposit attestation: keccak the payload, gate the attester pubkey
#! against the xReserveAttesters allowlist, and ECDSA-verify the signature over the keccak
#! digest.
#!
#! The caller owns the pubkey and signature bytes and passes pointers to them; this procedure
#! reads nothing from the advice provider, so whatever memory the caller hash-verified is exactly
#! what gets checked here.
#!
#! Inputs:  [intent_ptr, intent_num_bytes, pubkey_ptr, signature_ptr]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent payload preimage.
#! - intent_num_bytes is the payload length in bytes (keccak's hashed extent; equals the bytes the
#!   attester signed).
#! - pubkey_ptr is the word-aligned memory address of the candidate attester pubkey, 16
#!   u32-LE-packed affine-coordinate felts.
#! - signature_ptr is the word-aligned memory address of the 17-felt attestation signature.
#!
#! Panics if:
#! - the candidate pubkey's commitment is not allowlisted (ERR_XRESERVE_DISALLOWED_PUB_KEY).
#! - the signature does not verify over the payload digest (ERR_XRESERVE_SIG_INVALID).
#!
#! Locals:
#! - 0..8: DIGEST
#!
#! Invocation: exec
@locals(8)
pub proc verify_attestation
    # => [intent_ptr, intent_num_bytes, pubkey_ptr, signature_ptr]
    # hash the full payload -> 8-limb digest.
    exec.keccak256::hash_bytes
    # => [DIGEST_U32[8], pubkey_ptr, signature_ptr]

    loc_storew_le.DIGEST_LO_LOC dropw
    loc_storew_le.DIGEST_HI_LOC dropw
    # => [pubkey_ptr, signature_ptr]

    # allowlist gate: commit to the caller's pubkey, then read
    # xReserveAttesters[PUBKEY_COMMITMENT].
    dup exec.pubkey_commitment
    # => [PUBKEY_COMMITMENT, pubkey_ptr, signature_ptr]

    push.XRESERVE_ATTESTERS_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, PUBKEY_COMMITMENT, pubkey_ptr, signature_ptr]

    exec.active_account::get_map_item
    # => [MARKER, pubkey_ptr, signature_ptr]

    # the stored value must match the enabled marker to be considered allowlisted
    push.ATTESTER_ENABLED_MARKER exec.word::eq
    # => [is_allowed, pubkey_ptr, signature_ptr]

    assert.err=ERR_XRESERVE_DISALLOWED_PUB_KEY
    # => [pubkey_ptr, signature_ptr]

    # the ECDSA verify: verify_prehash over the SAME pubkey the allowlist gate just cleared, the
    # digest, and the caller's signature.
    locaddr.DIGEST_LO_LOC swap
    # => [pubkey_ptr, digest_ptr, signature_ptr]

    exec.ecdsa_k256_keccak::verify_prehash
    # => [result]

    # the signature must verify over the payload digest for the candidate pubkey.
    assert.err=ERR_XRESERVE_SIG_INVALID
    # => []
end

#! Computes the commitment of the provided public key.
#!
#! Computes the Poseidon2 hash over the 16 u32-LE-packed affine-coordinate limbs, which is the
#! attester-allowlist map key.
#!
#! Inputs:  [pubkey_ptr]
#! Outputs: [PUBKEY_COMMITMENT]
#!
#! Where:
#! - pubkey_ptr is the word-aligned memory address of the 16 packed pubkey felts.
#! - PUBKEY_COMMITMENT is the Poseidon2 commitment Word.
#!
#! Invocation: exec
pub proc pubkey_commitment
    push.PUBKEY_FELTS swap exec.poseidon2::hash_elements
    # => [PUBKEY_COMMITMENT]
end
