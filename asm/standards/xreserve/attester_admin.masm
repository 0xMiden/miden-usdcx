# xreserve::attester_admin
#
# The owner-gated deposit-attester allowlist setter (set_attester): the `set_attester` setter writes
# the xReserveAttesters allowlist — the on-chain write completing the D5d read seam
# (attestation_verify.masm, R-MINT-13). Reuses the stock access primitives BY REFERENCE:
# authority::assert_authorized (the account-wide Authority::OwnerControlled gate ->
# ownable2step::assert_sender_is_owner on the note sender) + native_account::set_map_item (the write).
# No custom owner/RBAC logic. The setter is intentionally NOT pause-gated (matching Circle's onlyOwner
# model, F6).

use miden::protocol::native_account
use miden::standards::access::authority

# CONSTANTS
# =================================================================================================

# The xReserveAttesters allowlist StorageMap slot — byte-identical to attestation_verify.masm:26 (the
# D5d read path keys the SAME slot). The slot id both modules derive from this one name string is the
# single source of truth; the Rust XRESERVE_ATTESTERS_SLOT_LABEL binds the identical string.
pub const XRESERVE_ATTESTERS_SLOT = word("xusdc::xreserve::attester_admin::xreserve_attesters")

# The non-empty enabled marker written into xReserveAttesters[PK_COMMITMENT] when enabled = 1 (== the
# fixture MARKER; the D5d read path asserts only that the stored value is non-empty). enabled = 0
# writes EMPTY_WORD, which the read path treats as "not allowlisted".
const ATTESTER_ENABLED_MARKER = [1, 0, 0, 0]

# PUBLIC INTERFACE
# =================================================================================================

#! Enables (enabled = 1) or disables (enabled = 0) a deposit attester keyed by its pubkey
#! commitment — the OWNER-gated setter for the xReserveAttesters allowlist. It trusts the caller's
#! commitment Word verbatim and does NOT recompute it from a raw pubkey.
#!
#! Inputs:  [PK_COMMITMENT, enabled, pad(11)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - PK_COMMITMENT is the Poseidon2 pubkey commitment (the xReserveAttesters map key).
#! - enabled is 1 (allowlist: write the enabled marker) or 0 (remove: write EMPTY_WORD).
#!
#! Panics if:
#! - the note sender is not the registered owner (authority::assert_authorized ->
#!   ownable2step::assert_sender_is_owner, ERR_SENDER_NOT_OWNER).
#! - `enabled` is not a boolean (the `if.true` binary constraint).
#!
#! Invocation: call
@locals(4)
@account_procedure
pub proc set_attester
    # => [PK_COMMITMENT, enabled, pad(11)]

    # gate: the Ownable2Step owner (sender-based) ONLY — intentionally NOT pause-gated (Circle's
    # onlyOwner model, F6), so the owner may disable a compromised attester while the faucet is paused.
    # reads account storage and is operand-stack-neutral.
    exec.authority::assert_authorized
    # => [PK_COMMITMENT, enabled, pad(11)]

    # stash the caller-supplied commitment (the map key) into loc[0..4], trusted verbatim. The
    # `_le` store leaves the word on the stack, so drop the copy.
    loc_storew_le.0 dropw
    # => [enabled, pad(11)]

    # the written VALUE = enabled ? ATTESTER_ENABLED_MARKER : EMPTY_WORD. `if.true` requires
    # `enabled` to be boolean, so a non-bool can never write a non-canonical marker.
    if.true
        push.ATTESTER_ENABLED_MARKER
    else
        padw
    end
    # => [VALUE, pad(11)]

    # xReserveAttesters[PK_COMMITMENT] := VALUE.
    padw loc_loadw_le.0
    # => [PK_COMMITMENT, VALUE, pad(11)]

    push.XRESERVE_ATTESTERS_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, PK_COMMITMENT, VALUE, pad(11)]

    exec.native_account::set_map_item dropw
    # => [pad(16)]
end
