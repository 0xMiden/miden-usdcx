# xreserve::attester_admin
#
# The owner-gated deposit-attester allowlist setter (set_attester): writes the
# xReserveAttesters allowlist — the write side of the allowlist that attestation_verify.masm
# reads at mint time. Reuses the standard access primitives:
# authority::assert_authorized (the account-wide Authority::OwnerControlled gate ->
# ownable2step::assert_sender_is_owner on the note sender) + native_account::set_map_item (the write).
# No custom owner/RBAC logic. The setter is intentionally NOT pause-gated (matching Circle's
# onlyOwner model).

use miden::protocol::native_account
use miden::standards::access::authority

# CONSTANTS
# =================================================================================================

# The xReserveAttesters allowlist StorageMap slot — the single MASM-side declaration; the mint-time
# read path in attestation_verify.masm imports it. The name string is the single source of truth for
# the slot id; the Rust XRESERVE_ATTESTERS_SLOT_LABEL binds the identical string.
pub const XRESERVE_ATTESTERS_SLOT = word("xusdc::xreserve::attester_admin::xreserve_attesters")

# The marker written into xReserveAttesters[PK_COMMITMENT] when enabled = 1 — the mint-time read
# path admits an attester only on an exact match against it.
pub const ATTESTER_ENABLED_MARKER = [1, 0, 0, 0]

# The marker written when enabled = 0. Equal to EMPTY_WORD, so a disabled row is indistinguishable
# from an absent one on the read path.
const ATTESTER_DISABLED_MARKER = [0, 0, 0, 0]

# PUBLIC INTERFACE
# =================================================================================================

#! Enables (enabled = 1) or disables (enabled = 0) a deposit attester keyed by its pubkey
#! commitment — the OWNER-gated setter for the xReserveAttesters allowlist. It trusts the caller's
#! commitment Word verbatim and does NOT recompute it from a raw pubkey.
#!
#! Inputs:  [PK_COMMITMENT, enabled, pad(11)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - PK_COMMITMENT is the Poseidon2 pubkey commitment (the xReserveAttesters map key).
#! - enabled is 1 (allowlist: write the enabled marker) or 0 (remove: write EMPTY_WORD).
#!
#! Panics if:
#! - the note sender is not the registered owner (authority::assert_authorized ->
#!   ownable2step::assert_sender_is_owner, ERR_SENDER_NOT_OWNER).
#! - `enabled` is not a boolean (the `cdropw` binary constraint).
#!
#! Invocation: call
@account_procedure
pub proc set_attester
    # gate: the Ownable2Step owner (sender-based) ONLY — intentionally NOT pause-gated (Circle's
    # onlyOwner model), so the owner may disable a compromised attester while the faucet is paused
    exec.authority::assert_authorized
    # => [PK_COMMITMENT, enabled, pad(11)]

    push.ATTESTER_DISABLED_MARKER push.ATTESTER_ENABLED_MARKER movup.12
    # => [enabled, ENABLED_MARKER, DISABLED_MARKER, PK_COMMITMENT, pad(11)]

    # enabled = 1 keeps ENABLED_MARKER, enabled = 0 keeps DISABLED_MARKER.
    cdropw
    # => [MARKER, PK_COMMITMENT, pad(11)]

    swapw
    # => [PK_COMMITMENT, MARKER, pad(11)]

    push.XRESERVE_ATTESTERS_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, PK_COMMITMENT, MARKER, pad(11)]

    # xReserveAttesters[PK_COMMITMENT] = MARKER.
    exec.native_account::set_map_item dropw
    # => [pad(16)]
end
