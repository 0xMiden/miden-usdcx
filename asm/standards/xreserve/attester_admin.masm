# xreserve::attester_admin
#
# The authority-gated deposit-attester allowlist setter (set_attester): writes the
# xReserveAttesters allowlist — the write side of the allowlist that attestation_verify.masm
# reads at mint time. Reuses the standard access primitives:
# authority::assert_authorized (the account-wide Authority gate) + native_account::set_map_item
# (the write). No custom owner/RBAC logic. Under the account's role-based authority this procedure
# carries no role assignment of its own, so the gate resolves to the built-in ADMIN role, whose sole
# seeded member is the bootstrap administrator's account — the same identity that held the
# capability under the earlier owner-based authority. The setter is intentionally NOT pause-gated
# (matching Circle's onlyOwner model).

use miden::protocol::native_account
use miden::standards::access::authority

# CONSTANTS
# =================================================================================================

# The xReserveAttesters allowlist StorageMap slot, keyed by Poseidon2(16 affine pubkey felts)
# -> enabled-marker Word. The mint-time read path (attestation_verify) imports this const, so
# both sides key the SAME slot; the name string is the single source of truth for the slot id.
pub const XRESERVE_ATTESTERS_SLOT = word("xusdc::xreserve::attester_admin::xreserve_attesters")

# The non-empty enabled marker written into xReserveAttesters[PK_COMMITMENT] when enabled = 1
# (the read path asserts only that the stored value is non-empty). enabled = 0 writes
# EMPTY_WORD, which the read path treats as "not allowlisted".
const ATTESTER_ENABLED_MARKER = [1, 0, 0, 0]

# set_attester locals: the caller-supplied commitment Word (the map key), staged verbatim.
const PK_COMMITMENT_LOC = 0

# PUBLIC INTERFACE
# =================================================================================================

#! Enables (enabled = 1) or disables (enabled = 0) a deposit attester keyed by its pubkey
#! commitment — the `ADMIN`-gated setter for the xReserveAttesters allowlist. It trusts the caller's
#! commitment Word verbatim and does NOT recompute it from a raw pubkey.
#!
#! Inputs:  [PK_COMMITMENT, enabled, pad(11)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - PK_COMMITMENT is the Poseidon2 pubkey commitment (the xReserveAttesters map key).
#! - enabled is 1 (allowlist: write the enabled marker) or 0 (remove: write EMPTY_WORD).
#!
#! Panics if:
#! - the note sender does not hold the role the account's authority requires for this procedure
#!   (authority::assert_authorized -> rbac::assert_sender_is_admin, ERR_SENDER_LACKS_ROLE).
#! - `enabled` is not a boolean (the `if.true` binary constraint).
#!
#! Invocation: call
@locals(4)
@account_procedure
pub proc set_attester
    # gate on the account-wide authority (sender-based) only. reads account storage and is
    # operand-stack-neutral.
    exec.authority::assert_authorized
    # => [PK_COMMITMENT, enabled, pad(11)]

    # store the caller-supplied commitment (the map key) into the locals, trusted verbatim. The
    # `_le` store leaves the word on the stack, so drop the copy.
    loc_storew_le.PK_COMMITMENT_LOC dropw
    # => [enabled, pad(11)]

    # the written VALUE = enabled ? ATTESTER_ENABLED_MARKER : EMPTY_WORD. `if.true` requires
    # `enabled` to be boolean.
    if.true
        push.ATTESTER_ENABLED_MARKER
    else
        padw
    end
    # => [VALUE, pad(11)]

    # xReserveAttesters[PK_COMMITMENT] := VALUE.
    padw loc_loadw_le.PK_COMMITMENT_LOC
    # => [PK_COMMITMENT, VALUE, pad(11)]

    push.XRESERVE_ATTESTERS_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, PK_COMMITMENT, VALUE, pad(11)]

    exec.native_account::set_map_item dropw
    # => [pad(16)]
end
