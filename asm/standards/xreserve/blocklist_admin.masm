# xreserve::blocklist_admin
#
# Block and unblock, gated on BLK_MANAGER.
#
# Circle's model puts the transfer blocklist under an EXTERNAL entity holding only that role — not
# the owner, who also controls set_attester, the supply cap and ownership itself. The stock
# BlocklistOwnerControlled gates on the owner instead, so these procs wrap the unauthenticated
# blocklist primitives in a role check. The blocked_accounts slot they write belongs to the
# BasicBlocklist companion, wired as the active send and receive policy.

use miden::protocol::native_account
use miden::protocol::account_id
use miden::standards::access::rbac
use miden::standards::faucets::policies::transfer::blocklist

# CONSTANTS
# =================================================================================================

# The BLK_MANAGER RoleSymbol encoded as a Felt (RoleSymbol::as_element, base-27 over A-Z/_).
# HARD-CODED here rather than caller-supplied, so no role a caller merely holds can be substituted
# for BLK_MANAGER.
const BLK_MANAGER_ROLE = 7907587873290749

# ERRORS
# =================================================================================================

# The self-block guard. BasicBlocklist is the ACTIVE send AND receive transfer policy, so a blocked
# account can neither send, receive, nor burn/redeem. Blocking the faucet's OWN id would therefore
# freeze it as a transfer party, halting both mint-and-send and burn/redeem, so `block_account`
# rejects the native faucet id as its target. Only `block_account` carries the guard, unblocking the
# faucet being harmless.
const ERR_XRESERVE_CANNOT_BLOCK_SELF = "cannot block the faucet's own account"

# PUBLIC INTERFACE
# =================================================================================================

#! Adds an account to the transfer blocklist: it can then neither send, receive, nor redeem.
#!
#! Inputs:  [account_id_suffix, account_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - account_id_suffix and account_id_prefix are the AccountId felts of the account to block.
#!
#! Panics if:
#! - the note sender does not hold BLK_MANAGER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#! - the target account id is the faucet's OWN account id (ERR_XRESERVE_CANNOT_BLOCK_SELF, the
#!   self-block guard — blocking the faucet freezes it as a transfer party).
#!
#! Invocation: call
@account_procedure
pub proc block_account
    push.BLK_MANAGER_ROLE
    # => [BLK_MANAGER_ROLE, account_id_suffix, account_id_prefix, pad(13)]

    exec.rbac::assert_sender_has_role
    # => [account_id_suffix, account_id_prefix, pad(14)]

    # self-block guard: a target equal to the transaction's own account id is rejected before the
    # add is delegated. the compare runs on copies, leaving the original target on the stack for the
    # add below. `native_account::get_id` is the account the admin note is being consumed against.
    exec.native_account::get_id
    # => [own_id_suffix, own_id_prefix, account_id_suffix, account_id_prefix, pad(14)]

    dup.3 dup.3 exec.account_id::eq
    # => [is_self, account_id_suffix, account_id_prefix, pad(14)]

    assertz.err=ERR_XRESERVE_CANNOT_BLOCK_SELF
    # => [account_id_suffix, account_id_prefix, pad(14)]

    exec.blocklist::block_account
    # => [pad(16)]
end

#! Removes an account from the transfer blocklist. Same role gate as `block_account`.
#! Inputs:  [account_id_suffix, account_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - account_id_suffix and account_id_prefix are the AccountId felts of the account to unblock.
#!
#! Panics if:
#! - the note sender does not hold BLK_MANAGER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#!
#! Invocation: call
@account_procedure
pub proc unblock_account
    push.BLK_MANAGER_ROLE
    # => [BLK_MANAGER_ROLE, account_id_suffix, account_id_prefix, pad(13)]

    exec.rbac::assert_sender_has_role
    # => [account_id_suffix, account_id_prefix, pad(14)]

    exec.blocklist::unblock_account
    # => [pad(16)]
end
