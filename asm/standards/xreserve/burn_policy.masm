# xreserve::burn_policy
#
# FAUCET(01)-owned burn security policy (P5-01 CMP-A10, R-BURN-1/2): the ACTIVE burn policy of the
# faucet's TokenPolicyManager. Stock `receive_and_burn` (fungible.masm:390-446) routes every burn
# through `policy_manager::execute_burn_policy`, which -- AFTER the stock pause gate -- `dynexec`s the
# active burn-policy proc root (policy_manager.masm:355-370). Registering this `check_policy` as that
# active root gates every burn on the real security predicate: R-BURN-1 (amount > 0) + R-BURN-2
# (amount >= minBurnSize). R-BURN-3 (a paused faucet halts the burn) is enforced by the stock
# `execute_burn_policy` wrapper BEFORE this policy is dispatched (DECISION-RBURN3-PAUSE-ERROR-
# RECONCILIATION.md), so this policy does NOT check pause -- it never runs when paused. Module home +
# flat path per D-1A (CANONICAL-OWNERSHIP-MAP.md).
#
# SHELL (executing-red): the body is a behavioral NO-OP -- it clears the 8-cell burn-policy stack and
# ACCEPTS every burn. The real R-BURN-1/2 checks land in the GREEN commit. The two NET-NEW error
# consts + the `MIN_BURN_SIZE_SLOT` name const are declared now (parity-locked) but are unused by the
# no-op shell; the green commit references them.

# CONSTANTS
# =================================================================================================

# The minBurnSize value StorageSlot (§5.5 XReserveAttesterAdmin home, SPEC-OWNER RATIFIED). Holds the
# Word [min_burn_size, 0, 0, 0]; R-BURN-2 reads element 0. The Rust MIN_BURN_SIZE_SLOT_LABEL binds the
# identical label string (the single source of truth); the future CMP-F2 set_min_burn_size setter
# writes the SAME slot, so reader (this policy) and setter target one canonical slot (no silent seam).
pub const MIN_BURN_SIZE_SLOT = word("xusdc::xreserve::attester_admin::min_burn_size")

# ERRORS
# =================================================================================================

# R-BURN-1: a burn must move a strictly positive amount.
const ERR_XRESERVE_BURN_ZERO = "burn amount must be greater than zero"

# R-BURN-2: a burn must be at least the configured minimum burn size.
const ERR_XRESERVE_BURN_BELOW_MIN = "burn amount is below the minimum burn size"

# PUBLIC INTERFACE
# =================================================================================================

#! Burn-policy predicate: gates every burn on R-BURN-1 (amount > 0) + R-BURN-2 (amount >= minBurnSize).
#! Registered as the ACTIVE burn policy of the faucet's TokenPolicyManager; invoked by
#! `policy_manager::execute_burn_policy` via `dynexec` on every `receive_and_burn`. Pause (R-BURN-3) is
#! the stock wrapper's gate, run BEFORE this policy (DECISION-RBURN3) -- this policy does NOT check it.
#!
#! Inputs:  [ASSET_KEY, ASSET_VALUE]
#! Outputs: []
#!
#! Where:
#! - ASSET_VALUE = [amount, 0, 0, 0]; `amount` (the burn amount, a felt < 2^63) is element 0 of
#!   ASSET_VALUE, i.e. stack depth 4 -- read non-destructively with `dup.4` (mirrors
#!   util/asset.masm::fungible_to_amount).
#!
#! Panics if (GREEN):
#! - amount == 0 (ERR_XRESERVE_BURN_ZERO, R-BURN-1).
#! - amount < min_burn_size (ERR_XRESERVE_BURN_BELOW_MIN, R-BURN-2).
#!
#! SHELL (executing-red): behavioral NO-OP -- drops the 8 burn-policy cells and ACCEPTS every burn (the
#! real R-BURN-1/2 checks are the green commit). The stack MUST exit EMPTY (the dynexec burn-policy
#! contract; the accept path returns, unlike the mint-deny twin which traps and never returns).
#!
#! Invocation: dynexec
pub proc check_policy
    # => [ASSET_KEY, ASSET_VALUE]
    dropw dropw
    # => []
end
