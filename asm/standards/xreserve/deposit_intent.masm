# xreserve::deposit_intent
#
# Circle's DepositIntent: its wire layout, and the faucet's on-chain realization of it.
#
# The mint note does not carry the intent. It carries a `xreserve::mint_intent` — the fields the
# faucet has no other way to learn — and everything else is written here. That is the whole point:
# a field the faucet writes cannot disagree with the attestation, because a divergent value changes
# the keccak digest and the signature stops verifying. Checks the faucet used to perform on a value
# it read are therefore not missing, they are unreachable.
#
# Two of the written fields are the faucet's own identity, and both are read inside this module
# rather than passed in. That is the security contract: no caller-supplied value can reach the
# destination domain or the token identifier.
#
# Whether the intent is ADMISSIBLE is a separate question, and one that does not need the message:
# `xreserve::mint_intent::validate` answers it over the carried fields, before anything here runs.
#
# The wire form is a fixed 240-byte big-endian header followed by variable-length hookData, staged
# as u32-LE-packed felts (four wire bytes per felt). Several fields are wider than the value they
# hold and carry it right-aligned behind a zero pad.

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::utils
use {
    ASSET_AMOUNT_PACKED_LIMBS, EVM_ADDRESS_PACKED_LIMBS, MINT_INTENT_FELTS, MINT_INTENT_HOOK_DATA_LEN_FELT_OFF,
    MINT_INTENT_LOCAL_DEPOSITOR_FELT_OFF, MINT_INTENT_LOCAL_TOKEN_FELT_OFF,
    MINT_INTENT_MAX_FEE_FELT_OFF, MINT_INTENT_NONCE_FELT_OFF,
    MINT_INTENT_REMOTE_RECIPIENT_FELT_OFF, MINT_INTENT_REMOTE_RECIPIENT_SUFFIX_FELT_OFF,
    MINT_INTENT_WORDS
} from xreserve::mint_intent

# CONSTANTS — storage slots
# =================================================================================================

# Slot — the id derives from the namespaced label string below. Read by `rebuild`, which stamps the
# configured domain into the message rather than comparing the message against it.
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")

# CONSTANTS — wire-field felt offsets (byte offset / 4)
# =================================================================================================

pub const MAGIC_FELT_OFF = 0
pub const VERSION_FELT_OFF = 1
pub const AMOUNT_FELT_OFF = 2
pub const REMOTE_DOMAIN_FELT_OFF = 10
pub const REMOTE_TOKEN_FELT_OFF = 11
pub const REMOTE_RECIPIENT_FELT_OFF = 19
pub const LOCAL_TOKEN_FELT_OFF = 27
pub const LOCAL_DEPOSITOR_FELT_OFF = 35
pub const MAX_FEE_FELT_OFF = 43
pub const NONCE_FELT_OFF = 51
pub const HOOK_DATA_LEN_FELT_OFF = 59
pub const HOOK_DATA_FELT_OFF = 60

# CONSTANTS — right-alignment pads
# =================================================================================================

# Where the carried value begins inside the wider field that holds it: the field's limb count minus
# the value's own. An AccountId is four of a bytes32's eight limbs, an EVM address five, an
# AssetAmount two of a uint256's eight.
pub const BYTES32_ACCOUNT_ID_LIMB_OFF = 4
pub const BYTES32_EVM_ADDRESS_LIMB_OFF = 3
pub const UINT256_ASSET_AMOUNT_LIMB_OFF = 6

# CONSTANTS — packed compare values and the header's size
# =================================================================================================

# the wire magic 0x5a2e0acd (big-endian bytes 5a 2e 0a cd) as the u32-LE-packed felt
pub const DEPOSIT_INTENT_MAGIC_PACKED = 0xcd0a2e5a

# the wire version 1 (big-endian bytes 00 00 00 01) as the u32-LE-packed felt
pub const DEPOSIT_INTENT_VERSION_PACKED = 0x01000000

pub const DEPOSIT_INTENT_HEADER_BYTES = 240

# The header is a whole number of words, so the hookData tail that follows it starts word-aligned.
pub const DEPOSIT_INTENT_HEADER_WORDS = 15

# CONSTANTS — where each written value lands
# =================================================================================================

# The field's own offset plus the right-alignment pad its width implies. Deriving these keeps the
# writer diffable line by line against the layout above.
const WRITE_AMOUNT_FELT_OFF = AMOUNT_FELT_OFF + UINT256_ASSET_AMOUNT_LIMB_OFF
const WRITE_REMOTE_TOKEN_FELT_OFF = REMOTE_TOKEN_FELT_OFF + BYTES32_ACCOUNT_ID_LIMB_OFF
const WRITE_REMOTE_RECIPIENT_FELT_OFF = REMOTE_RECIPIENT_FELT_OFF + BYTES32_ACCOUNT_ID_LIMB_OFF
const WRITE_LOCAL_TOKEN_FELT_OFF = LOCAL_TOKEN_FELT_OFF + BYTES32_EVM_ADDRESS_LIMB_OFF
const WRITE_LOCAL_DEPOSITOR_FELT_OFF = LOCAL_DEPOSITOR_FELT_OFF + BYTES32_EVM_ADDRESS_LIMB_OFF
const WRITE_MAX_FEE_FELT_OFF = MAX_FEE_FELT_OFF + UINT256_ASSET_AMOUNT_LIMB_OFF

# `rebuild` locals: four scalars, more than the write steps can keep on the operand stack while
# also assembling words.
const DEPOSIT_INTENT_PTR_LOC = 0
const MINT_INTENT_PTR_LOC = 1
const AMOUNT_LOC = 2
const HOOK_DATA_LEN_LOC = 3

# ERRORS
# =================================================================================================

# A carried limb is hash-committed content that becomes part of the signed message. keccak's byte
# reader refuses a felt above u32 anyway, but it does so as an anonymous host failure; guarding
# here names the fault instead.
const ERR_XRESERVE_MINT_INTENT_LIMB = "mint intent limb is not a valid u32"

# The carried hookData length must be a valid u32 before the length derivation reads it.
const ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB = "mint note deposit intent hook data length limb is not a valid u32"

# The mint intent's hash-committed word count must equal the count its own hookData length
# implies — an EXACT equality, so trailing padding cannot hide data, a smuggled section cannot ride
# along, and a length claim cannot reach past the committed bytes.
const ERR_XRESERVE_MINT_NOTE_INTENT_WORDS = "mint note deposit intent attachment word count does not match the intent length"

# The configured destination domain is written into the message as a four-byte wire field.
const ERR_XRESERVE_DOMAIN_NOT_U32 = "faucet domain config is not a valid u32"

# PUBLIC INTERFACE
# =================================================================================================

#! Rebuilds the DepositIntent the attestation signed.
#!
#! On return the caller holds a message that is byte-for-byte what Circle signed if and only if the
#! note was honest. Everything left for the caller is the attestation itself and the binding of the
#! note's own output values.
#!
#! Inputs:  [deposit_intent_ptr, mint_intent_ptr, mint_intent_num_words, amount]
#! Outputs: [intent_num_bytes]
#!
#! Where:
#! - deposit_intent_ptr is the WORD-ALIGNED base of the region to write, in GLOBAL memory. Every
#!   felt of the header is written here, pads included, so the region's prior contents cannot reach
#!   the message; the hookData tail past it is fully written by the copy.
#! - mint_intent_ptr is the base of the carried mint intent, INSIDE the caller's hash-verified
#!   transport region.
#! - mint_intent_num_words is that region's hash-committed word count, past the attestation. It is
#!   bound to the carried hookData length here, before anything reads past the fixed prefix.
#! - amount is the deposited amount as an AssetAmount, taken from the note's own asset value.
#! - intent_num_bytes is the wire length the attestation covers.
#!
#! Panics if:
#! - the committed word count disagrees with the carried hookData length.
#! - a carried limb, or the configured domain, is not a valid u32.
#! - the carried recipient is not a structurally valid account id.
#!
#! Locals:
#! - 0: deposit_intent_ptr
#! - 1: mint_intent_ptr
#! - 2: amount
#! - 3: the carried hookData length
#!
#! Invocation: exec
@locals(4)
pub proc rebuild
    loc_store.DEPOSIT_INTENT_PTR_LOC loc_store.MINT_INTENT_PTR_LOC
    # => [mint_intent_num_words, amount]

    swap loc_store.AMOUNT_LOC
    # => [mint_intent_num_words]

    # ---- bind the committed word count BEFORE reading past the fixed prefix ----
    # the hookData length picks both the keccak extent and the copy length, so nothing may read it
    # until the note has committed to a region big enough to hold what it claims.
    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_HOOK_DATA_LEN_FELT_OFF mem_load
    u32assert.err=ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB
    dup loc_store.HOOK_DATA_LEN_LOC
    # => [hook_data_len, mint_intent_num_words]

    # bytes -> packed felts -> words, then past the fixed carried fields
    exec.div_ceil_four exec.div_ceil_four
    add.MINT_INTENT_WORDS
    # => [expected_num_words, mint_intent_num_words]

    assert_eq.err=ERR_XRESERVE_MINT_NOTE_INTENT_WORDS
    # => []

    # ---- every felt of the header gets a writer, before any field lands on top of it ----
    # Global memory reads as zero from MASM, so we wouldn't technically need to zeroize the header,
    # but keccak's host-side byte reader fails on one that was never written.
    # See https://github.com/0xMiden/miden-vm/issues/3537.
    loc_load.DEPOSIT_INTENT_PTR_LOC exec.zero_header
    # => []

    # ---- the scheme's own two fields. both constants are already in packed form ----
    push.0.0
    push.DEPOSIT_INTENT_VERSION_PACKED push.DEPOSIT_INTENT_MAGIC_PACKED
    # => [magic, version, 0, 0]

    loc_load.DEPOSIT_INTENT_PTR_LOC add.MAGIC_FELT_OFF mem_storew_le dropw
    # => []

    # ---- the amount, from the note's own asset value ----
    loc_load.AMOUNT_LOC loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_AMOUNT_FELT_OFF
    # => [dst_ptr, amount]

    exec.store_byte_swapped
    # => []

    # ---- the configured destination domain, read here so no caller can influence it ----
    exec.get_configured_domain
    # => [remote_domain]

    u32assert.err=ERR_XRESERVE_DOMAIN_NOT_U32
    exec.utils::swap_u32_bytes
    # => [packed_domain]

    loc_load.DEPOSIT_INTENT_PTR_LOC add.REMOTE_DOMAIN_FELT_OFF mem_store
    # => []

    # ---- the token identifier: this account's own id, read from the kernel ----
    exec.native_account::get_id
    # => [own_id_suffix, own_id_prefix]

    loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_REMOTE_TOKEN_FELT_OFF
    # => [dst_ptr, own_id_suffix, own_id_prefix]

    exec.store_account_id
    # => []

    # ---- the carried recipient ----
    # validated before it is written, because a structurally invalid id would rebuild a perfectly
    # consistent message and then mint a note nobody can consume
    loc_load.MINT_INTENT_PTR_LOC exec.load_carried_recipient
    # => [recipient_suffix, recipient_prefix]

    dup.1 dup.1 exec.account_id::validate_structure
    # => [recipient_suffix, recipient_prefix]

    loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_REMOTE_RECIPIENT_FELT_OFF
    # => [dst_ptr, recipient_suffix, recipient_prefix]

    exec.store_account_id
    # => []

    # ---- the two source-chain addresses, copied limb for limb ----
    # the fixed-width runs unroll, so their widths are repeat counts rather than loop bounds. A
    # width that drifted from the shared layout would show up as a message-parity failure against
    # the Rust mirror, which compares every felt.
    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_LOCAL_TOKEN_FELT_OFF
    loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_LOCAL_TOKEN_FELT_OFF
    # => [dst_ptr, src_ptr]

    repeat.EVM_ADDRESS_PACKED_LIMBS
        exec.memcopy_u32_element
    end
    drop drop
    # => []

    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_LOCAL_DEPOSITOR_FELT_OFF
    loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_LOCAL_DEPOSITOR_FELT_OFF
    # => [dst_ptr, src_ptr]

    repeat.EVM_ADDRESS_PACKED_LIMBS
        exec.memcopy_u32_element
    end
    drop drop
    # => []

    # ---- the depositor's fee ceiling ----
    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_MAX_FEE_FELT_OFF mem_load
    loc_load.DEPOSIT_INTENT_PTR_LOC add.WRITE_MAX_FEE_FELT_OFF
    # => [dst_ptr, max_fee]

    exec.store_byte_swapped
    # => []

    # ---- the nonce ----
    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_NONCE_FELT_OFF
    loc_load.DEPOSIT_INTENT_PTR_LOC add.NONCE_FELT_OFF
    # => [dst_ptr, src_ptr]

    exec.memcopy_bytes32
    # => []

    # ---- the hookData length, and the hookData itself ----
    loc_load.HOOK_DATA_LEN_LOC exec.utils::swap_u32_bytes
    # => [packed_hook_data_len]

    loc_load.DEPOSIT_INTENT_PTR_LOC add.HOOK_DATA_LEN_FELT_OFF mem_store
    # => []

    loc_load.MINT_INTENT_PTR_LOC add.MINT_INTENT_FELTS
    loc_load.DEPOSIT_INTENT_PTR_LOC add.HOOK_DATA_FELT_OFF
    loc_load.HOOK_DATA_LEN_LOC exec.div_ceil_four
    # => [num_elements, dst_ptr, src_ptr]

    exec.memcopy_u32_elements
    # => []

    loc_load.HOOK_DATA_LEN_LOC add.DEPOSIT_INTENT_HEADER_BYTES
    # => [intent_num_bytes]
end

# HELPER PROCEDURES
# =================================================================================================

#! Returns num_items divided by four, rounded up.
#!
#! Four is the packing factor everywhere on this wire — wire bytes in a packed felt, and felts in
#! a word — so both conversions are this one routine.
#!
#! Inputs:  [num_items]
#! Outputs: [num_groups]
#!
#! Panics if:
#! - num_items is not a valid u32.
#!
#! Invocation: exec
proc div_ceil_four
    u32divmod.4 neq.0 add
end

#! Writes zeros over the whole header region.
#!
#! Inputs:  [dst_ptr]
#! Outputs: []
#!
#! Where:
#! - dst_ptr is the word-aligned base of the header region.
#!
#! Invocation: exec
proc zero_header
    padw
    # => [ZERO_WORD, dst_ptr]

    repeat.DEPOSIT_INTENT_HEADER_WORDS
        dup.4 mem_storew_le
        # => [ZERO_WORD, dst_ptr]

        movup.4 add.4 movdn.4
        # => [ZERO_WORD, dst_ptr+4]
    end
    # => [ZERO_WORD, dst_ptr+60]

    dropw drop
    # => []
end

#! Reads the faucet's configured destination domain.
#!
#! Inputs:  []
#! Outputs: [remote_domain]
#!
#! Panics if:
#! - the domain config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
proc get_configured_domain
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3]

    movdn.3 drop drop drop
    # => [domain]
end

#! Reads the carried recipient's two account-id felts.
#!
#! Inputs:  [mint_intent_ptr]
#! Outputs: [recipient_suffix, recipient_prefix]
#!
#! Invocation: exec
proc load_carried_recipient
    dup add.MINT_INTENT_REMOTE_RECIPIENT_FELT_OFF mem_load
    # => [recipient_prefix, mint_intent_ptr]

    swap add.MINT_INTENT_REMOTE_RECIPIENT_SUFFIX_FELT_OFF mem_load
    # => [recipient_suffix, recipient_prefix]
end

#! Copies one u32-LE-packed element, guarding it before it lands, and advances both pointers.
#!
#! Named for `miden::core::mem::memcopy_elements`, narrowed to the packed-limb case: the guard is
#! what turns a malformed carried limb into a named fault, since keccak's byte reader refuses a
#! felt above u32 as an anonymous host failure rather than an assertion.
#!
#! Inputs:  [dst_ptr, src_ptr]
#! Outputs: [dst_ptr+1, src_ptr+1]
#!
#! Panics if:
#! - the copied element is not a valid u32 (ERR_XRESERVE_MINT_INTENT_LIMB).
#!
#! Invocation: exec
proc memcopy_u32_element
    dup.1 mem_load u32assert.err=ERR_XRESERVE_MINT_INTENT_LIMB
    # => [element, dst_ptr, src_ptr]

    dup.1 mem_store
    # => [dst_ptr, src_ptr]

    add.1 swap add.1 swap
    # => [dst_ptr+1, src_ptr+1]
end

#! Copies a bytes32's eight packed limbs and u32-guarding them.
#!
#! Inputs:  [dst_ptr, src_ptr]
#! Outputs: []
#!
#! Panics if:
#! - a copied limb is not a valid u32 (ERR_XRESERVE_MINT_INTENT_LIMB).
#!
#! Invocation: exec
proc memcopy_bytes32
    swap exec.utils::mem_load_double_word_unaligned
    # => [B_LOWER, B_UPPER, dst_ptr]

    u32assertw.err=ERR_XRESERVE_MINT_INTENT_LIMB
    swapw u32assertw.err=ERR_XRESERVE_MINT_INTENT_LIMB swapw
    # => [B_LOWER, B_UPPER, dst_ptr]

    exec.utils::mem_store_double_word_unaligned
    # => []
end

#! Copies a run of `num_elements` packed elements whose length is only known at run time.
#!
#! Inputs:  [num_elements, dst_ptr, src_ptr]
#! Outputs: []
#!
#! Panics if:
#! - a copied element is not a valid u32 (ERR_XRESERVE_MINT_INTENT_LIMB).
#!
#! Invocation: exec
proc memcopy_u32_elements
    dup neq.0
    # => [is_more, num_elements, dst_ptr, src_ptr]

    while.true
        # => [num_elements, dst_ptr, src_ptr]
        movdn.2 exec.memcopy_u32_element movup.2
        # => [num_elements, dst_ptr+1, src_ptr+1]

        sub.1 dup neq.0
        # => [is_more, num_elements-1, dst_ptr+1, src_ptr+1]
    end
    # => [num_elements, dst_ptr, src_ptr]

    drop drop drop
    # => []
end

#! Writes a u64-valued felt as its two wire limbs, most significant first.
#!
#! The wire is big-endian and the region is u32-LE-packed, so each half is stored byte-swapped.
#! Both values written this way — the amount and the fee ceiling — sit at the end of a wider field,
#! which is why the caller passes a pointer that already includes the pad.
#!
#! Inputs:  [dst_ptr, value]
#! Outputs: []
#!
#! Invocation: exec
proc store_byte_swapped
    swap u32split
    # => [value_lo, value_hi, dst_ptr]

    exec.utils::swap_u32_bytes swap exec.utils::swap_u32_bytes
    # => [packed_hi, packed_lo, dst_ptr]

    dup.2 mem_store
    # => [packed_lo, dst_ptr]

    swap add.1 mem_store
    # => []
end

#! Writes an account id into the low sixteen bytes of its bytes32 field.
#!
#! The packaging is the prefix u64 then the suffix u64, each big-endian — two `store_byte_swapped`
#! writes back to back.
#!
#! Inputs:  [dst_ptr, account_id_suffix, account_id_prefix]
#! Outputs: []
#!
#! Where:
#! - dst_ptr already includes the field's sixteen-byte pad.
#!
#! Invocation: exec
proc store_account_id
    dup movdn.3
    # => [dst_ptr, account_id_suffix, account_id_prefix, dst_ptr]

    movup.2 swap
    # => [dst_ptr, account_id_prefix, account_id_suffix, dst_ptr]

    exec.store_byte_swapped
    # => [account_id_suffix, dst_ptr]

    # a u64 half occupies two packed limbs
    swap add.ASSET_AMOUNT_PACKED_LIMBS
    # => [dst_ptr+2, account_id_suffix]

    exec.store_byte_swapped
    # => []
end
