# xreserve::deposit_intent_parser
#
# The faucet-side DepositIntent mint preconditions. It consumes the shared parser
# (`xreserve::encoding::parse_deposit_intent`) and adds only the faucet-owned
# checks: the domain and identifier equality compares, the amount/fee bounds, and the nonce
# replay guard. The identifier slot stores the canonical `bytes32_to_key` key-Word, so the
# identifier equality is realized as key equality.
#
# A DepositIntent is the Circle-signed message that authorizes one mint. Its wire form is a
# fixed 240-byte big-endian header followed by variable-length hookData; on-chain it is staged
# as u32-LE-packed felts (4 wire bytes per felt). The header fields, by wire byte offset:
# - magic (bytes 0..4): a fixed sentinel identifying a DepositIntent; set by Circle.
# - version (bytes 4..8): the wire-format version, currently 1; set by Circle.
# - amount (bytes 8..40): the deposited amount as a uint256 in the token's 6-decimal smallest
#   units; set by Circle from the source-chain deposit.
# - remoteDomain (bytes 40..44): the destination-domain id Circle assigns this chain; the
#   faucet accepts only its configured domain.
# - remoteToken (bytes 44..76): the destination token identifier as bytes32; the faucet
#   accepts only its configured identifier.
# - remoteRecipient (bytes 76..108): the destination account to mint to, as bytes32 (the
#   right-aligned account-id packaging); chosen by the depositor.
# - localToken (bytes 108..140): the source-chain token contract as bytes32; set by Circle.
# - localDepositor (bytes 140..172): the source-chain depositor as bytes32; set by Circle.
# - maxFee (bytes 172..204): the depositor-authorized fee ceiling as a uint256.
# - nonce (bytes 204..236): Circle's unique deposit nonce as bytes32; drives the replay guard.
# - hookDataLen (bytes 236..240): the byte length of the trailing hookData; the staged length
#   must satisfy len == 240 + hookDataLen.
# - hookData (bytes 240..): an optional opaque payload; parsed only for length, never for
#   effects.

use miden::protocol::active_account
use miden::core::math::u64
use xreserve::encoding
use {AMOUNT_FELT_OFF, MAX_FEE_FELT_OFF, NONCE_FELT_OFF} from xreserve::encoding::layout

# CONSTANTS
# =================================================================================================

# Slots — ids derive from the namespaced label strings below. The Rust account builder binds
# the identical label strings, so both sides derive the same slot ids.
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")
pub const IDENTIFIER_CONFIG_SLOT = word("xusdc::xreserve::domain_config::identifier")

# The usedNonces StorageMap slot (the nonce replay registry). The map slot itself is declared
# by the Rust account builder; this const is the MASM-side slot id.
pub const USED_NONCES_SLOT = word("xusdc::xreserve::nonce_registry::used_nonces")

# ERRORS
# =================================================================================================

const ERR_XRESERVE_WRONG_DOMAIN = "deposit intent remote domain does not match the faucet domain"
const ERR_XRESERVE_WRONG_IDENTIFIER = "deposit intent remote token does not match the faucet identifier"

# Amount/fee errors. The too-large reject (ERR_X_TOO_LARGE) is CONSUMED from the encoding
# library's reducer, never redefined here. The fee gate requires feeAmount == 0 — the MVP has
# no relayer-fee leg — which subsumes the feeAmount <= maxFee compare (see
# assert_mint_amounts for the gate and its upgrade path).
const ERR_XRESERVE_AMOUNT_BELOW_FEE = "deposit intent amount is below the max fee"
const ERR_XRESERVE_FEE_NONZERO = "mint fee amount must be zero"

# Nonce replay: assert-zero only; marking the nonce used is the mint policy's accept-path
# write, so a failed mint never consumes a nonce.
const ERR_XRESERVE_NONCE_REPLAY = "deposit intent nonce has already been used"

# PUBLIC INTERFACE
# =================================================================================================

#! Asserts the faucet-owned DepositIntent mint preconditions over a staged preimage.
#!
#! Delegates the structural validation to the encoding library's
#! `xreserve::encoding::parse_deposit_intent`, then asserts the two faucet-owned
#! compares against the faucet config slots: the parsed remote domain must equal the
#! configured domain, and the canonical key-Word of the parsed remote token must equal
#! the configured identifier key.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [hook_data_len]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - hook_data_len is the semantic hookDataLen value as a u32 felt.
#!
#! Panics if:
#! - parse_deposit_intent fails to verify.
#! - the parsed remote domain does not equal the faucet's configured domain.
#! - the parsed remote token's key does not equal the faucet's configured identifier key.
#! - a config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
@account_procedure
pub proc assert_deposit_intent
    exec.encoding::parse_deposit_intent
    # => [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len]

    # domain compare: the configured domain lives in element 0 of the domain config slot word
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len]

    movdn.3 drop drop drop
    # => [domain, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len]

    assert_eq.err=ERR_XRESERVE_WRONG_DOMAIN
    # => [REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len]

    # identifier compare: the parser's packed remoteToken words are already in the
    # [B_UPPER, B_LOWER] orientation bytes32_to_key consumes
    exec.encoding::bytes32_to_key
    # => [KEY, hook_data_len]

    push.IDENTIFIER_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [STORED_KEY, KEY, hook_data_len]

    assert_eqw.err=ERR_XRESERVE_WRONG_IDENTIFIER
    # => [hook_data_len]
end

#! Asserts the faucet-owned amount and fee mint preconditions over a staged preimage.
#!
#! `amount` (felt[2..9]) and `maxFee` (felt[43..50]) come from the staged preimage; `feeAmount`
#! does not travel in the intent at all and lives wherever the caller staged it. All three go
#! through the encoding library's `uint256_to_asset_amount`.
#!
#! Inputs:  [intent_ptr, fee_amount_ptr, scale_exp]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - fee_amount_ptr is the memory address of the operator feeAmount's first packed limb (8 u32-LE
#!   limbs).
#! - scale_exp is the decimal scale exponent forwarded to the reducer (the cap/scale choice
#!   is OPEN, pending Circle confirmation).
#!
#! Panics if:
#! - the reducer rejects amount, maxFee, or feeAmount (ERR_X_TOO_LARGE / ERR_AMOUNT_OVER_CAP).
#! - a feeAmount limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD).
#! - reduced amount < maxFee (ERR_XRESERVE_AMOUNT_BELOW_FEE).
#! - reduced feeAmount != 0 (ERR_XRESERVE_FEE_NONZERO).
#!
#! Invocation: exec
@account_procedure
pub proc assert_mint_amounts
    # reduce amount (felt[2..9]); keep [intent_ptr, fee_amount_ptr, scale_exp] live below for reuse
    dup.2 dup.1 push.AMOUNT_FELT_OFF add
    # => [amount_base, scale_exp, intent_ptr, fee_amount_ptr, scale_exp]

    exec.reduce_uint256_field
    # => [amount_y, intent_ptr, fee_amount_ptr, scale_exp]

    # reduce maxFee (felt[43..50])
    dup.3 dup.2 push.MAX_FEE_FELT_OFF add
    # => [maxfee_base, scale_exp, amount_y, intent_ptr, fee_amount_ptr, scale_exp]

    exec.reduce_uint256_field
    # => [maxfee_y, amount_y, intent_ptr, fee_amount_ptr, scale_exp]

    # intent_ptr has served every field it owns
    movup.2 drop
    # => [maxfee_y, amount_y, fee_amount_ptr, scale_exp]

    # assert reduced amount >= maxFee over copies; both reduced values are < 2^63 (felts are
    # unordered) -> u64 limb compare. the surviving maxfee_y copy below is dropped after the
    # fee gate.
    dup movup.2 swap
    # => [maxfee_y, amount_y, maxfee_y, fee_amount_ptr, scale_exp]

    u32split
    # => [maxfee_lo, maxfee_hi, amount_y, maxfee_y, fee_amount_ptr, scale_exp]

    movup.2 u32split
    # => [amount_lo, amount_hi, maxfee_lo, maxfee_hi, maxfee_y, fee_amount_ptr, scale_exp]

    # compute amount >= maxfee
    exec.u64::lte
    # => [is_amount_ge_maxfee, maxfee_y, fee_amount_ptr, scale_exp]

    assert.err=ERR_XRESERVE_AMOUNT_BELOW_FEE
    # => [maxfee_y, fee_amount_ptr, scale_exp]

    # reduce feeAmount through the same staged-field helper the two intent fields used
    movup.2 movup.2
    # => [fee_amount_ptr, scale_exp, maxfee_y]

    exec.reduce_uint256_field
    # => [feeamount_y, maxfee_y]

    # fail-loud fee gate: the operator feeAmount must be zero. the only allowed fee is zero, which
    # is always <= maxFee, so no feeAmount-vs-maxFee compare is reachable, and the mint pipeline
    # credits the recipient the whole amount with no relayer-fee leg. the relayer fee split stays
    # open, pending Circle confirmation.
    assertz.err=ERR_XRESERVE_FEE_NONZERO
    # => [maxfee_y]

    drop
    # => []
end

#! Asserts the deposit intent's nonce has not been used (the mint replay guard).
#!
#! Derives the nonce key by CONSUMING the encoding library's `xreserve::encoding::bytes32_to_key` (no
#! re-implemented hash) over the parsed nonce (felt[51..58]), reads `usedNonces[key]` via
#! `active_account::get_map_item`, and asserts it is `EMPTY_WORD`. Marking the nonce as
#! consumed is the mint policy's accept-path write — this guard is assert-zero ONLY, so a
#! failed mint never consumes a nonce.
#!
#! Inputs:  [intent_ptr]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#!
#! Panics if:
#! - usedNonces[key] is non-empty (the nonce was already used) -> ERR_XRESERVE_NONCE_REPLAY.
#!
#! Invocation: exec
@account_procedure
pub proc assert_nonce_unused
    push.NONCE_FELT_OFF add
    # => [nonce_base]

    # load B_LOWER: the nonce's first four packed limbs (wire bytes 0..16), element-0 on top —
    # the [B_UPPER, B_LOWER] orientation bytes32_to_key consumes (the same staging as the
    # parser's remoteToken load)
    dup add.3 mem_load
    dup.1 add.2 mem_load
    dup.2 add.1 mem_load
    dup.3 mem_load
    # => [B_LOWER, nonce_base]

    # load B_UPPER: the next four packed limbs (wire bytes 16..32)
    dup.4 add.7 mem_load
    dup.5 add.6 mem_load
    dup.6 add.5 mem_load
    dup.7 add.4 mem_load
    # => [B_UPPER, B_LOWER, nonce_base]

    movup.8 drop
    # => [B_UPPER, B_LOWER]

    # call the encoding library's bytes32_to_key; the hash is never re-implemented here
    exec.encoding::bytes32_to_key
    # => [KEY]

    push.USED_NONCES_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    # assert-zero: an unused nonce reads EMPTY_WORD; a used (non-empty) one traps. this guard
    # does not write the registry -- consuming the nonce is the mint policy's accept-path write.
    padw assert_eqw.err=ERR_XRESERVE_NONCE_REPLAY
    # => []
end

# HELPER PROCEDURES
# =================================================================================================

#! Reduces the uint256 field at `base` (8 u32-LE packed felts) to an AssetAmount via the
#! encoding library's reducer.
#!
#! Single-felt loads: the header felt offsets are not word-aligned.
#! The word orientation matches the shared parser's remoteToken load: U_LOWER = the field's
#! positionally lower four packed limbs (wire bytes 0..16), U_UPPER = the positionally upper
#! four (wire bytes 16..32), each element-0 on top — exactly the `[U_UPPER, U_LOWER,
#! scale_exp]` shape the reducer consumes.
#!
#! Inputs:  [base, scale_exp]
#! Outputs: [y]
#!
#! Where:
#! - base is the memory address of the field's first packed felt.
#! - scale_exp is the decimal scale exponent.
#! - y is the reduced AssetAmount felt.
#!
#! Panics if:
#! - the reducer rejects the value (ERR_X_TOO_LARGE / ERR_AMOUNT_OVER_CAP / ERR_FELT_OUT_OF_FIELD).
#!
#! Invocation: exec
proc reduce_uint256_field
    # load U_LOWER: the field's first four packed limbs at base+0..base+3 (element-0 on top)
    dup add.3 mem_load
    dup.1 add.2 mem_load
    dup.2 add.1 mem_load
    dup.3 mem_load
    # => [U_LOWER, base, scale_exp]

    # load U_UPPER: the next four packed limbs at base+4..base+7
    dup.4 add.7 mem_load
    dup.5 add.6 mem_load
    dup.6 add.5 mem_load
    dup.7 add.4 mem_load
    # => [U_UPPER, U_LOWER, base, scale_exp]

    movup.8 drop
    # => [U_UPPER, U_LOWER, scale_exp]

    exec.encoding::uint256_to_asset_amount
    # => [y]
end
