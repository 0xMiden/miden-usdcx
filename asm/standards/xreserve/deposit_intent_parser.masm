# xreserve::deposit_intent_parser
#
# FAUCET(01)-owned DepositIntent mint-precondition assertion shell (P5-01 slice): the
# D5a faucet-side entry that consumes the 04-owned shared parser BY REFERENCE (NS-2:
# `xreserve::encoding::parse_deposit_intent` stays 04-owned; this module adds ONLY the
# faucet-owned domain/identifier compares, D5a steps 5-6). Module home + nested path
# ratified per D-1A rule 3 (plan decision D-A); the identifier slot stores the
# canonical `bytes32_to_key` key-Word and the R-MINT-7 equality is realized as key
# equality (ratified plan decision D-C).
#
# BUILD STATE: implemented (C5a parser route, C5b domain compare, C5c identifier
# compare + output contract). Loop history: crates/xusdc-encoding/TEST-LEDGER-01-MINT-SHELL.md.

use miden::protocol::active_account
use xreserve::encoding

# CONSTANTS
# =================================================================================================

# Slots — ids derive from the namespaced labels (the Rust fixtures bind the same labels
# via StorageSlotName; hard-coded slots are source-approved for the self-contained
# faucet, ownership map slot-binding note / fungible.masm precedent)
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")
pub const IDENTIFIER_CONFIG_SLOT = word("xusdc::xreserve::domain_config::identifier")

# ERRORS
# =================================================================================================

const ERR_XRESERVE_WRONG_DOMAIN = "deposit intent remote domain does not match the faucet domain"
const ERR_XRESERVE_WRONG_IDENTIFIER = "deposit intent remote token does not match the faucet identifier"

# PUBLIC INTERFACE
# =================================================================================================

#! Asserts the faucet-owned DepositIntent mint preconditions over a staged preimage.
#!
#! Delegates the structural validation (D5a steps 1-4, 7, 8) to the 04-owned
#! `xreserve::encoding::parse_deposit_intent`, then asserts the two faucet-owned
#! compares (D5a steps 5-6) against the faucet config slots: the parsed remote domain
#! must equal the configured domain, and the canonical key-Word of the parsed remote
#! token must equal the configured identifier key.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [hook_data_len]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - hook_data_len is the semantic hookDataLen value as a u32 felt.
#!
#! Panics if:
#! - parse_deposit_intent fails to verify.
#! - the parsed remote domain does not equal the faucet's configured domain.
#! - the parsed remote token's key does not equal the faucet's configured identifier key.
#! - a config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
pub proc assert_deposit_intent
    exec.encoding::parse_deposit_intent
    # => [remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    # D5a step 5 (R-MINT-6): the configured domain lives in element 0 of the domain
    # config slot word
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3, remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    movdn.3 drop drop drop
    # => [domain, remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    assert_eq.err=ERR_XRESERVE_WRONG_DOMAIN
    # => [REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    # D5a step 6 (R-MINT-7): the parser's packed remoteToken words are already in the
    # [B1, B0] orientation bytes32_to_key consumes
    exec.encoding::bytes32_to_key
    # => [KEY, hook_data_len]

    push.IDENTIFIER_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [STORED_KEY, KEY, hook_data_len]

    assert_eqw.err=ERR_XRESERVE_WRONG_IDENTIFIER
    # => [hook_data_len]
end
