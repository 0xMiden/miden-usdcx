# xreserve::deposit_intent_parser
#
# The faucet-side DepositIntent mint preconditions. It consumes the shared parser
# (`xreserve::encoding::parse_deposit_intent`) and adds only the faucet-owned
# checks: the domain and identifier equality compares, the amount/fee bounds, and the nonce
# replay guard. The identifier slot stores the canonical `bytes32_to_key` key-Word, so the
# identifier equality is realized as key equality.
#
# A DepositIntent is the Circle-signed message that authorizes one mint. Its wire form is a
# fixed 240-byte big-endian header followed by variable-length hookData; on-chain it is staged
# as u32-LE-packed felts (4 wire bytes per felt). The header fields, by wire byte offset:
# - magic (bytes 0..4): a fixed sentinel identifying a DepositIntent; set by Circle.
# - version (bytes 4..8): the wire-format version, currently 1; set by Circle.
# - amount (bytes 8..40): the deposited amount as a uint256 in the token's 6-decimal smallest
#   units; set by Circle from the source-chain deposit.
# - remoteDomain (bytes 40..44): the destination-domain id Circle assigns this chain; the
#   faucet accepts only its configured domain.
# - remoteToken (bytes 44..76): the destination token identifier as bytes32; the faucet
#   accepts only its configured identifier.
# - remoteRecipient (bytes 76..108): the destination account to mint to, as bytes32 (the
#   right-aligned account-id packaging); chosen by the depositor.
# - localToken (bytes 108..140): the source-chain token contract as bytes32; set by Circle.
# - localDepositor (bytes 140..172): the source-chain depositor as bytes32; set by Circle.
# - maxFee (bytes 172..204): the depositor-authorized fee ceiling as a uint256.
# - nonce (bytes 204..236): Circle's unique deposit nonce as bytes32; drives the replay guard.
# - hookDataLen (bytes 236..240): the byte length of the trailing hookData; the staged length
#   must satisfy len == 240 + hookDataLen.
# - hookData (bytes 240..): an optional opaque payload; parsed only for length, never for
#   effects.

use miden::protocol::active_account
use miden::standards::assets::asset_amount
use miden::standards::utils
use miden::core::math::u128
use miden::core::word
use xreserve::encoding
use {AMOUNT_FELT_OFF, MAX_FEE_FELT_OFF, NONCE_FELT_OFF} from xreserve::encoding::layout

# CONSTANTS
# =================================================================================================

# Slots — ids derive from the namespaced label strings below.
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")
pub const IDENTIFIER_CONFIG_SLOT = word("xusdc::xreserve::domain_config::identifier")

# The usedNonces StorageMap slot (the nonce replay registry). The map slot itself is declared
# by the Rust account builder; this const is the MASM-side slot id.
pub const USED_NONCES_SLOT = word("xusdc::xreserve::nonce_registry::used_nonces")

# The uint256->AssetAmount decimal scale.
# Circle's on-wire deposit `amount` is denominated in 6-decimal units, just like Miden,
# so the two denominations coincide and no rescale applies. The cap/scale/dust decision
# stays OPEN, pending Circle confirmation.
const DEPOSIT_SCALE_EXP = 0

# ERRORS
# =================================================================================================

const ERR_XRESERVE_WRONG_DOMAIN = "deposit intent remote domain does not match the faucet domain"
const ERR_XRESERVE_WRONG_IDENTIFIER = "deposit intent remote token does not match the faucet identifier"

# Amount/fee errors. The maxFee staging declares its own too-large and limb guards (the
# same strings the encoding library uses); the amount field goes through the witness verifier.
# The fee gate requires the wire feeAmount to be zero verbatim, since there is no relayer-fee
# leg yet, which subsumes the feeAmount <= maxFee compare.
const ERR_X_TOO_LARGE = "larger than 2**128"
const ERR_FELT_OUT_OF_FIELD = "supplied limb is not a valid u32"
const ERR_XRESERVE_AMOUNT_BELOW_FEE = "deposit intent amount is below the max fee"
const ERR_XRESERVE_FEE_NONZERO = "mint fee amount must be zero"

# Nonce replay: assert-zero only; marking the nonce used is the mint policy's accept-path
# write, so a failed mint never consumes a nonce.
const ERR_XRESERVE_NONCE_REPLAY = "deposit intent nonce has already been used"

# PUBLIC INTERFACE
# =================================================================================================

#! Asserts the faucet-owned DepositIntent mint preconditions over a staged preimage.
#!
#! Delegates the structural validation to the encoding library's
#! `xreserve::encoding::parse_deposit_intent`, then asserts the two faucet-owned
#! compares against the faucet config slots: the parsed remote domain must equal the
#! configured domain, and the canonical key-Word of the parsed remote token must equal
#! the configured identifier key.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [hook_data_len_bytes]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - hook_data_len_bytes is the semantic hookDataLen value in bytes, as a u32 felt.
#!
#! Panics if:
#! - parse_deposit_intent fails to verify.
#! - the parsed remote domain does not equal the faucet's configured domain.
#! - the parsed remote token's key does not equal the faucet's configured identifier key.
#! - a config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
@account_procedure
pub proc assert_deposit_intent
    exec.encoding::parse_deposit_intent
    # => [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]

    # domain compare: the configured domain lives in element 0 of the domain config slot word
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]

    movdn.3 drop drop drop
    # => [domain, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]

    assert_eq.err=ERR_XRESERVE_WRONG_DOMAIN
    # => [REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]

    # identifier compare: the parser's packed remoteToken words are already in the
    # [B_UPPER, B_LOWER] orientation bytes32_to_key consumes
    exec.encoding::bytes32_to_key
    # => [KEY, hook_data_len_bytes]

    push.IDENTIFIER_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [STORED_KEY, KEY, hook_data_len_bytes]

    assert_eqw.err=ERR_XRESERVE_WRONG_IDENTIFIER
    # => [hook_data_len_bytes]
end

#! Asserts the faucet-owned amount and fee mint preconditions over a staged preimage.
#!
#! `amount` (felt[2..9]) and `maxFee` (felt[43..50]) come from the staged preimage; `feeAmount`
#! does not travel in the intent at all and lives wherever the caller staged it. The amount
#! goes through the encoding library's witness verifier against the `amount_y` claim at the
#! faucet's own `DEPOSIT_SCALE_EXP`; the maxFee bound is proven division-free by algebraic
#! equivalence; the feeAmount must be zero verbatim on the wire.
#!
#! Inputs:  [intent_ptr, fee_amount_ptr, amount_y]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - fee_amount_ptr is the memory address of the operator feeAmount's first packed limb (8 u32-LE
#!   limbs).
#! - amount_y is the claimed reduced amount witness (in the mint pipeline, the note-supplied
#!   asset value), proven equal to floor(amount / 10^DEPOSIT_SCALE_EXP) and within the fungible
#!   maximum by the verifier.
#!
#! Panics if:
#! - the witness verifier rejects the amount claim (the standards too-large / over-maximum /
#!   underflow / remainder constraints).
#! - a maxFee limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD), or the maxFee high half is
#!   nonzero (ERR_X_TOO_LARGE).
#! - reduced amount < maxFee (ERR_XRESERVE_AMOUNT_BELOW_FEE).
#! - any wire feeAmount limb is nonzero (ERR_XRESERVE_FEE_NONZERO).
#!
#! Invocation: exec
@account_procedure
pub proc assert_mint_amounts
    # step 1: verify the witness supplied amount_y against the intent's amount field. the
    # verifier's trailing [scale_exp, amount_y] inputs are staged first so the loaded field
    # lands directly on top of them
    dup.2 push.DEPOSIT_SCALE_EXP
    # => [scale_exp, amount_y, intent_ptr, fee_amount_ptr, amount_y]

    dup.2 push.AMOUNT_FELT_OFF add
    # => [intent_amount_ptr, scale_exp, amount_y, intent_ptr, fee_amount_ptr, amount_y]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [U_UPPER, U_LOWER, scale_exp, amount_y, intent_ptr, fee_amount_ptr, amount_y]

    exec.encoding::verify_uint256_to_asset_amount
    # => [intent_ptr, fee_amount_ptr, amount_y]

    # step 2: assert the amount covers the depositor's fee ceiling — floor(maxfee/10^s) must
    # not exceed amount_y. rather than reducing maxfee (a division), the same inequality is
    # checked multiplied out: it holds exactly when maxfee < (amount_y+1)*10^s, since any
    # maxfee at least that large would reduce above amount_y. the verify above bounds
    # amount_y, so the +1 cannot wrap; at the shipped scale-0 identity the bound is simply
    # maxfee < amount_y+1, i.e. maxfee <= amount_y as a u128
    push.MAX_FEE_FELT_OFF add
    # => [intent_maxfee_ptr, fee_amount_ptr, amount_y]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [MAXFEE_UPPER, MAXFEE_LOWER, fee_amount_ptr, amount_y]

    exec.to_u128_limbs
    # => [MAXFEE_U128, fee_amount_ptr, amount_y]

    movup.5 add.1
    # => [amount_y+1, MAXFEE_U128, fee_amount_ptr]

    push.DEPOSIT_SCALE_EXP swap
    # => [amount_y+1, scale_exp, MAXFEE_U128, fee_amount_ptr]

    exec.asset_amount::scale_asset_amount_to_u256
    # => [BOUND_LO, BOUND_HI, MAXFEE_U128, fee_amount_ptr]

    # the u256 high word is provably zero (the bound is below 2^123)
    swapw dropw
    # => [BOUND_LO, MAXFEE_U128, fee_amount_ptr]

    exec.u128::lt
    # => [is_maxfee_lt_bound, fee_amount_ptr]

    assert.err=ERR_XRESERVE_AMOUNT_BELOW_FEE
    # => [fee_amount_ptr]

    # step 3: assert the staged wire feeAmount is zero - with no relayer-fee, any nonzero
    # claim is refused
    exec.utils::mem_load_double_word_unaligned
    # => [F_1, F_2]

    exec.word::eqz
    assert.err=ERR_XRESERVE_FEE_NONZERO
    # => [F_2]

    exec.word::eqz
    assert.err=ERR_XRESERVE_FEE_NONZERO
    # => []
end

#! Asserts the deposit intent's nonce has not been used (the mint replay guard).
#!
#! Derives the nonce key with the encoding library's `xreserve::encoding::bytes32_to_key` over the
#! parsed nonce (felt[51..58]), reads `usedNonces[key]` via `active_account::get_map_item`, and
#! asserts it is `EMPTY_WORD`. Marking the nonce as consumed is the mint policy's accept-path
#! write — this guard is assert-zero ONLY, so a failed mint never consumes a nonce.
#!
#! Inputs:  [intent_ptr]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#!
#! Panics if:
#! - usedNonces[key] is non-empty (the nonce was already used) -> ERR_XRESERVE_NONCE_REPLAY.
#!
#! Invocation: exec
@account_procedure
pub proc assert_nonce_unused
    push.NONCE_FELT_OFF add
    # => [nonce_base]

    # load the nonce's eight packed limbs
    exec.utils::mem_load_double_word_unaligned swapw
    # => [B_UPPER, B_LOWER]

    exec.encoding::bytes32_to_key
    # => [KEY]

    push.USED_NONCES_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    # assert-zero: an unused nonce reads EMPTY_WORD; a used (non-empty) one traps. this guard
    # does not write the registry -- consuming the nonce is the mint policy's accept-path write.
    padw assert_eqw.err=ERR_XRESERVE_NONCE_REPLAY
    # => []
end

# HELPER PROCEDURES
# =================================================================================================

#! Normalizes a staged uint256 to its numerically-low half as u128 little-endian u32 limbs.
#!
#! Guards every limb as a u32, asserts the numerically high half (U_LOWER, wire bytes 0..16)
#! is zero, then byte-swaps and reverses the low half into little-endian u128 limb order.
#! Works with any trailing elements beneath the two words.
#!
#! Inputs:  [U_UPPER, U_LOWER]
#! Outputs: [x0, x1, x2, x3]
#!
#! Where:
#! - U_UPPER / U_LOWER are the field's positionally upper / lower four u32-LE-packed limbs
#!   (wire bytes 16..32 / 0..16), each element-0 on top.
#! - x0..x3 are the value's u32 limbs in little-endian order (x = x3*2^96 + x2*2^64 +
#!   x1*2^32 + x0).
#!
#! Panics if:
#! - a limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD).
#! - any limb of the numerically high half is nonzero (ERR_X_TOO_LARGE).
#!
#! Invocation: exec
proc to_u128_limbs
    # guard every externally-supplied limb before any u32 op
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    swapw
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    # => [U_LOWER, U_UPPER]

    exec.word::eqz
    assert.err=ERR_X_TOO_LARGE
    # => [U_UPPER]

    # byte-swap the numerically-low-half limbs to numeric order
    repeat.4
        exec.utils::swap_u32_bytes movdn.3
    end
    # => [n4, n5, n6, n7]

    exec.word::reverse
    # => [x0, x1, x2, x3]
end
