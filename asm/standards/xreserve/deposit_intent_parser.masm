# xreserve::deposit_intent_parser
#
# FAUCET(01)-owned DepositIntent mint-precondition assertion shell (P5-01 slice): the
# D5a faucet-side entry that consumes the 04-owned shared parser BY REFERENCE (NS-2:
# `xreserve::encoding::parse_deposit_intent` stays 04-owned; this module adds ONLY the
# faucet-owned domain/identifier compares, D5a steps 5-6). Module home + nested path
# ratified per D-1A rule 3 (plan decision D-A); the identifier slot stores the
# canonical `bytes32_to_key` key-Word and the R-MINT-7 equality is realized as key
# equality (ratified plan decision D-C).
#
# BUILD STATE: implemented (C5a parser route, C5b domain compare, C5c identifier
# compare + output contract). Loop history: crates/xusdc-encoding/TEST-LEDGER-01-MINT-SHELL.md.

use miden::core::math::u64
use miden::protocol::active_account
use xreserve::encoding
use xreserve::encoding::layout::AMOUNT_FELT_OFF
use xreserve::encoding::layout::MAX_FEE_FELT_OFF

# CONSTANTS
# =================================================================================================

# Slots — ids derive from the namespaced labels (the Rust fixtures bind the same labels
# via StorageSlotName; hard-coded slots are source-approved for the self-contained
# faucet, ownership map slot-binding note / fungible.masm precedent)
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")
pub const IDENTIFIER_CONFIG_SLOT = word("xusdc::xreserve::domain_config::identifier")

# ERRORS
# =================================================================================================

const ERR_XRESERVE_WRONG_DOMAIN = "deposit intent remote domain does not match the faucet domain"
const ERR_XRESERVE_WRONG_IDENTIFIER = "deposit intent remote token does not match the faucet identifier"

# D5b amount/fee (R-MINT-10/11). R-MINT-9 (ERR_X_TOO_LARGE) is CONSUMED from the 04
# reducer, never redefined here.
const ERR_XRESERVE_AMOUNT_BELOW_FEE = "deposit intent amount is below the max fee"
const ERR_XRESERVE_FEE_OVER_MAX = "operator fee amount exceeds the deposit intent max fee"

# PUBLIC INTERFACE
# =================================================================================================

#! Asserts the faucet-owned DepositIntent mint preconditions over a staged preimage.
#!
#! Delegates the structural validation (D5a steps 1-4, 7, 8) to the 04-owned
#! `xreserve::encoding::parse_deposit_intent`, then asserts the two faucet-owned
#! compares (D5a steps 5-6) against the faucet config slots: the parsed remote domain
#! must equal the configured domain, and the canonical key-Word of the parsed remote
#! token must equal the configured identifier key.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [hook_data_len]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - hook_data_len is the semantic hookDataLen value as a u32 felt.
#!
#! Panics if:
#! - parse_deposit_intent fails to verify.
#! - the parsed remote domain does not equal the faucet's configured domain.
#! - the parsed remote token's key does not equal the faucet's configured identifier key.
#! - a config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
pub proc assert_deposit_intent
    exec.encoding::parse_deposit_intent
    # => [remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    # D5a step 5 (R-MINT-6): the configured domain lives in element 0 of the domain
    # config slot word
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3, remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    movdn.3 drop drop drop
    # => [domain, remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    assert_eq.err=ERR_XRESERVE_WRONG_DOMAIN
    # => [REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    # D5a step 6 (R-MINT-7): the parser's packed remoteToken words are already in the
    # [B1, B0] orientation bytes32_to_key consumes
    exec.encoding::bytes32_to_key
    # => [KEY, hook_data_len]

    push.IDENTIFIER_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [STORED_KEY, KEY, hook_data_len]

    assert_eqw.err=ERR_XRESERVE_WRONG_IDENTIFIER
    # => [hook_data_len]
end

#! Asserts the faucet-owned D5b amount/fee mint preconditions over a staged preimage.
#!
#! Consumes the 04-owned `xreserve::encoding::uint256_to_asset_amount` BY REFERENCE to
#! reduce the `amount` (felt[2..9]) and `maxFee` (felt[43..50]) uint256 fields from the
#! staged preimage and the operator `feeAmount` (8 u32-LE limbs read from the advice
#! stack), then asserts reduced `amount >= maxFee` (R-MINT-10) and reduced
#! `feeAmount <= maxFee` (R-MINT-11). R-MINT-9 (`ERR_X_TOO_LARGE`, high-4 limbs nonzero)
#! PROPAGATES from the reducer on any of the three values.
#!
#! `feeAmount` advice-provider hygiene (human-ratified Option C): `feeAmount` is an
#! operator-chosen free parameter with no in-scope kernel-trusted commitment, so the
#! commitment/content-key hygiene rules are N/A; its bound is the R-MINT-11 compare
#! against the Circle-signed `maxFee`. Missing advice ERRORS (the `adv_push` read traps),
#! never defaults; a malformed (non-u32) limb traps `ERR_FELT_OUT_OF_FIELD` in the
#! reducer's `u32assertw` guard. `feeAmount == 0` is the operator pushing eight zero limbs.
#!
#! Inputs:  [intent_ptr, scale_exp]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - scale_exp is the decimal scale exponent forwarded to the reducer (DEV-5 OPEN).
#!
#! Panics if:
#! - the reducer rejects amount, maxFee, or feeAmount (ERR_X_TOO_LARGE / ERR_AMOUNT_OVER_CAP).
#! - a feeAmount advice limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD), or feeAmount advice is absent.
#! - reduced amount < maxFee (ERR_XRESERVE_AMOUNT_BELOW_FEE, R-MINT-10).
#! - reduced feeAmount > maxFee (ERR_XRESERVE_FEE_OVER_MAX, R-MINT-11).
#!
#! Invocation: exec
pub proc assert_mint_amounts
    # => [intent_ptr, scale_exp]

    # reduce amount (felt[2..9]); keep [intent_ptr, scale_exp] live below for reuse
    dup.1 dup.1 push.AMOUNT_FELT_OFF add
    # => [amount_base, scale_exp, intent_ptr, scale_exp]
    exec.reduce_uint256_field
    # => [amount_y, intent_ptr, scale_exp]

    # reduce maxFee (felt[43..50])
    dup.2 dup.2 push.MAX_FEE_FELT_OFF add
    # => [maxfee_base, scale_exp, amount_y, intent_ptr, scale_exp]
    exec.reduce_uint256_field
    # => [maxfee_y, amount_y, intent_ptr, scale_exp]

    # intent_ptr is no longer needed (feeAmount comes from advice)
    movup.2 drop
    # => [maxfee_y, amount_y, scale_exp]

    # R-MINT-10: assert reduced amount >= maxFee (maxFee <= amount), keeping maxfee_y for
    # R-MINT-11. Both reduced values are < 2^63 (felts are unordered) -> u64 limb compare.
    dup movup.2 swap
    # => [maxfee_y, amount_y, maxfee_y, scale_exp]
    u32split
    # => [maxfee_lo, maxfee_hi, amount_y, maxfee_y, scale_exp]
    movup.2 u32split
    # => [amount_lo, amount_hi, maxfee_lo, maxfee_hi, maxfee_y, scale_exp]
    # u64::lte over [b, a] (b on top) returns a <= b; here b = amount, a = maxFee
    exec.u64::lte
    # => [is_amount_ge_maxfee, maxfee_y, scale_exp]
    assert.err=ERR_XRESERVE_AMOUNT_BELOW_FEE
    # => [maxfee_y, scale_exp]

    # reduce feeAmount from the advice stack: the first adv_pushw pops limbs 0..3 (-> U0),
    # the next pops limbs 4..7 (-> U1), matching the reducer's [U1, U0] shape. A missing
    # word traps (advice stack read), never defaults.
    adv_pushw
    # => [U0, maxfee_y, scale_exp]
    adv_pushw
    # => [U1, U0, maxfee_y, scale_exp]
    movup.9 movdn.8
    # => [U1, U0, scale_exp, maxfee_y]
    exec.encoding::uint256_to_asset_amount
    # => [feeamount_y, maxfee_y]

    # R-MINT-11: assert reduced feeAmount <= maxFee
    u32split
    # => [fee_lo, fee_hi, maxfee_y]
    movup.2 u32split
    # => [maxfee_lo, maxfee_hi, fee_lo, fee_hi]
    # u64::lte over [b, a] (b on top) returns a <= b; here b = maxFee, a = feeAmount
    exec.u64::lte
    # => [is_fee_le_maxfee]
    assert.err=ERR_XRESERVE_FEE_OVER_MAX
    # => []
end

#! Asserts the deposit intent's nonce has not been used (D5c replay guard).
#!
#! RED-SUITE PLACEHOLDER: traps unconditionally so the D5c happy + replay tests are RED via
#! REAL execution until the green commit lands the real assert-zero. No new `const` (the
#! inline `.err` string is not parsed by the constant-parity sweep, so parity stays green).
#!
#! Inputs:  [intent_ptr]
#! Outputs: []
#!
#! Invocation: exec
pub proc assert_nonce_unused
    push.0 assert.err="red-suite placeholder: assert_nonce_unused is not implemented"
end

# HELPER PROCEDURES
# =================================================================================================

#! Reduces the uint256 field at `base` (8 u32-LE packed felts) to an AssetAmount via the
#! 04-owned reducer, consumed BY REFERENCE.
#!
#! Single-felt loads: the DC-1 felt offsets are not word-aligned, so word loads trap
#! (UnalignedWordAccess). The word orientation mirrors the 04 parser's remoteToken load
#! (`encoding::parse_deposit_intent`): U0 = the field's first four packed limbs (wire
#! bytes 0..16), U1 = the next four (wire bytes 16..32), each element-0 on top — exactly
#! the `[U1, U0, scale_exp]` shape the reducer consumes.
#!
#! Inputs:  [base, scale_exp]
#! Outputs: [y]
#!
#! Where:
#! - base is the memory address of the field's first packed felt.
#! - scale_exp is the decimal scale exponent.
#! - y is the reduced AssetAmount felt.
#!
#! Panics if:
#! - the reducer rejects the value (ERR_X_TOO_LARGE / ERR_AMOUNT_OVER_CAP / ERR_FELT_OUT_OF_FIELD).
#!
#! Invocation: exec
proc reduce_uint256_field
    # => [base, scale_exp]

    # U0: the field's first four packed limbs at base+0..base+3 (element-0 on top)
    dup add.3 mem_load
    dup.1 add.2 mem_load
    dup.2 add.1 mem_load
    dup.3 mem_load
    # => [U0, base, scale_exp]

    # U1: the next four packed limbs at base+4..base+7
    dup.4 add.7 mem_load
    dup.5 add.6 mem_load
    dup.6 add.5 mem_load
    dup.7 add.4 mem_load
    # => [U1, U0, base, scale_exp]

    movup.8 drop
    # => [U1, U0, scale_exp]

    exec.encoding::uint256_to_asset_amount
    # => [y]
end
