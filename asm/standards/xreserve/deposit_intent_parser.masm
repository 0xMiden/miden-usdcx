# xreserve::deposit_intent_parser
#
# The DepositIntent parser and the faucet-side mint preconditions it feeds, behind the single
# `validate` entry: the structural parse and length derivation, the domain and identifier
# equality compares, the amount/fee bounds, and the nonce replay guard. The identifier slot
# stores the canonical `bytes32_to_key` key-Word, so the identifier equality is realized as key
# equality.
#
# A DepositIntent is the Circle-signed message that authorizes one mint. Its wire form is a
# fixed 240-byte big-endian header followed by variable-length hookData; on-chain it is staged
# as u32-LE-packed felts (4 wire bytes per felt). The header fields, by wire byte offset:
# - magic (bytes 0..4): a fixed sentinel identifying a DepositIntent; set by Circle.
# - version (bytes 4..8): the wire-format version, currently 1; set by Circle.
# - amount (bytes 8..40): the deposited amount as a uint256 in the token's 6-decimal smallest
#   units; set by Circle from the source-chain deposit.
# - remoteDomain (bytes 40..44): the destination-domain id Circle assigns this chain; the
#   faucet accepts only its configured domain.
# - remoteToken (bytes 44..76): the destination token identifier as bytes32; the faucet
#   accepts only its configured identifier.
# - remoteRecipient (bytes 76..108): the destination account to mint to, as bytes32 (the
#   right-aligned account-id packaging); chosen by the depositor.
# - localToken (bytes 108..140): the source-chain token contract as bytes32; set by Circle.
# - localDepositor (bytes 140..172): the source-chain depositor as bytes32; set by Circle.
# - maxFee (bytes 172..204): the depositor-authorized fee ceiling as a uint256.
# - nonce (bytes 204..236): Circle's unique deposit nonce as bytes32; drives the replay guard.
# - hookDataLen (bytes 236..240): the byte length of the trailing hookData; it is what the
#   staged length is derived from.
# - hookData (bytes 240..): an optional opaque payload; parsed only for length, never for
#   effects.

use miden::protocol::active_account
use miden::standards::assets::asset_amount
use miden::standards::utils
use miden::core::math::u128
use miden::core::word
use xreserve::encoding
use {
    AMOUNT_FELT_OFF, DEPOSIT_INTENT_HEADER_BYTES, DEPOSIT_INTENT_HEADER_FELTS,
    DEPOSIT_INTENT_MAGIC_PACKED, DEPOSIT_INTENT_VERSION_PACKED,
    HOOK_DATA_LEN_FELT_OFF, LOCAL_DEPOSITOR_FELT_OFF,
    LOCAL_TOKEN_FELT_OFF, MAGIC_FELT_OFF, MAX_FEE_FELT_OFF, NONCE_FELT_OFF,
    REMOTE_DOMAIN_FELT_OFF, REMOTE_TOKEN_FELT_OFF, VERSION_FELT_OFF
} from xreserve::encoding::layout

# CONSTANTS
# =================================================================================================

# Slots — ids derive from the namespaced label strings below.
pub const DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::domain")
pub const IDENTIFIER_CONFIG_SLOT = word("xusdc::xreserve::domain_config::identifier")

# The usedNonces StorageMap slot (the nonce replay registry). The map slot itself is declared
# by the Rust account builder; this const is the MASM-side slot id.
pub const USED_NONCES_SLOT = word("xusdc::xreserve::nonce_registry::used_nonces")

# The uint256->AssetAmount decimal scale (`y = floor(x / 10^scale_exp)`), FAUCET-side by design: a
# note-carried scale would let the producer diverge the minted amount from the attested amount. The
# amount cap / scale / dust tolerance are OPEN, pending Circle confirmation; the faucet ships the
# PROVISIONAL scale-0 position because Circle's on-wire deposit `amount` is denominated in 6-decimal
# smallest units and xUSDC is likewise 6-decimal, so the two denominations coincide and no rescale
# applies — scale 0, `y = floor(x / 10^0) = x`, an identity with no floored dust. (`0` is inside the
# reducer's `[0, 18]` scale bound.) Changing this constant is how the faucet would be
# repointed at a wire denomination whose asset is scaled differently.
const DEPOSIT_SCALE_EXP = 0

# ERRORS
# =================================================================================================

# Structural rejects over the staged preimage.
const ERR_DI_BAD_MAGIC = "deposit intent magic mismatch"
const ERR_DI_BAD_VERSION = "deposit intent version mismatch"
const ERR_DI_ZERO_FIELD = "deposit intent amount, local token, or local depositor is zero"

# The staged hookDataLen limb must be a valid u32 before the length derivation byte-swaps it.
const ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB = "mint note deposit intent hook data length limb is not a valid u32"

# The attachment's hash-committed word count must equal the word count that the embedded
# hookDataLen implies.
const ERR_XRESERVE_MINT_NOTE_INTENT_WORDS = "mint note deposit intent attachment word count does not match the intent length"

const ERR_XRESERVE_WRONG_DOMAIN = "deposit intent remote domain does not match the faucet domain"
const ERR_XRESERVE_WRONG_IDENTIFIER = "deposit intent remote token does not match the faucet identifier"

# Amount/fee errors. The maxFee staging declares its own too-large and limb guards (the
# same strings the encoding library uses); the amount field goes through the witness verifier.
# The fee gate requires the wire feeAmount to be zero verbatim, since there is no relayer-fee
# leg yet, which subsumes the feeAmount <= maxFee compare.
const ERR_X_TOO_LARGE = "larger than 2**128"
const ERR_FELT_OUT_OF_FIELD = "supplied limb is not a valid u32"
const ERR_XRESERVE_AMOUNT_BELOW_FEE = "deposit intent amount is below the max fee"
const ERR_XRESERVE_FEE_NONZERO = "mint fee amount must be zero"

# Nonce replay: assert-zero only; marking the nonce used is the mint policy's accept-path
# write, so a failed mint never consumes a nonce.
const ERR_XRESERVE_NONCE_REPLAY = "deposit intent nonce has already been used"

# PUBLIC INTERFACE
# =================================================================================================

#! Validates a staged DepositIntent preimage against every faucet-owned mint precondition.
#!
#! Derives the preimage length from the embedded hookDataLen and binds it to the attachment's
#! hash-committed word count, then runs the three validation stages in order:
#! - the structural parse with the domain and identifier compares
#! - the amount and fee bounds
#! - and the nonce replay guard
#!
#! Callers stage the preimage and supply the committed word count.
#!
#! Inputs:  [intent_ptr, intent_expected_num_words, fee_amount_ptr, amount_y]
#! Outputs: [intent_num_bytes]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - intent_expected_num_words is the word count the caller requires the staged preimage to have
#!   (in the mint pipeline, the attachment's hash-committed word count).
#! - fee_amount_ptr is the memory address of the operator feeAmount's first packed limb (8 u32-LE
#!   limbs).
#! - amount_y is the claimed reduced amount witness (in the mint pipeline, the note-supplied
#!   asset value).
#! - intent_num_bytes is the wire length of the preimage in bytes (the header plus hookData),
#!   which is the extent the attestation signature covers.
#!
#! Panics if:
#! - the parse rejects (magic, version, a zero field, a malformed hookDataLen limb, or a word
#!   count that disagrees with the parsed length).
#! - a mint stage rejects (see the stage procedures below).
#!
#! Invocation: exec
pub proc validate
    dup movdn.2
    dup movdn.5
    # => [intent_ptr, intent_expected_num_words, intent_ptr, fee_amount_ptr, amount_y, intent_ptr]

    exec.parse
    # => [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_num_bytes, intent_ptr, fee_amount_ptr, amount_y, intent_ptr]

    exec.validate_domain_and_identifier
    # => [intent_num_bytes, intent_ptr, fee_amount_ptr, amount_y, intent_ptr]

    movdn.4
    # => [intent_ptr, fee_amount_ptr, amount_y, intent_ptr, intent_num_bytes]

    exec.validate_mint_amounts
    # => [intent_ptr, intent_num_bytes]

    exec.validate_nonce_unused
    # => [intent_num_bytes]
end

#! Parses a staged DepositIntent preimage: asserts its structure and returns its length with the
#! fields the faucet compares against its configuration.
#!
#! The preimage length is DERIVED from the embedded hookDataLen rather than taken from the caller.
#! The caller passes the word count it requires the staged preimage to have, and this procedure
#! asserts the derived length agrees with it — the only length assert in the pipeline. Because the
#! derived length is the header plus the packed hookData felts, it is never below the header
#! count, so that compare also proves the whole header was written into the staged region.
#!
#! Inputs:  [intent_ptr, intent_expected_num_words]
#! Outputs: [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_num_bytes]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - intent_expected_num_words is the word count the caller requires the staged preimage to have
#!   (in the mint pipeline, the attachment's hash-committed word count).
#! - remote_domain is the semantic remoteDomain value as a u32 felt.
#! - REMOTE_TOKEN_UPPER is the word holding the remoteToken field's positionally upper four
#!   packed limbs (intent bytes 60..76).
#! - REMOTE_TOKEN_LOWER is the word holding the remoteToken field's positionally lower four
#!   packed limbs (intent bytes 44..60).
#! - intent_num_bytes is the wire length: the header bytes plus hookData, which is the extent
#!   the attestation signature covers.
#!
#! Panics if:
#! - the packed magic does not match the DepositIntent magic.
#! - the packed version does not match the supported version.
#! - the amount field is zero.
#! - the localToken field is zero.
#! - the localDepositor field is zero.
#! - the staged hookDataLen or remoteDomain limb is not a valid u32.
#! - intent_expected_num_words does not equal the word count the derived length implies.
#!
#! Invocation: exec
pub proc parse
    # packed magic must match
    dup add.MAGIC_FELT_OFF mem_load
    push.DEPOSIT_INTENT_MAGIC_PACKED assert_eq.err=ERR_DI_BAD_MAGIC
    # => [intent_ptr, intent_expected_num_words]

    # packed version must match
    dup add.VERSION_FELT_OFF mem_load
    push.DEPOSIT_INTENT_VERSION_PACKED assert_eq.err=ERR_DI_BAD_VERSION
    # => [intent_ptr, intent_expected_num_words]

    # amount, localToken, localDepositor must be nonzero
    dup add.AMOUNT_FELT_OFF exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup add.LOCAL_TOKEN_FELT_OFF exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup add.LOCAL_DEPOSITOR_FELT_OFF exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    # => [intent_ptr, intent_expected_num_words]

    # hookDataLen (semantic u32): byte-swap the packed felt at offset 59. it is hash-committed
    # content, so guard the limb before the byte-swap
    dup add.HOOK_DATA_LEN_FELT_OFF mem_load
    u32assert.err=ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB
    exec.utils::swap_u32_bytes
    # => [hook_data_len, intent_ptr, intent_expected_num_words]

    # the wire length is the header bytes plus hookData
    dup add.DEPOSIT_INTENT_HEADER_BYTES
    # => [intent_num_bytes, hook_data_len, intent_ptr, intent_expected_num_words]

    # the staged length is the header felts plus the packed hookData felts
    swap exec.div_ceil_four
    # => [hook_data_num_felts, intent_num_bytes, intent_ptr, intent_expected_num_words]

    add.DEPOSIT_INTENT_HEADER_FELTS
    # => [intent_num_felts, intent_num_bytes, intent_ptr, intent_expected_num_words]

    # the caller holds a word count, so compare in words
    exec.div_ceil_four movup.3
    # => [intent_expected_num_words, intent_num_words, intent_num_bytes, intent_ptr]

    assert_eq.err=ERR_XRESERVE_MINT_NOTE_INTENT_WORDS
    # => [intent_num_bytes, intent_ptr]

    # outputs: load the compare fields from the staged preimage (single-felt loads — the header
    # felt offsets are not word-aligned); the packed remoteToken words are pushed in the same
    # element order the caller compares against
    swap dup add.REMOTE_TOKEN_FELT_OFF
    # => [rt_base, intent_ptr, intent_num_bytes]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_ptr, intent_num_bytes]

    movup.8
    # => [intent_ptr, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_num_bytes]

    # remote_domain (semantic u32): byte-swap the packed felt at offset 10
    add.REMOTE_DOMAIN_FELT_OFF mem_load
    u32assert.err=ERR_FELT_OUT_OF_FIELD
    exec.utils::swap_u32_bytes
    # => [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_num_bytes]
end

# HELPER PROCEDURES
# =================================================================================================

#! Asserts the two faucet-owned addressing compares against the faucet config slots: the parsed
#! remote domain must equal the configured domain, and the canonical key-Word of the parsed remote
#! token must equal the configured identifier key.
#!
#! Inputs:  [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER]
#! Outputs: []
#!
#! Where:
#! - remote_domain is the semantic remoteDomain value as a u32 felt.
#! - REMOTE_TOKEN_{UPPER,LOWER} are the remoteToken field's positionally upper / lower four
#!   packed limbs.
#!
#! Panics if:
#! - the parsed remote domain does not equal the faucet's configured domain.
#! - the parsed remote token's key does not equal the faucet's configured identifier key.
#! - a config slot with the expected id does not exist in account storage.
#!
#! Invocation: exec
proc validate_domain_and_identifier
    # domain compare: the configured domain lives in element 0 of the domain config slot word
    push.DOMAIN_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [domain, d1, d2, d3, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER]

    movdn.3 drop drop drop
    # => [domain, remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER]

    assert_eq.err=ERR_XRESERVE_WRONG_DOMAIN
    # => [REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER]

    # identifier compare: the parsed packed remoteToken words are already in the
    # [B_UPPER, B_LOWER] orientation bytes32_to_key consumes
    exec.encoding::bytes32_to_key
    # => [KEY]

    push.IDENTIFIER_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [STORED_KEY, KEY]

    assert_eqw.err=ERR_XRESERVE_WRONG_IDENTIFIER
    # => []
end

#! Asserts the faucet-owned amount and fee mint preconditions over a staged preimage.
#!
#! `amount` (felt[2..9]) and `maxFee` (felt[43..50]) come from the staged preimage; `feeAmount`
#! does not travel in the intent at all and lives wherever the caller staged it. The amount
#! goes through the encoding library's witness verifier against the `amount_y` claim at the
#! faucet's own `DEPOSIT_SCALE_EXP`; the maxFee bound is proven division-free by algebraic
#! equivalence; the feeAmount must be zero verbatim on the wire.
#!
#! Inputs:  [intent_ptr, fee_amount_ptr, amount_y]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - fee_amount_ptr is the memory address of the operator feeAmount's first packed limb (8 u32-LE
#!   limbs).
#! - amount_y is the claimed reduced amount witness (in the mint pipeline, the note-supplied
#!   asset value), proven equal to floor(amount / 10^DEPOSIT_SCALE_EXP) and within the fungible
#!   maximum by the verifier.
#!
#! Panics if:
#! - the witness verifier rejects the amount claim (the standards too-large / over-maximum /
#!   underflow / remainder constraints).
#! - a maxFee limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD), or the maxFee high half is
#!   nonzero (ERR_X_TOO_LARGE).
#! - reduced amount < maxFee (ERR_XRESERVE_AMOUNT_BELOW_FEE).
#! - any wire feeAmount limb is nonzero (ERR_XRESERVE_FEE_NONZERO).
#!
#! Invocation: exec
proc validate_mint_amounts
    # step 1: verify the witness supplied amount_y against the intent's amount field
    dup push.AMOUNT_FELT_OFF add
    # => [intent_amount_ptr, intent_ptr, fee_amount_ptr, amount_y]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [U_UPPER, U_LOWER, intent_ptr, fee_amount_ptr, amount_y]

    push.DEPOSIT_SCALE_EXP movdn.8
    # => [U_UPPER, U_LOWER, scale_exp, intent_ptr, fee_amount_ptr, amount_y]

    dup.11 movdn.9
    # => [U_UPPER, U_LOWER, scale_exp, amount_y, intent_ptr, fee_amount_ptr, amount_y]

    exec.encoding::verify_uint256_to_asset_amount
    # => [intent_ptr, fee_amount_ptr, amount_y]

    # step 2: assert the amount >= maxFee
    # floor(m/10^s) <= A  <=>  m < B = (A+1)*10^s (the verify above bounds amount_y, so the
    # +1 cannot wrap)
    push.MAX_FEE_FELT_OFF add
    # => [intent_maxfee_ptr, fee_amount_ptr, amount_y]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [M_UPPER, M_LOWER, fee_amount_ptr, amount_y]

    exec.to_u128_limbs
    # => [m0, m1, m2, m3, fee_amount_ptr, amount_y]

    movup.5 add.1
    # => [amount_y+1, m0, m1, m2, m3, fee_amount_ptr]

    push.DEPOSIT_SCALE_EXP swap
    # => [amount_y+1, scale_exp, m0, m1, m2, m3, fee_amount_ptr]

    exec.asset_amount::scale_asset_amount_to_u256
    # => [B_LO, B_HI, m0, m1, m2, m3, fee_amount_ptr]

    # the u256 high word is provably zero (B < 2^123)
    swapw dropw
    # => [B_LO, m0, m1, m2, m3, fee_amount_ptr]

    exec.u128::lt
    # => [is_maxfee_lt_bound, fee_amount_ptr]

    assert.err=ERR_XRESERVE_AMOUNT_BELOW_FEE
    # => [fee_amount_ptr]

    # step 3: assert the staged wire feeAmount is zero verbatim — with no relayer-fee leg any
    # nonzero claim is refused outright. a packed limb is zero iff its wire bytes are zero, so
    # the raw limbs are checked directly; word order and limb well-formedness are irrelevant
    # (a malformed limb is nonzero and rejects)
    exec.utils::mem_load_double_word_unaligned
    # => [F_1, F_2]

    exec.word::eqz
    assert.err=ERR_XRESERVE_FEE_NONZERO
    # => [F_2]

    exec.word::eqz
    assert.err=ERR_XRESERVE_FEE_NONZERO
    # => []
end

#! Asserts the deposit intent's nonce has not been used (the mint replay guard).
#!
#! Derives the nonce key with the encoding library's `xreserve::encoding::bytes32_to_key` over the
#! parsed nonce (felt[51..58]), reads `usedNonces[key]` via `active_account::get_map_item`, and
#! asserts it is `EMPTY_WORD`. Marking the nonce as consumed is the mint policy's accept-path
#! write — this guard is assert-zero ONLY, so a failed mint never consumes a nonce.
#!
#! Inputs:  [intent_ptr]
#! Outputs: []
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#!
#! Panics if:
#! - usedNonces[key] is non-empty (the nonce was already used) -> ERR_XRESERVE_NONCE_REPLAY.
#!
#! Invocation: exec
proc validate_nonce_unused
    push.NONCE_FELT_OFF add
    # => [nonce_base]

    # load the nonce's eight packed limbs
    exec.utils::mem_load_double_word_unaligned swapw
    # => [B_UPPER, B_LOWER]

    exec.encoding::bytes32_to_key
    # => [KEY]

    push.USED_NONCES_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    # assert-zero: an unused nonce reads EMPTY_WORD; a used (non-empty) one traps. this guard
    # does not write the registry -- consuming the nonce is the mint policy's accept-path write.
    padw assert_eqw.err=ERR_XRESERVE_NONCE_REPLAY
    # => []
end

#! Returns whether any of the eight consecutive felts at the given address is nonzero.
#!
#! Used for the DepositIntent 32-byte-field zero checks (a field is zero iff all eight of
#! its u32-LE-packed limbs are zero).
#!
#! Inputs:  [addr]
#! Outputs: [is_nonzero]
#!
#! Where:
#! - addr is the memory address of the field's first packed felt.
#! - is_nonzero is 1 when any of the eight felts is nonzero, 0 otherwise.
#!
#! Invocation: exec
proc field8_is_nonzero
    push.0 swap
    # => [addr, acc]

    repeat.8
        dup mem_load neq.0
        # => [is_non_zero, addr, acc]

        movup.2 or
        # => [acc', addr]

        swap add.1
        # => [addr+1, acc']
    end
    # => [addr+8, acc]

    drop
    # => [acc]
end

#! Returns num_items divided by four, rounded up.
#!
#! Inputs:  [num_items]
#! Outputs: [num_groups]
#!
#! Where:
#! - num_items is a u32 count of items packed four to a group (wire bytes in a felt, or felts in
#!   a word).
#! - num_groups is the number of groups that hold them.
#!
#! Panics if:
#! - num_items is not a valid u32.
#!
#! Invocation: exec
proc div_ceil_four
    u32divmod.4 neq.0 add
end

#! Normalizes a staged uint256 to its numerically-low half as u128 little-endian u32 limbs.
#!
#! Guards every limb as a u32, asserts the numerically high half (U_LOWER, wire bytes 0..16)
#! is zero, then byte-swaps and reverses the low half into little-endian u128 limb order.
#! Works with any trailing elements beneath the two words.
#!
#! Inputs:  [U_UPPER, U_LOWER]
#! Outputs: [x0, x1, x2, x3]
#!
#! Where:
#! - U_UPPER / U_LOWER are the field's positionally upper / lower four u32-LE-packed limbs
#!   (wire bytes 16..32 / 0..16), each element-0 on top.
#! - x0..x3 are the value's u32 limbs in little-endian order (x = x3*2^96 + x2*2^64 +
#!   x1*2^32 + x0).
#!
#! Panics if:
#! - a limb is not a valid u32 (ERR_FELT_OUT_OF_FIELD).
#! - any limb of the numerically high half is nonzero (ERR_X_TOO_LARGE).
#!
#! Invocation: exec
proc to_u128_limbs
    # guard every externally-supplied limb before any u32 op
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    swapw
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    # => [U_LOWER, U_UPPER]

    exec.word::eqz
    assert.err=ERR_X_TOO_LARGE
    # => [U_UPPER]

    # byte-swap the numerically-low-half limbs to numeric order
    repeat.4
        exec.utils::swap_u32_bytes movdn.3
    end
    # => [n4, n5, n6, n7]

    exec.word::reverse
    # => [x0, x1, x2, x3]
end
