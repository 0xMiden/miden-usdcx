# xreserve::domain_config
#
# The owner-gated, init-once domain-config setter (R-ADMIN-4): a one-time write of ALL FOUR
# domain-config fields (CMP-A6) -- `domain:u32` + `source_domain:u32` + `xreserve_contract:bytes32`
# + `identifier:bytes32`. The `domain`/`identifier` slots are the ones the mint path's D5a compare
# (deposit_intent_parser::assert_deposit_intent) reads to reject mis-addressed deposits (their
# labels/encodings are BYTE-IDENTICAL to the accepted 2-field surface); `source_domain` and
# `xreserve_contract` have NO on-chain consumer -- they are deploy-time identity configuration the
# off-chain services read via `GetAccount`. A second write traps ERR_XRESERVE_DOMAIN_REINIT.
# Owner-gated (Ownable2Step); no pause gate (deploy-time config is orthogonal to the operational
# pause). The domain/identifier slot consts are IMPORTED from deposit_intent_parser (the single
# source of truth with D5a); the three NEW slot consts live HERE (their only user).
#
# FIELD-REPRESENTATION ASYMMETRY: `identifier` is stored as the Poseidon2 bytes32->key WORD --
# consumer-forced, because D5a's `assert_eqw` compares the hashed form. `xreserve_contract` is stored
# LOSSLESSLY as its raw 8x u32-LE packed felts across TWO value slots (hi = wire bytes 0..16, lo =
# bytes 16..32; the encoding library's `bytes32_to_packed_felts` packing, consumed by reference on
# the Rust side): it has no on-chain compare, so the public identity must be READABLE from storage
# (fail-closed `packed_felts_to_bytes32` round-trip), not merely verifiable.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::access::ownable2step
use xreserve::deposit_intent_parser::DOMAIN_CONFIG_SLOT
use xreserve::deposit_intent_parser::IDENTIFIER_CONFIG_SLOT

# CONSTANTS
# =================================================================================================

# `source_domain` (u32) value slot: `[source_domain, 0, 0, 0]`, mirroring the domain slot.
const SOURCE_DOMAIN_CONFIG_SLOT = word("xusdc::xreserve::domain_config::source_domain")

# `xreserve_contract` (bytes32) value slots: the raw 8x u32-LE packed felts, hi = packed
# felts[0..4] (wire bytes 0..16), lo = packed felts[4..8] (wire bytes 16..32).
const XRESERVE_CONTRACT_HI_SLOT = word("xusdc::xreserve::domain_config::xreserve_contract_hi")
const XRESERVE_CONTRACT_LO_SLOT = word("xusdc::xreserve::domain_config::xreserve_contract_lo")

# ERRORS
# =================================================================================================

# R-ADMIN-4: domain config is init-once; a second write traps. The init-once sentinel is the
# identifier slot -- a Poseidon2 bytes32->key hash, non-empty by construction once set, so it is
# value-independent of the Circle-assigned domain value (which could legitimately be 0). ONE
# sentinel guards the atomic four-field write: the tx writes all four fields or traps before any
# write, so no partial state exists for a second init to extend.
const ERR_XRESERVE_DOMAIN_REINIT = "domain config has already been initialized"

# scalar-u32 exactness: the spec types `domain` and `source_domain` as u32; the guards trap a
# malformed (non-u32) felt BEFORE any write.
const ERR_XRESERVE_DOMAIN_NOT_U32 = "domain is not a valid u32"
const ERR_XRESERVE_SOURCE_DOMAIN_NOT_U32 = "source domain is not a valid u32"

# guard 2: every xreserve_contract limb must be a valid u32 before the two packed words
# are stored -- the fail-closed on-chain mirror of the Rust `packed_felts_to_bytes32` inverse.
const ERR_XRESERVE_XRC_LIMB_NOT_U32 = "xreserve contract limb is not a valid u32"

# R-ADMIN-4 hardening: the identifier IS the init-once sentinel; an EMPTY
# identifier would never arm it (the "immutable" config stays silently re-initializable) and D5a
# would compare every intent's identifier against EMPTY. Trap rather than deploy that state.
const ERR_XRESERVE_IDENTIFIER_EMPTY = "identifier must be non-empty"

# PUBLIC INTERFACE
# =================================================================================================

#! Writes the FOUR faucet domain-config fields, owner-gated and init-once: `domain` (u32) and
#! `identifier` (the pre-hashed bytes32->key Word) -- the slots the mint path's D5a compare reads
#! to reject mis-addressed deposits -- plus `source_domain` (u32) and `xreserve_contract` (the raw
#! 8x u32-LE packed bytes32 across two words), the off-chain-read identity fields. Gated on the
#! Ownable2Step owner -- NOT an operational role -- because domain binding is deploy-time identity.
#! Init-once (R-ADMIN-4): a second call finds the identifier slot non-empty and traps; the write is
#! atomic (all validation precedes every write, and a trapped tx commits nothing), so all four
#! fields are set together or not at all. The identifier is trusted verbatim (the set_attester
#! discipline); D5a compares the stored Word directly. The scalars and every xreserve_contract limb
#! are u32-guarded BEFORE any write (the spec types them u32; the packing is u32-LE).
#!
#! Inputs:  [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - IDENTIFIER is the faucet identifier as the canonical bytes32->key Word (stored verbatim; D5a
#!   asserts word equality against it).
#! - XRC_HI / XRC_LO are the xreserve_contract bytes32 as its 8x u32-LE packed felts (hi = wire
#!   bytes 0..16, lo = bytes 16..32; the encoding library's codec packing), stored verbatim after the limb guards.
#! - source_domain is the u32 source (native-USDC) domain id, stored as element 0 of its word.
#! - domain is the u32 domain id, stored as element 0 of the domain config word (D5a reads
#!   element 0).
#!
#! The 14 meaningful inputs + pad(2) fill the 16-element call-boundary window EXACTLY (zero
#! margin): any future field cannot ride the stack and must move to the advice provider (with
#! advice-provider-hygiene validation).
#!
#! Panics if:
#! - the note sender is not the Ownable2Step owner (ownable2step::assert_sender_is_owner,
#!   ERR_SENDER_NOT_OWNER).
#! - the domain config was already initialized -- the identifier slot is non-empty
#!   (ERR_XRESERVE_DOMAIN_REINIT, R-ADMIN-4).
#! - the input IDENTIFIER is the empty word -- it could never arm the init-once sentinel
#!   (ERR_XRESERVE_IDENTIFIER_EMPTY).
#! - domain is not a valid u32 (ERR_XRESERVE_DOMAIN_NOT_U32).
#! - source_domain is not a valid u32 (ERR_XRESERVE_SOURCE_DOMAIN_NOT_U32).
#! - any xreserve_contract limb is not a valid u32 (ERR_XRESERVE_XRC_LIMB_NOT_U32).
#!
#! Invocation: call
pub proc domain_init
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # gate: owner-only. Domain binding is deploy-time identity, off the operational roles.
    exec.ownable2step::assert_sender_is_owner
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # init-once (R-ADMIN-4): the identifier slot must be EMPTY. assert_eqw against EMPTY_WORD passes
    # only when uninitialized; a second write finds the stored hash word and traps.
    push.IDENTIFIER_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [STORED_IDENTIFIER, IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    padw assert_eqw.err=ERR_XRESERVE_DOMAIN_REINIT
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # hardening (R-ADMIN-4): the input IDENTIFIER must be non-empty -- an EMPTY identifier would
    # never arm the sentinel above. Non-destructive compare: eqw pushes the flag WITHOUT consuming
    # the words, so IDENTIFIER reaches its verbatim write (and D5a's read) untouched.
    padw
    # => [EMPTY, IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    eqw
    # => [is_empty, EMPTY, IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    assertz.err=ERR_XRESERVE_IDENTIFIER_EMPTY
    # => [EMPTY, IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    dropw
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # u32 guards -- ALL validation BEFORE ANY write (a trap here leaves every slot unwritten).
    # domain sits at position 13, source_domain at 12; each is dup'd, asserted, and dropped so the
    # stack is untouched.
    dup.13 u32assert.err=ERR_XRESERVE_DOMAIN_NOT_U32 drop
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    dup.12 u32assert.err=ERR_XRESERVE_SOURCE_DOMAIN_NOT_U32 drop
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # guard 2: all 8 xreserve_contract limbs are valid u32s (word positions 1 and 2).
    dupw.1 u32assertw.err=ERR_XRESERVE_XRC_LIMB_NOT_U32 dropw
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    dupw.2 u32assertw.err=ERR_XRESERVE_XRC_LIMB_NOT_U32 dropw
    # => [IDENTIFIER, XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # identifier_config := IDENTIFIER (the verbatim Word D5a's assert_eqw reads).
    push.IDENTIFIER_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [XRC_HI, XRC_LO, source_domain, domain, pad(2)]

    # xreserve_contract_hi := XRC_HI (packed felts[0..4], verbatim after the limb guard).
    push.XRESERVE_CONTRACT_HI_SLOT[0..2] exec.native_account::set_item dropw
    # => [XRC_LO, source_domain, domain, pad(2)]

    # xreserve_contract_lo := XRC_LO (packed felts[4..8], verbatim after the limb guard).
    push.XRESERVE_CONTRACT_LO_SLOT[0..2] exec.native_account::set_item dropw
    # => [source_domain, domain, pad(2)]

    # source_domain_config := [source_domain, 0, 0, 0] (element 0, mirroring the domain word).
    push.0.0.0 movup.3
    # => [source_domain, 0, 0, 0, domain, pad(2)]

    push.SOURCE_DOMAIN_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [domain, pad(2)]

    # domain_config := [domain, 0, 0, 0] (D5a reads element 0; encoding byte-identical to the
    # accepted 2-field surface).
    push.0.0.0 movup.3
    # => [domain, 0, 0, 0, pad(2)]

    push.DOMAIN_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [pad(2)]
end
