# xreserve::encoding
#
# Canonical 04-owned shared-encoding procedures (D-1A layout: the flat-named proc bodies
# live in this directory module so the frozen `xreserve::encoding::<name>` paths resolve
# exactly). Wire-layout constants live in the `layout` submodule.
#
# BUILD STATE: all three slice procedures are implemented (R1 bytes32_to_key,
# R2 uint256_to_asset_amount, R4 parse_deposit_intent).

use miden::core::crypto::hashes::poseidon2
use miden::core::math::u128
use miden::core::math::u64
use miden::core::word
use xreserve::encoding::layout::AMOUNT_FELT_OFF
use xreserve::encoding::layout::DEPOSIT_INTENT_HEADER_FELTS
use xreserve::encoding::layout::DEPOSIT_INTENT_MAGIC_PACKED
use xreserve::encoding::layout::DEPOSIT_INTENT_VERSION_PACKED
use xreserve::encoding::layout::HOOK_DATA_LEN_FELT_OFF
use xreserve::encoding::layout::LOCAL_DEPOSITOR_FELT_OFF
use xreserve::encoding::layout::LOCAL_TOKEN_FELT_OFF
use xreserve::encoding::layout::MAGIC_FELT_OFF
use xreserve::encoding::layout::REMOTE_DOMAIN_FELT_OFF
use xreserve::encoding::layout::REMOTE_TOKEN_FELT_OFF
use xreserve::encoding::layout::VERSION_FELT_OFF
use ::miden::protocol::asset::FUNGIBLE_ASSET_MAX_AMOUNT

# CONSTANTS
# =================================================================================================

# frozen §6.4: scale_exp = EVM decimals − Miden decimals, bounded to 0..=18 (10^18 < 2^60)
const SCALE_EXP_MAX = 18

# the u32 limb base used to compose the output felt from two u32 quotient limbs
const POW2_32 = 4294967296

# the 33-byte compressed secp256k1 pubkey packs to 9 u32-LE felts (33.div_ceil(4)); this is
# the element count poseidon2::hash_elements absorbs for the attester commitment (matches the
# precompile verify wrapper's PK_LEN_FELTS; constant-parity'd against the Rust PUBKEY_FELTS)
const PUBKEY_FELTS = 9

# ERRORS
# =================================================================================================

const ERR_X_TOO_LARGE = "larger than 2**128"
const ERR_AMOUNT_OVER_CAP = "post-scale quotient exceeds the asset amount maximum"
const ERR_SCALE_EXP_TOO_LARGE = "scale exponent exceeds 18"
const ERR_FELT_OUT_OF_FIELD = "supplied limb is not a valid u32"
const ERR_DI_BAD_MAGIC = "deposit intent magic mismatch"
const ERR_DI_BAD_VERSION = "deposit intent version mismatch"
const ERR_DI_ZERO_FIELD = "deposit intent amount, local token, or local depositor is zero"
const ERR_DI_LENGTH = "deposit intent length relation violated"

# PUBLIC INTERFACE
# =================================================================================================

#! Hashes an external bytes32 into its canonical storage-map key Word.
#!
#! Computes the Poseidon2 hash over the 8 u32-LE-packed limbs of the bytes32 (Option B
#! hash-to-Word; the fallible native lossless conversion is never used on this path).
#!
#! Inputs:  [B1, B0]
#! Outputs: [KEY]
#!
#! Where:
#! - B1 is the word holding the bytes32's upper four u32-LE-packed limbs (bytes 16..32).
#! - B0 is the word holding the bytes32's lower four u32-LE-packed limbs (bytes 0..16).
#! - KEY is the Poseidon2 hash-to-Word storage-map key.
#!
#! Invocation: exec
pub proc bytes32_to_key
    # the hash absorbs B0 (bytes 0..16) as the first rate word: KEY = Poseidon2(B0 || B1),
    # matching the Rust mirror's Hasher::hash_elements over the 8 packed limbs
    swapw
    # => [B0, B1]

    hmerge
    # => [KEY]
end

#! Computes the attester-allowlist commitment key over a compressed secp256k1 public key.
#!
#! Poseidon2 over the 9 u32-LE-packed limbs of the 33-byte compressed pubkey, identical to
#! miden-crypto `PublicKey::to_commitment` and the precompile `verify` wrapper's `PK_COMM`
#! (the value the faucet D5d verify recomputes and looks up in the `xReserveAttesters`
#! allowlist). NOTE the sponge capacity domain tag is `9 % 8 = 1` — this is NOT `hmerge`
#! (capacity 0, exactly 8 felts), so `bytes32_to_key` cannot serve it.
#!
#! Inputs:  [PK_W0, PK_W1, pk8]
#! Outputs: [COMM]
#!
#! Where:
#! - PK_W0 is the word holding pubkey felts 0..4 (compressed bytes 0..16).
#! - PK_W1 is the word holding pubkey felts 4..8 (compressed bytes 16..32).
#! - pk8 is the 9th pubkey felt (compressed byte 32, u32-LE zero-filled).
#! - COMM is the Poseidon2 commitment Word.
#!
#! Invocation: exec
@locals(12)
pub proc pubkey_commitment
    # Stage the 9 pubkey felts into word-aligned locals so poseidon2::hash_elements can absorb
    # them, mirroring the precompile verify wrapper's PK_COMM staging (miden-core-lib-0.23.3
    # asm/crypto/dsa/ecdsa_k256_keccak.masm:56-66). loc_storew_le places the top word's first
    # felt at the lowest address, so loc[0..9] = the 9 to_elements felts (f0..f8).
    loc_storew_le.0 dropw
    # => [PK_W1, pk8]

    loc_storew_le.4 dropw
    # => [pk8]

    loc_store.8
    # => []

    # COMM = Poseidon2(loc[0..9]); the sponge sets capacity[0] = 9 % 8 = 1 (domain tag),
    # identical to miden-crypto PublicKey::to_commitment and the precompile PK_COMM.
    push.PUBKEY_FELTS locaddr.0 exec.poseidon2::hash_elements
    # => [COMM]
end

#! Reduces an externally-supplied uint256 amount to an AssetAmount felt.
#!
#! Byte-swaps the limbs to numeric order, asserts the numerically high half (U0, wire
#! bytes 0..16) is zero, takes the numerically low half as a u128, floor-divides by
#! 10^scale_exp, and asserts the quotient does not exceed the AssetAmount maximum.
#! Rejects by trapping; never saturates or clamps.
#!
#! Inputs:  [U1, U0, scale_exp]
#! Outputs: [y]
#!
#! Where:
#! - U1 is the word holding the uint256's positionally upper four u32-LE-packed limbs (wire bytes 16..32 — the numerically low half).
#! - U0 is the word holding the uint256's positionally lower four u32-LE-packed limbs (wire bytes 0..16 — the numerically high half).
#! - scale_exp is the decimal scale exponent (EVM decimals minus Miden decimals, 0..=18).
#! - y is the reduced amount as a single AssetAmount felt.
#!
#! Panics if:
#! - any limb of the numerically high half (U0) is nonzero (the value exceeds 2^128).
#! - the post-scale quotient exceeds the AssetAmount maximum.
#! - scale_exp exceeds 18.
#! - a supplied limb is not a valid u32.
#!
#! Invocation: exec
pub proc uint256_to_asset_amount
    # => [U1, U0, scale_exp]

    # guard every externally-supplied limb before any u32 op (u32-assert-before-u32-ops)
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    swapw
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    # => [U0, U1, scale_exp]

    # frozen §8.2 step 2: the high half (wire bytes 0..16) must be zero — a limb
    # byte-swaps to zero iff it is zero, so the raw LE-packed limbs are checked directly
    exec.word::eqz
    assert.err=ERR_X_TOO_LARGE
    # => [U1, scale_exp]

    # steps 1 + 3: byte-swap the low-half limbs to numeric order (limb 4 holds wire
    # bytes 16..20 — the most significant of the low half)
    repeat.4
        exec.swap_u32_bytes movdn.3
    end
    # => [n4, n5, n6, n7, scale_exp]

    # x as u128 little-endian u32 limbs: x = n4*2^96 + n5*2^64 + n6*2^32 + n7
    exec.word::reverse
    # => [x0, x1, x2, x3, scale_exp]

    # step 4 divisor: d = 10^scale_exp as u128 limbs [d0, d1, 0, 0]
    movup.4 exec.pow10
    # => [d, x0, x1, x2, x3]

    u32split
    # => [d0, d1, x0, x1, x2, x3]

    push.0.0 movup.3 movup.3
    # => [d0, d1, 0, 0, x0, x1, x2, x3]

    exec.u128::divmod
    # => [r0, r1, r2, r3, q0, q1, q2, q3]

    # the on-chain output is the floor quotient; the dust remainder is surfaced by the
    # off-chain mirror only (DEV-5 dust policy stays OPEN)
    dropw
    # => [q0, q1, q2, q3]

    # step 5 cap: the quotient must fit a u64 ...
    movup.3 assertz.err=ERR_AMOUNT_OVER_CAP
    movup.2 assertz.err=ERR_AMOUNT_OVER_CAP
    # => [q0, q1]

    # ... and must not exceed the asset amount maximum (compared in u64 limb space —
    # composing first could wrap the felt for quotients in [p, 2^64))
    dup.1 dup.1
    # => [q0, q1, q0, q1]

    push.FUNGIBLE_ASSET_MAX_AMOUNT u32split
    # => [max_lo, max_hi, q0, q1, q0, q1]

    exec.u64::lte
    assert.err=ERR_AMOUNT_OVER_CAP
    # => [q0, q1]

    # compose the AssetAmount felt (y <= 2^63 - 2^31 < p after the cap check)
    swap mul.POW2_32 add
    # => [y]
end

#! Structurally validates a staged DepositIntent preimage and returns the caller-compare fields.
#!
#! Asserts the library-owned structural checks in D5a order over the u32-LE-packed preimage
#! staged in memory: packed magic, packed version, amount nonzero, localToken nonzero,
#! localDepositor nonzero, and the felt-length relation against the embedded hookDataLen.
#! The faucet-owned domain and identifier equality compares are NOT performed here.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - remote_domain is the semantic remoteDomain value as a u32 felt.
#! - REMOTE_TOKEN_1 is the word holding the remoteToken field's upper four packed limbs (bytes 60..76).
#! - REMOTE_TOKEN_0 is the word holding the remoteToken field's lower four packed limbs (bytes 44..60).
#! - hook_data_len is the semantic hookDataLen value as a u32 felt.
#!
#! Panics if:
#! - the packed magic does not match the DepositIntent magic.
#! - the packed version does not match the supported version.
#! - the amount field is zero.
#! - the localToken field is zero.
#! - the localDepositor field is zero.
#! - len_felts does not equal the header felt count plus the packed hookData felt count.
#!
#! Invocation: exec
pub proc parse_deposit_intent
    # => [intent_ptr, len_felts]

    # guard the externally-supplied pointer and length before any u32 op
    u32assert2.err=ERR_FELT_OUT_OF_FIELD
    # => [intent_ptr, len_felts]

    # truncation guard (the byte-level TruncatedHeader analogue): the full 60-felt header
    # must be staged before any field offset can be trusted; both length violations share
    # the frozen ERR_DI_LENGTH constant
    dup.1 u32gte.DEPOSIT_INTENT_HEADER_FELTS
    assert.err=ERR_DI_LENGTH
    # => [intent_ptr, len_felts]

    # D5a step 1: packed magic
    dup push.MAGIC_FELT_OFF add mem_load
    push.DEPOSIT_INTENT_MAGIC_PACKED assert_eq.err=ERR_DI_BAD_MAGIC
    # => [intent_ptr, len_felts]

    # step 2: packed version
    dup push.VERSION_FELT_OFF add mem_load
    push.DEPOSIT_INTENT_VERSION_PACKED assert_eq.err=ERR_DI_BAD_VERSION
    # => [intent_ptr, len_felts]

    # steps 3-4: amount, localToken, localDepositor must be nonzero
    dup push.AMOUNT_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup push.LOCAL_TOKEN_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup push.LOCAL_DEPOSITOR_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    # => [intent_ptr, len_felts]

    # hookDataLen (semantic u32): byte-swap the packed felt at offset 59
    dup push.HOOK_DATA_LEN_FELT_OFF add mem_load
    u32assert.err=ERR_FELT_OUT_OF_FIELD
    exec.swap_u32_bytes
    # => [hook_data_len, intent_ptr, len_felts]

    # step 7: len_felts == 60 + ceil(hookDataLen / 4)
    dup u32mod.4 neq.0
    # => [has_rem, hook_data_len, intent_ptr, len_felts]

    dup.1 u32div.4 add
    # => [ceil_hook_felts, hook_data_len, intent_ptr, len_felts]

    push.DEPOSIT_INTENT_HEADER_FELTS add
    # => [expected_len, hook_data_len, intent_ptr, len_felts]

    movup.3 assert_eq.err=ERR_DI_LENGTH
    # => [hook_data_len, intent_ptr]

    # outputs: load the caller-compare fields from the staged preimage (single-felt loads
    # — the DC-1 felt offsets are not word-aligned, so word loads would trap); the packed
    # remoteToken words are pushed in the same element order the callers compare against
    swap
    # => [intent_ptr, hook_data_len]

    dup push.REMOTE_TOKEN_FELT_OFF add
    # => [rt_base, intent_ptr, hook_data_len]

    # each word is pushed highest-index felt first, so the word reads element-0-on-top —
    # the same orientation the staged words and the callers' compare words use
    dup add.3 mem_load
    # => [f14, rt_base, intent_ptr, hook_data_len]

    dup.1 add.2 mem_load
    dup.2 add.1 mem_load
    dup.3 mem_load
    # => [REMOTE_TOKEN_0, rt_base, intent_ptr, hook_data_len]

    dup.4 add.7 mem_load
    dup.5 add.6 mem_load
    dup.6 add.5 mem_load
    dup.7 add.4 mem_load
    # => [REMOTE_TOKEN_1, REMOTE_TOKEN_0, rt_base, intent_ptr, hook_data_len]

    movup.8 drop
    # => [REMOTE_TOKEN_1, REMOTE_TOKEN_0, intent_ptr, hook_data_len]

    movup.8
    # => [intent_ptr, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]

    # remote_domain (semantic u32): byte-swap the packed felt at offset 10
    push.REMOTE_DOMAIN_FELT_OFF add mem_load
    u32assert.err=ERR_FELT_OUT_OF_FIELD
    exec.swap_u32_bytes
    # => [remote_domain, REMOTE_TOKEN_1, REMOTE_TOKEN_0, hook_data_len]
end

# HELPER PROCEDURES
# =================================================================================================

#! Returns whether any of the eight consecutive felts at the given address is nonzero.
#!
#! Used for the DepositIntent 32-byte-field zero checks (a field is zero iff all eight of
#! its u32-LE-packed limbs are zero).
#!
#! Inputs:  [addr]
#! Outputs: [is_nonzero]
#!
#! Where:
#! - addr is the memory address of the field's first packed felt.
#! - is_nonzero is 1 when any of the eight felts is nonzero, 0 otherwise.
#!
#! Invocation: exec
proc field8_is_nonzero
    push.0 swap
    # => [addr, acc]

    repeat.8
        dup mem_load neq.0
        # => [is_nz, addr, acc]

        movup.2 or
        # => [acc', addr]

        swap add.1
        # => [addr+1, acc']
    end
    # => [addr+8, acc]

    drop
    # => [acc]
end

#! Swaps the byte order of a u32 limb (LE <-> BE numeric order).
#!
#! Local copy modeled on the protocol's `agglayer::common::utils::swap_u32_bytes` at
#! v0.15.3 (the agglayer library is not linked by the standards CodeBuilder). The value
#! must already be a valid u32 (callers guard with u32assertw).
#!
#! Inputs:  [value]
#! Outputs: [swapped]
#!
#! Invocation: exec
proc swap_u32_bytes
    # part0 = (value & 0xFF) << 24
    dup u32and.0xFF u32shl.24
    # => [part0, value]

    # part1 = ((value >> 8) & 0xFF) << 16
    dup.1 u32shr.8 u32and.0xFF u32shl.16 u32or
    # => [part01, value]

    # part2 = ((value >> 16) & 0xFF) << 8
    dup.1 u32shr.16 u32and.0xFF u32shl.8 u32or
    # => [part012, value]

    # part3 = (value >> 24)
    dup.1 u32shr.24 u32or
    # => [swapped, value]

    swap drop
    # => [swapped]
end

#! Computes 10^scale_exp as a felt (10^18 < 2^60 fits comfortably).
#!
#! Modeled on the protocol's `agglayer::common::asset_conversion::pow10` at v0.15.3.
#!
#! Inputs:  [scale_exp]
#! Outputs: [10^scale_exp]
#!
#! Panics if:
#! - scale_exp is not a valid u32.
#! - scale_exp exceeds 18.
#!
#! Invocation: exec
proc pow10
    u32assert.err=ERR_FELT_OUT_OF_FIELD
    # => [scale_exp]

    dup u32lte.SCALE_EXP_MAX
    assert.err=ERR_SCALE_EXP_TOO_LARGE
    # => [scale_exp]

    push.1 swap
    # => [scale_exp, result]

    dup neq.0
    # => [is_not_zero, scale_exp, result]

    while.true
        # => [scale_exp, result]

        swap mul.10 swap
        # => [scale_exp, result*10]

        sub.1
        # => [scale_exp-1, result*10]

        dup neq.0
        # => [is_not_zero, scale_exp-1, result*10]
    end
    # => [0, result]

    drop
    # => [result]
end
