# xreserve::encoding
#
# The canonical shared-encoding procedures. The flat-named proc bodies live in this directory module
# so the `xreserve::encoding::<name>` paths resolve exactly. Wire-layout constants live in the
# `layout` submodule.

use {FUNGIBLE_ASSET_MAX_AMOUNT} from miden::protocol::asset
use miden::standards::assets::asset_amount
use miden::standards::utils
use miden::core::crypto::hashes::poseidon2
use miden::core::math::u128
use miden::core::math::u64
use miden::core::word
use {
    AMOUNT_FELT_OFF, DEPOSIT_INTENT_HEADER_FELTS, DEPOSIT_INTENT_MAGIC_PACKED,
    DEPOSIT_INTENT_VERSION_PACKED, HOOK_DATA_LEN_FELT_OFF, LOCAL_DEPOSITOR_FELT_OFF,
    LOCAL_TOKEN_FELT_OFF, MAGIC_FELT_OFF, REMOTE_DOMAIN_FELT_OFF, REMOTE_TOKEN_FELT_OFF,
    VERSION_FELT_OFF
} from xreserve::encoding::layout

pub mod layout

# ERRORS
# =================================================================================================

const ERR_X_TOO_LARGE = "larger than 2**128"
const ERR_AMOUNT_OVER_CAP = "post-scale quotient exceeds the asset amount maximum"
const ERR_FELT_OUT_OF_FIELD = "supplied limb is not a valid u32"
const ERR_DI_BAD_MAGIC = "deposit intent magic mismatch"
const ERR_DI_BAD_VERSION = "deposit intent version mismatch"
const ERR_DI_ZERO_FIELD = "deposit intent amount, local token, or local depositor is zero"
const ERR_DI_LENGTH = "deposit intent length relation violated"

# PUBLIC INTERFACE
# =================================================================================================

#! Hashes an external bytes32 into its canonical storage-map key Word.
#!
#! Computes the Poseidon2 hash over the 8 u32-LE-packed limbs of the bytes32. The output is the
#! raw storage-map key — the Word the kernel's storage map is keyed by. Hashing rather than
#! reinterpreting is what makes this total: an external bytes32 whose limbs exceed the field
#! modulus still has a key.
#!
#! Inputs:  [B_UPPER, B_LOWER]
#! Outputs: [KEY]
#!
#! Where:
#! - B_UPPER is the word holding the bytes32's positionally upper four u32-LE-packed limbs
#!   (wire bytes 16..32).
#! - B_LOWER is the word holding the bytes32's positionally lower four u32-LE-packed limbs
#!   (wire bytes 0..16).
#! - KEY is the Poseidon2 hash-to-Word storage-map key.
#!
#! Invocation: exec
pub proc bytes32_to_key
    # the hash absorbs B_LOWER (wire bytes 0..16) as the first rate word, so the
    # output is Poseidon2(B_LOWER || B_UPPER) over the 8 packed limbs
    swapw
    # => [B_LOWER, B_UPPER]

    exec.poseidon2::merge
    # => [KEY]
end

#! Reduces an externally-supplied uint256 amount to an AssetAmount felt.
#!
#! Byte-swaps the limbs to numeric order, asserts the numerically high half (U_LOWER, wire
#! bytes 0..16) is zero, takes the numerically low half (U_UPPER) as a u128, floor-divides by
#! 10^scale_exp, and asserts the quotient does not exceed the AssetAmount maximum.
#! Rejects by trapping; never saturates or clamps.
#!
#! Inputs:  [U_UPPER, U_LOWER, scale_exp]
#! Outputs: [y]
#!
#! Where:
#! - U_UPPER is the word holding the uint256's positionally upper four u32-LE-packed limbs
#!   (wire bytes 16..32) — for the big-endian wire value, the numerically LOW half.
#! - U_LOWER is the word holding the uint256's positionally lower four u32-LE-packed limbs
#!   (wire bytes 0..16) — for the big-endian wire value, the numerically HIGH half.
#! - scale_exp is the decimal scale exponent (EVM decimals minus Miden decimals, 0..=18).
#! - y is the reduced amount as a single AssetAmount felt.
#!
#! Panics if:
#! - any limb of the numerically high half (U_LOWER) is nonzero (the value exceeds 2^128).
#! - the post-scale quotient exceeds the AssetAmount maximum.
#! - scale_exp exceeds 18.
#! - a supplied limb is not a valid u32.
#!
#! Invocation: exec
pub proc uint256_to_asset_amount
    # guard every externally-supplied limb before any u32 op
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    swapw
    u32assertw.err=ERR_FELT_OUT_OF_FIELD
    # => [U_LOWER, U_UPPER, scale_exp]

    # the numerically high half (U_LOWER, wire bytes 0..16) must be zero — a limb
    # byte-swaps to zero iff it is zero, so the raw LE-packed limbs are checked directly
    exec.word::eqz
    assert.err=ERR_X_TOO_LARGE
    # => [U_UPPER, scale_exp]

    # byte-swap the numerically-low-half limbs to numeric order (limb 4 holds wire
    # bytes 16..20 — the most significant of that half)
    repeat.4
        exec.utils::swap_u32_bytes movdn.3
    end
    # => [n4, n5, n6, n7, scale_exp]

    # x as u128 little-endian u32 limbs: x = n4*2^96 + n5*2^64 + n6*2^32 + n7
    exec.word::reverse
    # => [x0, x1, x2, x3, scale_exp]

    # divisor: d = 10^scale_exp as u128 limbs [d0, d1, 0, 0]
    movup.4 exec.asset_amount::pow10
    # => [d, x0, x1, x2, x3]

    u32split
    # => [d0, d1, x0, x1, x2, x3]

    push.0.0 movup.3 movup.3
    # => [d0, d1, 0, 0, x0, x1, x2, x3]

    exec.u128::divmod
    # => [r0, r1, r2, r3, q0, q1, q2, q3]

    # the on-chain output is the floor quotient; the dust remainder is surfaced by the
    # off-chain mirror only (the dust policy is OPEN, pending Circle confirmation)
    dropw
    # => [q0, q1, q2, q3]

    # cap: the quotient must fit a u64 ...
    movup.3 assertz.err=ERR_AMOUNT_OVER_CAP
    movup.2 assertz.err=ERR_AMOUNT_OVER_CAP
    # => [q0, q1]

    # ... and must not exceed the asset amount maximum (compared in u64 limb space —
    # composing first could wrap the felt for quotients in [p, 2^64))
    dup.1 dup.1
    # => [q0, q1, q0, q1]

    push.FUNGIBLE_ASSET_MAX_AMOUNT u32split
    # => [max_lo, max_hi, q0, q1, q0, q1]

    exec.u64::lte
    assert.err=ERR_AMOUNT_OVER_CAP
    # => [q0, q1]

    # compose the AssetAmount felt (y <= 2^63 - 2^31 < p after the cap check)
    exec.utils::merge_u32_limbs
    # => [y]
end

#! Validates a staged DepositIntent preimage structurally and returns the caller-compare fields.
#!
#! Asserts the library-owned structural checks over the u32-LE-packed preimage staged in
#! memory: packed magic, packed version, amount nonzero, localToken nonzero, localDepositor
#! nonzero, and the felt-length relation against the embedded hookDataLen. The faucet-owned
#! domain and identifier equality compares are NOT performed here.
#!
#! Inputs:  [intent_ptr, len_felts]
#! Outputs: [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts.
#! - remote_domain is the semantic remoteDomain value as a u32 felt.
#! - REMOTE_TOKEN_UPPER is the word holding the remoteToken field's positionally upper four
#!   packed limbs (intent bytes 60..76).
#! - REMOTE_TOKEN_LOWER is the word holding the remoteToken field's positionally lower four
#!   packed limbs (intent bytes 44..60).
#! - hook_data_len_bytes is the semantic hookDataLen value in bytes, as a u32 felt.
#!
#! Panics if:
#! - the packed magic does not match the DepositIntent magic.
#! - the packed version does not match the supported version.
#! - the amount field is zero.
#! - the localToken field is zero.
#! - the localDepositor field is zero.
#! - len_felts does not equal the header felt count plus the packed hookData felt count.
#!
#! Invocation: exec
pub proc parse_deposit_intent
    # guard the externally-supplied pointer and length before any u32 op
    u32assert2.err=ERR_FELT_OUT_OF_FIELD
    # => [intent_ptr, len_felts]

    # truncation guard: the full 60-felt header must be staged before any field offset can
    # be trusted; both length violations share the ERR_DI_LENGTH constant
    dup.1 u32gte.DEPOSIT_INTENT_HEADER_FELTS
    assert.err=ERR_DI_LENGTH
    # => [intent_ptr, len_felts]

    # packed magic must match
    dup push.MAGIC_FELT_OFF add mem_load
    push.DEPOSIT_INTENT_MAGIC_PACKED assert_eq.err=ERR_DI_BAD_MAGIC
    # => [intent_ptr, len_felts]

    # packed version must match
    dup push.VERSION_FELT_OFF add mem_load
    push.DEPOSIT_INTENT_VERSION_PACKED assert_eq.err=ERR_DI_BAD_VERSION
    # => [intent_ptr, len_felts]

    # amount, localToken, localDepositor must be nonzero
    dup push.AMOUNT_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup push.LOCAL_TOKEN_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    dup push.LOCAL_DEPOSITOR_FELT_OFF add exec.field8_is_nonzero
    assert.err=ERR_DI_ZERO_FIELD
    # => [intent_ptr, len_felts]

    # hookDataLen (semantic u32, a byte count): byte-swap the packed felt at offset 59
    dup push.HOOK_DATA_LEN_FELT_OFF add mem_load u32assert.err=ERR_FELT_OUT_OF_FIELD
    exec.utils::swap_u32_bytes
    # => [hook_data_len_bytes, intent_ptr, len_felts]

    # length relation: the 60-felt header plus the packed hookData felts
    dup exec.num_bytes_to_num_felts push.DEPOSIT_INTENT_HEADER_FELTS add
    # => [expected_len_felts, hook_data_len_bytes, intent_ptr, len_felts]

    movup.3 assert_eq.err=ERR_DI_LENGTH
    # => [hook_data_len_bytes, intent_ptr]

    # outputs: load the caller-compare fields from the staged preimage (single-felt loads
    # — the header felt offsets are not word-aligned); the packed
    # remoteToken words are pushed in the same element order the callers compare against
    swap
    # => [intent_ptr, hook_data_len_bytes]

    dup push.REMOTE_TOKEN_FELT_OFF add
    # => [rt_base, intent_ptr, hook_data_len_bytes]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, intent_ptr, hook_data_len_bytes]

    movup.8
    # => [intent_ptr, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]

    # remote_domain (semantic u32): byte-swap the packed felt at offset 10
    push.REMOTE_DOMAIN_FELT_OFF add mem_load
    u32assert.err=ERR_FELT_OUT_OF_FIELD
    exec.utils::swap_u32_bytes
    # => [remote_domain, REMOTE_TOKEN_UPPER, REMOTE_TOKEN_LOWER, hook_data_len_bytes]
end

#! Returns the number of felts holding num_bytes wire bytes, packed four bytes to a felt.
#!
#! Inputs:  [num_bytes]
#! Outputs: [num_felts]
#!
#! Where:
#! - num_bytes is the wire byte count as a u32 felt.
#! - num_felts is ceil(num_bytes / 4) — one felt per four packed wire bytes.
#!
#! Invocation: exec
pub proc num_bytes_to_num_felts
    u32divmod.4 neq.0 add
end

# HELPER PROCEDURES
# =================================================================================================

#! Returns whether any of the eight consecutive felts at the given address is nonzero.
#!
#! Used for the DepositIntent 32-byte-field zero checks (a field is zero iff all eight of
#! its u32-LE-packed limbs are zero).
#!
#! Inputs:  [addr]
#! Outputs: [is_nonzero]
#!
#! Where:
#! - addr is the memory address of the field's first packed felt.
#! - is_nonzero is 1 when any of the eight felts is nonzero, 0 otherwise.
#!
#! Invocation: exec
proc field8_is_nonzero
    push.0 swap
    # => [addr, acc]

    repeat.8
        dup mem_load neq.0
        # => [is_nz, addr, acc]

        movup.2 or
        # => [acc', addr]

        swap add.1
        # => [addr+1, acc']
    end
    # => [addr+8, acc]

    drop
    # => [acc]
end
