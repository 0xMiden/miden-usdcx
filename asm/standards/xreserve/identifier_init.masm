# xreserve::identifier_init
#
# The owner-gated, init-once IDENTIFIER seeding (R-ADMIN-4, minimized per DEC-4): a one-time write
# of the ONE domain-config field that provably cannot be build-seeded — the faucet identifier. The
# account id derives from the initial storage commitment (account_id/v1: the id is a hash over
# seed + code commitment + storage commitment), and the identifier is (pending Q-CRY-4) the
# faucet's OWN id as bytes32 — a fixpoint, so the slot must start EMPTY and be seeded after the
# id exists. The other three domain-config fields (`domain`, `source_domain`,
# `xreserve_contract`) are BUILD-SEEDED by the Rust account builder and have no runtime writer.
#
# The identifier slot is the one the mint path's D5a compare
# (deposit_intent_parser::assert_deposit_intent) reads to reject mis-addressed deposits; it stores
# the Poseidon2 bytes32->key WORD (consumer-forced — D5a's `assert_eqw` compares the hashed
# form). A second write traps ERR_XRESERVE_IDENTIFIER_REINIT. Owner-gated (Ownable2Step); no
# pause gate (deploy-time config is orthogonal to the operational pause). The slot const is
# IMPORTED from deposit_intent_parser (the single source of truth with D5a).
#
# Round-3 hardening: the proc derives the faucet's OWN identifier key ON-CHAIN —
# `bytes32_to_key(account_id_to_bytes32(native_account::get_id))`, the DEC-4 own-id fixpoint —
# and requires the note-committed IDENTIFIER to EQUAL it, so a front-run init on a fresh keyless
# faucet cannot seed a foreign identity (the deploy-time griefing vector). This ENFORCES the
# provisional DEV-10/Q-CRY-4 position (identifier = the faucet's own id as bytes32) that the
# off-chain flows already assume; both stay Circle-OPEN.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::access::ownable2step
use xreserve::encoding
use {IDENTIFIER_CONFIG_SLOT} from xreserve::deposit_intent_parser

# ERRORS
# =================================================================================================

# R-ADMIN-4: the identifier is init-once; a second write traps. The init-once sentinel is the
# identifier slot itself — a Poseidon2 bytes32->key hash, non-empty by construction once set.
const ERR_XRESERVE_IDENTIFIER_REINIT = "identifier has already been initialized"

# R-ADMIN-4 hardening: an EMPTY input identifier would never arm the init-once sentinel (the
# "immutable" identifier would stay silently re-initializable) and D5a would compare every
# intent's identifier against EMPTY. Trap rather than deploy that state.
const ERR_XRESERVE_IDENTIFIER_EMPTY = "identifier must be non-empty"

# Round-3 own-id binding: the note-committed identifier must EQUAL the on-chain-derived
# `bytes32_to_key(account_id_to_bytes32(get_id()))` — a divergent value is a mis-addressed or
# front-run init note and must never seed the identity slot.
const ERR_XRESERVE_IDENTIFIER_MISMATCH = "identifier does not match the faucet's own account id key"

# PUBLIC INTERFACE
# =================================================================================================

#! Writes the faucet identifier config slot, owner-gated, init-once, and BOUND to the faucet's
#! own account id: the ONE domain-config field the account-id fixpoint forces past build time
#! (DEC-4). Gated on the Ownable2Step owner — NOT an operational role — because the identifier
#! is deploy-time identity. Init-once (R-ADMIN-4): a second call finds the slot non-empty and
#! traps; a trapped tx commits nothing. The written value is NOT trusted verbatim (round-3
#! hardening): the proc derives `bytes32_to_key(account_id_to_bytes32(get_id()))` on-chain and
#! requires the note-committed IDENTIFIER to equal it — the slot can only ever hold the faucet's
#! own-id fixpoint key, the exact Word D5a compares deposit intents against.
#!
#! Inputs:  [IDENTIFIER, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - IDENTIFIER is the faucet identifier as the canonical bytes32->key Word; must equal the
#!   on-chain-derived own-id key (asserted, then stored; D5a asserts word equality against it).
#!
#! Panics if:
#! - the note sender is not the Ownable2Step owner (ownable2step::assert_sender_is_owner,
#!   ERR_SENDER_NOT_OWNER).
#! - the identifier was already initialized — the slot is non-empty
#!   (ERR_XRESERVE_IDENTIFIER_REINIT, R-ADMIN-4).
#! - the input IDENTIFIER is the empty word — it could never arm the init-once sentinel
#!   (ERR_XRESERVE_IDENTIFIER_EMPTY).
#! - the input IDENTIFIER is not the faucet's own-id key
#!   (ERR_XRESERVE_IDENTIFIER_MISMATCH, the round-3 anti-front-run binding).
#!
#! Invocation: call
@account_procedure
pub proc init_identifier
    # => [IDENTIFIER, pad(12)]

    # gate: owner-only. Identifier binding is deploy-time identity, off the operational roles.
    exec.ownable2step::assert_sender_is_owner
    # => [IDENTIFIER, pad(12)]

    # init-once (R-ADMIN-4): the identifier slot must be EMPTY. assert_eqw against EMPTY_WORD
    # passes only when uninitialized; a second write finds the stored hash word and traps.
    push.IDENTIFIER_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [STORED_IDENTIFIER, IDENTIFIER, pad(12)]

    padw assert_eqw.err=ERR_XRESERVE_IDENTIFIER_REINIT
    # => [IDENTIFIER, pad(12)]

    # hardening (R-ADMIN-4): the input IDENTIFIER must be non-empty — an EMPTY identifier would
    # never arm the sentinel above. Non-destructive compare: eqw pushes the flag WITHOUT
    # consuming the words, so IDENTIFIER reaches its verbatim write (and D5a's read) untouched.
    padw
    # => [EMPTY, IDENTIFIER, pad(12)]

    eqw
    # => [is_empty, EMPTY, IDENTIFIER, pad(12)]

    assertz.err=ERR_XRESERVE_IDENTIFIER_EMPTY
    # => [EMPTY, IDENTIFIER, pad(12)]

    dropw
    # => [IDENTIFIER, pad(12)]

    # own-id binding (round-3 hardening): derive the faucet's OWN identifier key on-chain and
    # require the note-committed word to EQUAL it — a front-run init cannot seed a foreign
    # identity. Compare over a copy (dupw.1) so the verified IDENTIFIER reaches its write intact.
    exec.compute_own_identifier_key
    # => [OWN_KEY, IDENTIFIER, pad(12)]

    dupw.1
    # => [IDENTIFIER, OWN_KEY, IDENTIFIER, pad(12)]

    assert_eqw.err=ERR_XRESERVE_IDENTIFIER_MISMATCH
    # => [IDENTIFIER, pad(12)]

    # identifier_config := IDENTIFIER (the own-id-verified Word D5a's assert_eqw reads).
    push.IDENTIFIER_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [pad(12)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Derives the faucet's OWN identifier storage key on-chain: the Poseidon2 bytes32->key hash of
#! the account-id-in-bytes32 packaging (the R-B layout — 16 zero pad bytes, then the id prefix as
#! a u64 big-endian, then the id suffix as a u64 big-endian) of `native_account::get_id` — the
#! DEC-4 own-id fixpoint, byte-identical to the Rust
#! `XReserveIdentifierInitNote::identifier_for(faucet_id)` derivation (proven by the production
#! create-to-consume execution tests).
#!
#! Each id felt splits into its big-endian u32 halves (`u32split`), and each half byte-swaps into
#! the u32-LE-packed limb form `bytes32_to_key` consumes (limbs 4..8 = the id bytes 16..32; limbs
#! 0..4 = the zero pad).
#!
#! Inputs:  []
#! Outputs: [KEY]
#!
#! Where:
#! - KEY is the Poseidon2 bytes32->key Word of the native account id's bytes32 packaging.
#!
#! Invocation: exec
proc compute_own_identifier_key
    exec.native_account::get_id
    # => [id_suffix, id_prefix]

    # suffix -> limbs 6/7 (bytes 24..32): split into BE u32 halves, byte-swap each to LE-packed
    u32split
    # => [suffix_lo, suffix_hi, id_prefix]

    exec.swap_u32_bytes
    # => [limb7, suffix_hi, id_prefix]

    swap exec.swap_u32_bytes
    # => [limb6, limb7, id_prefix]

    # prefix -> limbs 4/5 (bytes 16..24)
    movup.2 u32split
    # => [prefix_lo, prefix_hi, limb6, limb7]

    exec.swap_u32_bytes
    # => [limb5, prefix_hi, limb6, limb7]

    swap exec.swap_u32_bytes
    # => [B1] = [limb4, limb5, limb6, limb7]

    # push the 16-byte zero pad as B0 (limbs 0..4); bytes32_to_key consumes [B1, B0]
    padw swapw
    # => [B1, B0]

    exec.encoding::bytes32_to_key
    # => [KEY]
end

#! Reverses the byte order of a u32 (little-endian <-> big-endian). A generic u32 primitive (not
#! encoding-library domain logic); reimplemented locally because the encoding library's
#! `swap_u32_bytes` is a private `proc` (not exported) — the same recorded deviation as
#! `mint_policy.masm`. The caller feeds `u32split` halves, which are valid u32s by construction.
#!
#! Inputs:  [value]
#! Outputs: [swapped]
#!
#! Where:
#! - value is a u32; swapped is value with its four bytes reversed.
#!
#! Invocation: exec
proc swap_u32_bytes
    dup u32and.0xff u32shl.24
    # => [part0, value]

    dup.1 u32shr.8 u32and.0xff u32shl.16 u32or
    # => [part01, value]

    dup.1 u32shr.16 u32and.0xff u32shl.8 u32or
    # => [part012, value]

    dup.1 u32shr.24 u32or
    # => [swapped, value]

    swap drop
    # => [swapped]
end
