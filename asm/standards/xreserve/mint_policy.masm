# xreserve::mint_policy
#
# The faucet's only supply-increasing gate. `check_policy` is registered as the account's ACTIVE
# mint policy, so the stock `mint_and_send` dispatches it on every mint; its contract is documented
# on the proc itself.
#
# Two properties are worth stating here because neither is local to any one step. Fail-closed: any
# trap aborts the whole transaction with NO writes, so a failed mint never burns its nonce. And
# reaching this policy outside note processing — a tx-script `mint_and_send`, say — traps in the
# kernel's active-note accessors, so there is no mint path that skips the attested transport.

use miden::protocol::account_id
use miden::protocol::active_note
use miden::protocol::native_account
use miden::protocol::note
use {NOTE_TYPE_PUBLIC} from miden::protocol::note
use {NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME} from miden::standards::attachments::network_account_target
use miden::standards::interop::eth
use miden::standards::note_tag
use miden::standards::utils
use miden::core::sys
use xreserve::attestation_verify
use xreserve::deposit_intent_parser
use {USED_NONCES_SLOT} from xreserve::deposit_intent_parser
use xreserve::encoding
use {
    AMOUNT_FELT_OFF, DEPOSIT_INTENT_HEADER_FELTS, HOOK_DATA_LEN_FELT_OFF, NONCE_FELT_OFF,
    REMOTE_RECIPIENT_FELT_OFF
} from xreserve::encoding::layout

# CONSTANTS
# =================================================================================================

# The mint-note DepositIntent attachment scheme (>= 4 — clear of the reserved "none"
# value 1 and the standard values 2 `NetworkAccountTarget` / 3 `Pswap`).
const XUSDC_MINT_INTENT_ATTACHMENT_SCHEME = 4

# The mint-note attestation attachment scheme (see the intent scheme above).
const XUSDC_MINT_ATTESTATION_ATTACHMENT_SCHEME = 5

# The attestation attachment word count: [feeAmount(8), pubkey(16), signature(17), pad(3)]
# = 44 felts = 11 words (the pubkey is the 16-felt affine form).
const XUSDC_MINT_ATTESTATION_NUM_WORDS = 11

# The 60-felt DepositIntent header packed into words (60 / 4): the attachment word-count floor
# below which no field offset can be trusted.
const DEPOSIT_INTENT_HEADER_WORDS = 15

# The uint256->AssetAmount decimal scale (`y = floor(x / 10^scale_exp)`), FAUCET-side by design: a
# note-carried scale would let the producer diverge the minted amount from the attested amount. The
# amount cap / scale / dust tolerance are OPEN, pending Circle confirmation; the faucet ships the
# PROVISIONAL scale-0 position because Circle's on-wire deposit `amount` is denominated in 6-decimal
# smallest units and xUSDC is likewise 6-decimal, so the two denominations coincide and no rescale
# applies — scale 0, `y = floor(x / 10^0) = x`, an identity with no floored dust. (`0` is inside the
# reducer's `[0, 18]` scale bound.) Changing this constant is how the faucet would be
# repointed at a wire denomination whose asset is scaled differently.
const DEPOSIT_SCALE_EXP = 0

# Number of P2ID note-storage items ([target_id_suffix, target_id_prefix]; p2id.masm storage fmt).
const P2ID_NUM_STORAGE_ITEMS = 2

# The non-empty Word written into usedNonces[KEY] (the replay guard asserts EMPTY_WORD, so any non-empty marker
# flips it). Whether the marker should carry more than a plain flag is OPEN, pending Circle confirmation.
const NONCE_USED_MARKER = [1, 0, 0, 0]

# The canonical P2ID note script root, consumed by the expected-RECIPIENT recipe so the attested
# output note is identifiable as P2ID.
const P2ID_SCRIPT_ROOT = [7131697192369665042, 13614976149584716721, 15020972229364874097, 1084006998777425639]

# `check_policy` locals: the parked note-supplied interface, the verify scratch, and the staged
# DepositIntent preimage. Every sub-region that a word instruction touches is word-aligned; the
# gaps between them are the alignment padding.
const ASSET_VALUE_LOC = 0
const RECIPIENT_LOC = 4
const TAG_LOC = 8
const NOTE_TYPE_LOC = 9
const ATTACHMENT_COMMITMENTS_LOC = 12

# The hash-verified attestation content and its three sub-regions, in attachment order.
const ATTESTATION_LOC = 28
const ATTESTATION_FEE_AMOUNT_LOC = ATTESTATION_LOC
const ATTESTATION_PUBKEY_LOC = ATTESTATION_LOC + 8
const ATTESTATION_SIGNATURE_LOC = ATTESTATION_LOC + 24

const NONCE_KEY_LOC = 72

# The P2ID note-storage region, in the [target_id_suffix, target_id_prefix] order p2id.masm reads.
const P2ID_TARGET_ID_SUFFIX_LOC = 76
const P2ID_TARGET_ID_PREFIX_LOC = 77

const HOOK_DATA_LEN_LOC = 80
const LEN_FELTS_LOC = 81
const ATTESTED_AMOUNT_LOC = 82

# The staged DepositIntent preimage, plus the fields `check_policy` itself reads out of it (the
# parser reads the remaining fields off the base pointer). The region is sized to the protocol's
# per-attachment ceiling, so every intent that can reach the policy fits.
const INTENT_LOC = 84
const INTENT_AMOUNT_LOC = INTENT_LOC + AMOUNT_FELT_OFF
const INTENT_REMOTE_RECIPIENT_LOC = INTENT_LOC + REMOTE_RECIPIENT_FELT_OFF
const INTENT_NONCE_LOC = INTENT_LOC + NONCE_FELT_OFF
const INTENT_HOOK_DATA_LEN_LOC = INTENT_LOC + HOOK_DATA_LEN_FELT_OFF

# ERRORS
# =================================================================================================

# The scheme-4 DepositIntent attachment must be present on the mint note.
const ERR_XRESERVE_MINT_NOTE_INTENT_MISSING = "mint note deposit intent attachment is missing"

# The scheme-5 attestation attachment (fee + candidate pubkey + signature) must be present.
const ERR_XRESERVE_MINT_NOTE_ATTESTATION_MISSING = "mint note attestation attachment is missing"

# The scheme-2 NetworkAccountTarget routing attachment (routing-only — never read for effects)
# must be present alongside the intent and the attestation.
const ERR_XRESERVE_MINT_NOTE_TARGET_MISSING = "mint note routing target attachment is missing"

# Exactly THREE attachments: the scheme-4 intent + the scheme-5 attestation + the scheme-2
# routing target (with all three schemes found, count three means one of each).
const ERR_XRESERVE_MINT_NOTE_ATTACHMENT_COUNT = "mint note must carry exactly three attachments"

# The intent attachment must cover at least the 60-felt DepositIntent header (content is the
# parser's job; this is the transport-shape floor on the hash-committed word count).
const ERR_XRESERVE_MINT_NOTE_INTENT_TOO_SHORT = "mint note deposit intent attachment is shorter than the deposit intent header"

# The staged hookDataLen limb must be a valid u32 before the length derivation byte-swaps it.
const ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB = "mint note deposit intent hook data length limb is not a valid u32"

# The intent attachment's hash-committed word count must equal the word count the embedded
# hookDataLen implies (the transport-side length binding; the parser re-validates the felt-level
# relation over the same values).
const ERR_XRESERVE_MINT_NOTE_INTENT_WORDS = "mint note deposit intent attachment word count does not match the intent length"

# The verified attestation attachment must be exactly 11 words
# ([feeAmount(8), pubkey(16), signature(17), pad(3)]).
const ERR_XRESERVE_MINT_NOTE_ATTESTATION_NUM_WORDS = "mint note attestation attachment word count is invalid"

# The ASSERT-MATCH binding: the note-supplied output-note RECIPIENT must equal the P2ID recipe
# derived from the attested intent (target = remoteRecipient, serial = the nonce key).
const ERR_XRESERVE_MINT_RECIPIENT_MISMATCH = "mint note recipient does not match the attested deposit intent"

# The ASSERT-MATCH binding: the note-supplied ASSET_VALUE must be [attested_amount, 0, 0, 0].
const ERR_XRESERVE_MINT_AMOUNT_MISMATCH = "mint note asset amount does not match the attested deposit intent"

# The ASSERT-MATCH binding: the note-supplied output-note tag must be the attested recipient's
# account target.
const ERR_XRESERVE_MINT_TAG_MISMATCH = "mint note tag does not match the attested recipient target"

# The ASSERT-MATCH binding: the attested output note is always public.
const ERR_XRESERVE_MINT_NOTE_TYPE_NOT_PUBLIC = "mint note output note type must be public"

# Recipient AccountId extraction (extract_recipient_account_id): the pad check of the right-aligned
# AccountId-in-bytes32 layout (the packaging is OPEN, pending Circle confirmation). The limb and
# canonical-range rejects surface the standards eth::build_felt error constants, and the
# suffix-shape and zero-version rejects surface the protocol account_id::validate_structure
# ERR_ACCOUNT_ID_* constants directly.
const ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE = "deposit intent remote recipient address pad is not zero"

# PUBLIC INTERFACE
# =================================================================================================

#! Gates every stock `mint_and_send` on the full attestation pipeline and the ASSERT-MATCH
#! binding — the attestation mint policy predicate. Registered as the ACTIVE mint policy of the
#! faucet's TokenPolicyManager and invoked by `policy_manager::execute_mint_policy` via `dynexec`
#! on every MINT-note consumption (the dispatcher's pause gate runs BEFORE this policy, so a
#! paused faucet never dispatches it).
#!
#! It hash-verifies the note's three attachments, runs the verify stages over the attested intent,
#! then requires every value the note supplies to EQUAL the value derived from the attestation:
#! the policy never overrides a note, it only refuses one that disagrees. On accept it marks the
#! nonce used — its only state write — and returns its inputs unchanged.
#!
#! Inputs:  [ASSET_VALUE, tag, note_type, RECIPIENT]
#! Outputs: [ASSET_VALUE, tag, note_type, RECIPIENT]
#!
#! Where:
#! - ASSET_VALUE is the note-supplied fungible asset value word [amount, 0, 0, 0]; asserted equal
#!   to the attested reduced amount and returned unchanged.
#! - tag is the note-supplied output-note tag; asserted equal to the attested recipient's account
#!   target and returned unchanged.
#! - note_type is the note-supplied output-note type; asserted public and returned unchanged.
#! - RECIPIENT is the note-supplied output-note recipient digest; asserted equal to the P2ID
#!   recipe derived from the attested intent and returned unchanged.
#!
#! Panics if:
#! - the procedure is not dispatched during note processing (active_note::* will fail).
#! - an attachment is missing, doubled, or extra (the three finds + the count-three assert).
#! - the intent attachment is shorter than the header, its hookDataLen limb is not a valid u32,
#!   or its committed word count does not match the embedded length claim.
#! - the attestation attachment is not exactly 11 words.
#! - an attachment's advice-map content does not hash to its note-committed commitment (the
#!   pipe_preimage_to_memory assert inside write_attachment_to_memory).
#! - any consumed verify stage rejects (structural/domain/identifier, amount/fee with
#!   feeAmount != 0, nonce replay, attester allowlist/signature).
#! - the recipient extraction rejects the attested remoteRecipient (pad/limb/canonicity or
#!   account_id::validate_structure).
#! - a note-supplied value diverges from its attested derivation (the ASSERT-MATCH errors).
#!
#! Locals:
#! - 0..4: ASSET_VALUE
#! - 4..8: RECIPIENT
#! - 8: note tag
#! - 9: note_type
#! - 12..28: attachment commitments list (4 words)
#! - 28..72: attestation content
#!     - 28..36: feeAmount(8)
#!     - 36..52: pubkey(16)
#!     - 52..72: signature(17) + pad(3)
#! - 72..76: nonce KEY (usedNonces storage-map key == the attested output-note serial)
#! - 76..80: P2ID note-storage region [target_id_suffix, target_id_prefix]
#! - 80: hook_data_len
#! - 81: len_felts
#! - 82: reduced attested amount
#! - 84..1108: the hash-verified DepositIntent preimage (MAX_ATTACHMENT_WORDS * 4 felts)
#!
#! Invocation: dynexec
@locals(1108)
@account_procedure
pub proc check_policy
    # cache the parameters for returning
    loc_storew_le.ASSET_VALUE_LOC dropw
    # => [tag, note_type, RECIPIENT]

    loc_store.TAG_LOC loc_store.NOTE_TYPE_LOC
    # => [RECIPIENT]

    loc_storew_le.RECIPIENT_LOC dropw
    # => []

    # ---- TRANSPORT: locate the three attachments; keep the found indices for the binding reads ----

    push.XUSDC_MINT_INTENT_ATTACHMENT_SCHEME exec.active_note::find_attachment
    # => [is_found, intent_idx]

    assert.err=ERR_XRESERVE_MINT_NOTE_INTENT_MISSING
    # => [intent_idx]

    push.XUSDC_MINT_ATTESTATION_ATTACHMENT_SCHEME exec.active_note::find_attachment
    # => [is_found, attestation_idx, intent_idx]

    assert.err=ERR_XRESERVE_MINT_NOTE_ATTESTATION_MISSING
    # => [attestation_idx, intent_idx]

    push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME exec.active_note::find_attachment
    # => [is_found, target_idx, attestation_idx, intent_idx]

    assert.err=ERR_XRESERVE_MINT_NOTE_TARGET_MISSING
    drop
    # => [attestation_idx, intent_idx]

    # exactly three attachments total; with all three schemes found this is one of each (a
    # doubled scheme fails another scheme's find), so no per-scheme count is needed
    locaddr.ATTACHMENT_COMMITMENTS_LOC exec.active_note::write_attachment_commitments_to_memory
    # => [num_attachments, attestation_idx, intent_idx]

    eq.3 assert.err=ERR_XRESERVE_MINT_NOTE_ATTACHMENT_COUNT
    # => [attestation_idx, intent_idx]

    # ---- the intent attachment: hash-verify into the policy's own locals, bind the committed length ----

    # the intent region holds MAX_ATTACHMENT_WORDS words, the ceiling the kernel enforces when a
    # note is created, so it fits every intent that can reach here. a preimage claiming more words
    # than that fails the commitment check inside write_attachment_to_memory and aborts the tx.
    swap locaddr.INTENT_LOC exec.active_note::write_attachment_to_memory
    # => [num_words, attestation_idx]

    # transport-shape floor: at least the 60-felt header (content is the parser's job)
    dup u32assert.err=ERR_XRESERVE_MINT_NOTE_INTENT_TOO_SHORT
    u32gte.DEPOSIT_INTENT_HEADER_WORDS assert.err=ERR_XRESERVE_MINT_NOTE_INTENT_TOO_SHORT
    # => [num_words, attestation_idx]

    # derive the exact felt length from the embedded hookDataLen (u32-LE packed; hash-committed
    # content, so u32-guard before the byte-swap)
    locaddr.INTENT_HOOK_DATA_LEN_LOC mem_load
    # => [hook_len_packed, num_words, attestation_idx]

    u32assert.err=ERR_XRESERVE_MINT_NOTE_HOOK_LEN_LIMB
    exec.utils::swap_u32_bytes
    # => [hook_data_len, num_words, attestation_idx]

    # len_felts = 60 + ceil(hook_data_len / 4), the parser's own length relation
    dup u32mod.4 neq.0
    # => [has_rem, hook_data_len, num_words, attestation_idx]

    dup.1 u32div.4 add
    # => [ceil_hook_felts, hook_data_len, num_words, attestation_idx]

    push.DEPOSIT_INTENT_HEADER_FELTS add
    # => [len_felts, hook_data_len, num_words, attestation_idx]

    loc_store.LEN_FELTS_LOC drop
    # => [num_words, attestation_idx]

    # bind the hash-committed word count to the embedded claim: num_words == ceil(len_felts / 4)
    loc_load.LEN_FELTS_LOC dup u32mod.4 neq.0
    # => [has_rem, len_felts, num_words, attestation_idx]

    dup.1 u32div.4 add
    # => [expected_num_words, len_felts, num_words, attestation_idx]

    swap drop
    # => [expected_num_words, num_words, attestation_idx]

    assert_eq.err=ERR_XRESERVE_MINT_NOTE_INTENT_WORDS
    # => [attestation_idx]

    # ---- the attestation attachment: hash-verify by its index + 11-word check ----

    # every stage below reads the fee, the pubkey and the signature out of THIS region. nothing is
    # re-read from the advice provider, so what the note committed to is exactly what gets verified.
    locaddr.ATTESTATION_LOC exec.active_note::write_attachment_to_memory
    # => [num_words]

    eq.XUSDC_MINT_ATTESTATION_NUM_WORDS assert.err=ERR_XRESERVE_MINT_NOTE_ATTESTATION_NUM_WORDS
    # => []

    # ---- VERIFY (verify once); any trap aborts the whole tx -> no writes ----

    # deposit-intent preconditions: structural parse + domain/identifier compares; the returned
    # hook_data_len (the same embedded field the derivation above read) feeds the keccak extent
    loc_load.LEN_FELTS_LOC locaddr.INTENT_LOC
    # => [intent_ptr, len_felts]

    exec.deposit_intent_parser::assert_deposit_intent
    loc_store.HOOK_DATA_LEN_LOC
    # => []

    # amount/maxFee/feeAmount reduction + bounds (feeAmount must be zero)
    push.DEPOSIT_SCALE_EXP locaddr.ATTESTATION_FEE_AMOUNT_LOC locaddr.INTENT_LOC
    # => [intent_ptr, fee_amount_ptr, scale_exp]

    exec.deposit_intent_parser::assert_mint_amounts
    # => []

    # nonce replay guard (assert-zero only; the SET is the accept-path write below)
    locaddr.INTENT_LOC
    exec.deposit_intent_parser::assert_nonce_unused
    # => []

    # attestation verify: keccak the 240 + hook_data_len payload, allowlist gate + ECDSA verify
    locaddr.ATTESTATION_SIGNATURE_LOC locaddr.ATTESTATION_PUBKEY_LOC
    # => [pubkey_ptr, signature_ptr]

    loc_load.HOOK_DATA_LEN_LOC push.DEPOSIT_INTENT_HEADER_FELTS mul.4 add
    # => [intent_num_bytes, pubkey_ptr, signature_ptr]

    locaddr.INTENT_LOC
    # => [intent_ptr, intent_num_bytes, pubkey_ptr, signature_ptr]

    exec.attestation_verify::verify_attestation
    # => []

    # ---- ASSERT-MATCH: derive the attested values and compare the parked note-supplied ones ----

    # the KEY = bytes32_to_key(nonce) — the usedNonces key AND the attested output-note serial
    locaddr.INTENT_NONCE_LOC
    exec.utils::mem_load_double_word_unaligned swapw
    exec.encoding::bytes32_to_key
    loc_storew_le.NONCE_KEY_LOC dropw
    # => []

    # the attested recipient AccountId from remoteRecipient
    locaddr.INTENT_REMOTE_RECIPIENT_LOC
    exec.extract_recipient_account_id
    # => [recipient_id_suffix, recipient_id_prefix]

    loc_store.P2ID_TARGET_ID_SUFFIX_LOC loc_store.P2ID_TARGET_ID_PREFIX_LOC
    # => []

    # the attested amount = reduce(amount field, scale 0)
    push.DEPOSIT_SCALE_EXP locaddr.INTENT_AMOUNT_LOC
    # => [amount_base, scale_exp]

    exec.utils::mem_load_double_word_unaligned swapw
    # => [U_UPPER, U_LOWER, scale_exp]

    exec.encoding::uint256_to_asset_amount
    loc_store.ATTESTED_AMOUNT_LOC
    # => []

    # the RECIPIENT binding: the expected recipe = hash(hash(hash(KEY, EMPTY), P2ID_ROOT), storage)
    # over the attested target — the full recipe compare covers script root + storage target +
    # serial policy at once
    push.P2ID_SCRIPT_ROOT
    # => [P2ID_SCRIPT_ROOT]

    padw loc_loadw_le.NONCE_KEY_LOC
    # => [KEY, P2ID_SCRIPT_ROOT]

    push.P2ID_NUM_STORAGE_ITEMS locaddr.P2ID_TARGET_ID_SUFFIX_LOC
    # => [storage_ptr, num_storage_items, KEY, P2ID_SCRIPT_ROOT]

    exec.note::compute_and_store_recipient
    # => [EXPECTED_RECIPIENT]

    padw loc_loadw_le.RECIPIENT_LOC
    # => [NOTE_RECIPIENT, EXPECTED_RECIPIENT]

    assert_eqw.err=ERR_XRESERVE_MINT_RECIPIENT_MISMATCH
    # => []

    # the ASSET_VALUE binding: element 0 equals the attested amount, elements 1..3 are zero
    padw loc_loadw_le.ASSET_VALUE_LOC
    # => [NOTE_ASSET_VALUE]

    loc_load.ATTESTED_AMOUNT_LOC assert_eq.err=ERR_XRESERVE_MINT_AMOUNT_MISMATCH
    # => [value_1, value_2, value_3]

    assertz.err=ERR_XRESERVE_MINT_AMOUNT_MISMATCH
    assertz.err=ERR_XRESERVE_MINT_AMOUNT_MISMATCH
    assertz.err=ERR_XRESERVE_MINT_AMOUNT_MISMATCH
    # => []

    # tag binding: the attested recipient's account target (the standards tag helper)
    loc_load.P2ID_TARGET_ID_PREFIX_LOC
    exec.note_tag::create_account_target
    # => [expected_tag]

    loc_load.TAG_LOC assert_eq.err=ERR_XRESERVE_MINT_TAG_MISMATCH
    # => []

    # note_type binding: the attested output note is always public
    loc_load.NOTE_TYPE_LOC eq.NOTE_TYPE_PUBLIC assert.err=ERR_XRESERVE_MINT_NOTE_TYPE_NOT_PUBLIC
    # => []

    # ---- ACCEPT: mark the nonce used (the policy's ONLY state write) ----

    push.NONCE_USED_MARKER
    # => [MARKER]

    padw loc_loadw_le.NONCE_KEY_LOC
    # => [KEY, MARKER]

    push.USED_NONCES_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, KEY, MARKER]

    exec.native_account::set_map_item dropw
    # => []

    # ---- return the (asserted-matching) policy interface unchanged ----

    padw loc_loadw_le.RECIPIENT_LOC
    # => [RECIPIENT]

    loc_load.NOTE_TYPE_LOC loc_load.TAG_LOC
    # => [tag, note_type, RECIPIENT]

    padw loc_loadw_le.ASSET_VALUE_LOC
    # => [ASSET_VALUE, tag, note_type, RECIPIENT]

    # the verify pipeline's deep scratch phases pull disposable zeros from below the operand stack's
    # 16-element floor, so the restored interface would otherwise ride above a full floor of junk
    # instead of the dispatcher's original padding. Truncate to exactly 16 — the top 10 interface
    # elements plus 6 pad — so the policy returns at the SAME depth it was dispatched at.
    exec.sys::truncate_stack
    # => [ASSET_VALUE, tag, note_type, RECIPIENT]
end

# HELPER PROCEDURES
# =================================================================================================

#! Extracts and validates the P2ID recipient's account ID felts from the deposit intent's
#! `remoteRecipient`.
#!
#! Reads the eight u32-LE-packed `remoteRecipient` limbs, asserts the 16-byte leading pad is zero,
#! and rebuilds the account ID prefix and suffix through the standards no-reduction
#! `eth::build_felt`.
#!
#! Inputs:  [remote_recipient_ptr]
#! Outputs: [recipient_id_suffix, recipient_id_prefix]
#!
#! Where:
#! - remote_recipient_ptr is the memory address of the remoteRecipient field's first packed limb.
#! - recipient_id_{suffix,prefix} are the two validated Miden AccountId felts, in the stack order
#!   the P2ID storage region consumes ([suffix, prefix]; Rust `account_id_to_felts` is
#!   [prefix, suffix]).
#!
#! Panics if:
#! - the remoteRecipient 16-byte leading pad is non-zero (ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE).
#! - a staged remoteRecipient limb is not a valid u32 (the standards eth::build_felt u32 guard).
#! - a rebuilt prefix/suffix u64 reduced mod the field (the standards merge overflow guard).
#! - account_id::validate_structure rejects the felts (its ERR_ACCOUNT_ID_* constants).
#!
#! Invocation: exec
proc extract_recipient_account_id
    # ---- leading pad: the 16-byte pad (limbs ptr+0..3) of the AccountId-in-bytes32 layout must be exactly zero ----
    dup mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.1 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.2 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.3 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    # => [remote_recipient_ptr]

    # ---- prefix = build_felt(lo = limb ptr+5, hi = limb ptr+4)  (bytes[16..24], big-endian) ----
    dup add.4 mem_load
    # => [prefix_hi, remote_recipient_ptr]

    dup.1 add.5 mem_load
    # => [prefix_lo, prefix_hi, remote_recipient_ptr]

    exec.eth::build_felt
    # => [prefix, remote_recipient_ptr]

    # ---- suffix = build_felt(lo = limb ptr+7, hi = limb ptr+6)  (bytes[24..32], big-endian) ----
    dup.1 add.6 mem_load
    # => [suffix_hi, prefix, remote_recipient_ptr]

    movup.2 add.7 mem_load
    # => [suffix_lo, suffix_hi, prefix]

    exec.eth::build_felt
    # => [suffix, prefix]

    # ---- structural AccountId validation ----
    dup.1 dup.1
    # => [suffix, prefix, suffix, prefix]

    # the ID version does not need asserting, so structural validation is sufficient
    exec.account_id::validate_structure
    # => [suffix, prefix]
end
