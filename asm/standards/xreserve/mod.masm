# xreserve
#
# The namespace root of the hand-written xUSDC faucet library. The assembler includes only
# modules declared via `mod`/`pub mod` in an artifact, so this root module declares the
# library tree: the faucet component modules, the shared-encoding library (`encoding`,
# with its `layout` constants submodule declared in `encoding/mod.masm`), the attestation
# mint policy (the ACTIVE mint policy the stock `mint_and_send` dispatches), and the
# identifier-init surface. It carries no procedures of its own — the callable surface lives in
# the submodules.

pub mod attestation_verify
pub mod attester_admin
pub mod deposit_intent_parser
pub mod encoding
pub mod identifier_init
pub mod mint_policy
