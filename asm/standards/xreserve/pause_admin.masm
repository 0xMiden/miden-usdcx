# xreserve::pause_admin
#
# FAUCET(01)-owned emergency pause admin (P5-01 CMP-F3, §5.12 / CIR-ADMIN-3/4/5, per
# DECISION-ADMIN-ROLE-MODEL): the DOM_PAUSER-gated custom pause/unpause — under Option 1
# (Domain-Pauser-ONLY, CIRCLE-SPECIFICATION.md:121; IMPL-DEV-1 remediation) the ONLY pause surface on
# the faucet. The stock PausableManager gates pause on the account-wide Authority (= owner), which both
# fails Circle's distinct-pauser-role model AND gives the owner a direct pause path — so it is NOT
# installed; these procs compose rbac::assert_sender_has_role(DOM_PAUSER) with the UNAUTHENTICATED
# pausable::pause/unpause primitives (mod.masm:57 "compose with access control in a wrapper"). The
# is_paused slot is FungibleFaucet-installed (pinned v0.15.3), so these write a real slot. Module home
# + flat path per D-1A (CANONICAL-OWNERSHIP-MAP.md).

use miden::standards::access::rbac
use miden::standards::access::pausable

# CONSTANTS
# =================================================================================================

# The DOM_PAUSER RoleSymbol encoded as a Felt (RoleSymbol::as_element, base-27 over A-Z/_). HARD-CODED
# here (never caller-supplied) so no role a caller merely holds can be substituted for DOM_PAUSER.
# Parity-asserted against the Rust RoleSymbol::new(DOM_PAUSER_ROLE).as_element() in constant_parity.rs
# (masm-rust-constant-parity); a drift silently breaks the role gate. DOM_PAUSER seeded id 2 (CMP-F2).
const DOM_PAUSER_ROLE = 728098706988649

# PUBLIC INTERFACE
# =================================================================================================

#! Pauses the faucet — the DOM_PAUSER-gated emergency halt: gates on the DOM_PAUSER role (the note
#! sender must hold it), then sets the is_paused flag via the unauthenticated pausable primitive. A
#! paused faucet halts both
#! deposits (the xreserve_mint assert_not_paused reconciliation) and withdrawals (execute_burn_policy's
#! stock pause gate) — CIR-ADMIN-4.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold DOM_PAUSER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#!
#! Invocation: call
pub proc pause
    push.DOM_PAUSER_ROLE
    # => [DOM_PAUSER_ROLE, pad(15)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::pause
    # => [pad(16)]
end

#! Unpauses the faucet: the same DOM_PAUSER role gate, then clears the is_paused flag via the
#! unauthenticated pausable primitive. The Circle multi-party co-approval for unpause is an OPS SOP
#! (TASK-P4-MONITORING-ADMIN-OPS), NOT an on-chain check — deliberately not enforced here.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold DOM_PAUSER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#!
#! Invocation: call
pub proc unpause
    push.DOM_PAUSER_ROLE
    # => [DOM_PAUSER_ROLE, pad(15)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::unpause
    # => [pad(16)]
end
