# xreserve::pause_admin
#
# The DOM_PAUSER-gated custom pause/unpause: under Circle's Domain-Pauser-only model
# this is the ONLY pause surface on the faucet. The stock PausableManager gates pause on
# the account-wide Authority (= owner), which both fails Circle's distinct-pauser-role
# model and gives the owner a direct pause path, so these procs compose
# rbac::assert_sender_has_role(DOM_PAUSER) with the UNAUTHENTICATED pausable::pause/unpause
# primitives instead. The is_paused slot is installed by the base Pausable component, so
# these write a real slot.

use miden::standards::access::rbac
use miden::standards::access::pausable

# CONSTANTS
# =================================================================================================

# The DOM_PAUSER RoleSymbol encoded as a Felt (RoleSymbol::as_element, base-27 over A-Z/_).
# HARD-CODED here rather than caller-supplied, so no role a caller merely holds can be substituted
# for DOM_PAUSER.
const DOM_PAUSER_ROLE = 728098706988649

# PUBLIC INTERFACE
# =================================================================================================

#! Pauses the faucet — the DOM_PAUSER-gated emergency halt: gates on the DOM_PAUSER role (the
#! note sender must hold it), then sets the is_paused flag via the unauthenticated pausable
#! primitive. A paused faucet halts both deposits (the mint-policy dispatch's stock pause gate,
#! which runs before the attestation policy) and withdrawals (the burn-policy dispatch's stock
#! pause gate).
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold DOM_PAUSER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#!
#! Invocation: call
@account_procedure
pub proc pause
    push.DOM_PAUSER_ROLE
    # => [DOM_PAUSER_ROLE, pad(15)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::pause
    # => [pad(16)]
end

#! Unpauses the faucet: the same DOM_PAUSER role gate, then clears the is_paused flag via the
#! unauthenticated pausable primitive. The Circle multi-party co-approval for unpause is an
#! operational procedure, not an on-chain check.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold DOM_PAUSER (rbac::assert_sender_has_role, ERR_SENDER_LACKS_ROLE).
#!
#! Invocation: call
@account_procedure
pub proc unpause
    push.DOM_PAUSER_ROLE
    # => [DOM_PAUSER_ROLE, pad(15)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::unpause
    # => [pad(16)]
end
