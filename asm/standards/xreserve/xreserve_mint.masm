# xreserve::xreserve_mint
#
# FAUCET(01)-owned mint WRITE-phase (P5-01 D5e slice): `apply_mint_effects` — the supply-cap
# guard (R-MINT-15) plus the atomic mint effects (nonce SET, P2ID recipient note carrying the
# minted xUSDC, token_supply += amount). The only supply-increasing surface (CMP-A9, §5.1); a
# CUSTOM proc that does NOT route through `execute_mint_policy` / the stock `mint_and_send`
# (ASG-1 / C-7). Because it bypasses `execute_mint_policy` — where the stock pause gate lives — `mint`
# runs its own `assert_not_paused` FIRST so a DOM_PAUSER pause halts deposits (CIR-ADMIN-4)
# [RECONCILED → DECISION-CMPF3-MINT-PAUSE-GAP]. The write-side kernel primitives it consumes (token_config value-slot R/W,
# native_account::set_map_item, note::compute_and_store_recipient + output_note::*,
# faucet::create_fungible_asset + faucet::mint) are grounded by canary/mint-effects-grounding
# (executes+commits under MockChain) and mirror mint_and_send (fungible.masm:264-364) +
# notes/p2id.masm:90 (the recipient build is inlined here from miden::protocol::note so the
# xreserve library stays core+protocol only — no standards link needed by the harness assembler;
# the P2ID script root is passed in, the faucet.rs:538-600 pattern).
#
# BUILD STATE: implemented (D5e green commit). The supply-cap guard (R-MINT-15) does the three
# ordered non-wrap asserts mirroring mint_and_send (fungible.masm:288-308), trapping the single
# ERR_XRESERVE_SUPPLY_CAP; over-cap rejects BEFORE any effect (guard is first, so no nonce/note/
# supply write). Then the atomic effects in spec order (COMPONENT-SPEC §5.1:260-264): nonce SET →
# P2ID recipient note (amount - feeAmount) → token_supply += amount. The xreserve_mint COMPOSITION
# (chaining D5a-e + the fail-closed property) is the NEXT slice. Loop history:
# crates/xusdc-encoding/TEST-LEDGER-01-MINT-SHELL.md.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::faucet
use miden::protocol::note
use miden::protocol::output_note
use miden::protocol::account_id
use miden::protocol::asset::FUNGIBLE_ASSET_MAX_AMOUNT
use miden::standards::access::pausable
use xreserve::deposit_intent_parser
use xreserve::deposit_intent_parser::USED_NONCES_SLOT
use xreserve::attestation_verify
use xreserve::encoding
use xreserve::encoding::layout::AMOUNT_FELT_OFF
use xreserve::encoding::layout::NONCE_FELT_OFF
use xreserve::encoding::layout::REMOTE_RECIPIENT_FELT_OFF
use xreserve::encoding::layout::DEPOSIT_INTENT_HEADER_FELTS

# CONSTANTS
# =================================================================================================

# The standard FungibleFaucet component installs this value slot holding
# [token_supply, max_supply, decimals, token_symbol]. Hard-coded here exactly as the standard
# faucet does (fungible.masm:26), sanctioned for the self-contained faucet by
# CANONICAL-OWNERSHIP-MAP.md:41; the Rust fixture binds the same label.
pub const TOKEN_CONFIG_SLOT = word("miden::standards::faucets::fungible::token_config")

# Number of P2ID note-storage items ([target_id_suffix, target_id_prefix]; p2id.masm storage fmt).
const P2ID_NUM_STORAGE_ITEMS = 2

# The non-empty Word written into usedNonces[KEY] (the D5c read asserts EMPTY_WORD, so any
# non-empty marker flips it). DEV-9 / Q-CRY-5: the marker stays a plain flag (OPEN).
const NONCE_USED_MARKER = [1, 0, 0, 0]

# The canonical P2ID note script root (miden_standards::note::P2idNote::script_root), threaded to
# apply_mint_effects so the emitted recipient note is identifiable as P2ID. Array-literal const (not
# parity-parsed, mirroring NONCE_USED_MARKER); functionally pinned by the composition happy tests
# (recipient.script().root() == P2idNote::script_root()).
const P2ID_SCRIPT_ROOT = [12857783041667862256, 16051201080474444825, 5045064883019570010, 12450335876814921250]

# ERRORS
# =================================================================================================

# D5e supply cap (R-MINT-15). token_supply + amount must not exceed max_supply <= AssetAmount::MAX.
const ERR_XRESERVE_SUPPLY_CAP = "mint amount exceeds the faucet supply cap"

# Slice-1 recipient AccountId extraction (extract_recipient_account_id). The local R-B layout /
# field-range checks; the suffix-shape and unknown-version rejects surface the protocol
# account_id::validate ERR_ACCOUNT_ID_* constants directly. Parity-pinned against
# support::SHELL_ERR_TABLE + SHELL_ERRORS_DECLARED (constant_parity.rs).
const ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE = "deposit intent remote recipient address pad is not zero"
const ERR_XRESERVE_RECIPIENT_BAD_LIMB = "deposit intent remote recipient limb is not a valid u32"
const ERR_XRESERVE_RECIPIENT_NONCANONICAL = "deposit intent remote recipient value does not fit in the field"

# LOCAL LAYOUT (felts)
# =================================================================================================
#   0..3   P2ID note storage ([target_id_suffix, target_id_prefix, _, _]) — word-aligned base for
#          note::compute_and_store_recipient (reads P2ID_NUM_STORAGE_ITEMS felts from locaddr.0)
#   4..7   KEY (usedNonces storage-map key; consumed by reference from D5c)
#   8..11  SERIAL_NUM (recipient note serial)
#   12..15 P2ID_SCRIPT_ROOT (the P2ID note script root; passed in, identifies the note as P2ID)
#   16..19 token_config cache (the slot word, for the supply write-back)
#   20 amount   21 feeAmount   22 tag   23 note_type

# PUBLIC INTERFACE
# =================================================================================================

#! Applies the atomic mint effects for a verified intent's outputs (D5e). Reads the faucet
#! token_config, sets the nonce marker, emits the P2ID recipient note carrying `amount - feeAmount`
#! of the minted xUSDC to the target AccountId, and raises `token_supply` by the full `amount`.
#!
#! Inputs:  [amount, feeAmount, KEY, recipient_id_suffix, recipient_id_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]
#! Outputs: [pad(16)]
#!
#! Where:
#! - amount is the reduced AssetAmount to mint (full amount added to token_supply).
#! - feeAmount is the reduced operator fee (MVP == 0; the recipient note carries amount - feeAmount).
#! - KEY is the usedNonces storage-map key (already = bytes32_to_key(nonce) from D5c; consumed by
#!   reference, never re-derived here).
#! - recipient_id_{suffix,prefix} are the two AccountId felts of the P2ID target (D-5: consumed
#!   directly; the remoteRecipient bytes32->felts extraction is the composition's job, DEV-10 OPEN).
#! - SERIAL_NUM is the recipient note serial number.
#! - P2ID_SCRIPT_ROOT is the P2ID note script root (identifies the recipient note as P2ID).
#! - tag, note_type are the recipient note metadata (note_type 1 = public).
#!
#! Panics if:
#! - token_supply + amount > max_supply, or max_supply > FUNGIBLE_ASSET_MAX_AMOUNT (R-MINT-15,
#!   ERR_XRESERVE_SUPPLY_CAP) — the guard is first, so no effects are applied on reject.
#!
#! Invocation: exec
@locals(24)
pub proc apply_mint_effects
    # park every input into locals (top-first) so each effect step loads exactly what it needs;
    # the recipient felts go to the word-aligned note-storage region at locals 0..1
    loc_store.20 loc_store.21
    # => [KEY, recipient_id_suffix, recipient_id_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type, ...]
    loc_storew_le.4 dropw
    # => [recipient_id_suffix, recipient_id_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type, ...]
    loc_store.0 loc_store.1
    # => [SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type, ...]
    loc_storew_le.8 dropw
    # => [P2ID_SCRIPT_ROOT, tag, note_type, ...]
    loc_storew_le.12 dropw
    # => [tag, note_type, ...]
    loc_store.22 loc_store.23
    # => [...]

    # ---- supply guard (R-MINT-15): READ token_config + three ordered non-wrap asserts ----
    # mirror mint_and_send (fungible.masm:264-308): the asserts are ordered so the `sub` cannot
    # wrap (token_supply <= max_supply asserted first), and the inputs are pre-bounded < 2^63 by
    # the D5b reducer (amount <= FUNGIBLE_ASSET_MAX_AMOUNT) — so felt lte/sub behave as integers.
    push.TOKEN_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [token_supply, max_supply, decimals, token_symbol, ...]
    loc_storew_le.16
    # => [token_supply, max_supply, decimals, token_symbol, ...]   (cached for the write-back, kept on stack)
    swap movup.2 drop movup.2 drop
    # => [max_supply, token_supply, ...]
    loc_load.20 movdn.2
    # => [max_supply, token_supply, amount, ...]
    dup.1 dup.1 lte assert.err=ERR_XRESERVE_SUPPLY_CAP
    # => [max_supply, token_supply, amount, ...]   (token_supply <= max_supply: the no-wrap guard)
    dup lte.FUNGIBLE_ASSET_MAX_AMOUNT assert.err=ERR_XRESERVE_SUPPLY_CAP
    # => [max_supply, token_supply, amount, ...]   (max_supply <= FUNGIBLE_ASSET_MAX_AMOUNT)
    dup.2 swap dup.2 sub
    # => [max_mint_amount, amount, token_supply, amount, ...]   (max_mint_amount = max_supply - token_supply)
    lte assert.err=ERR_XRESERVE_SUPPLY_CAP
    # => [token_supply, amount, ...]   (amount <= max_mint_amount: token_supply + amount <= max_supply)
    drop drop
    # => [...]   (guard passed; the cached config word lives in locals 16..19)

    # ---- nonce SET (FIRST state write): usedNonces[KEY] := MARKER ----
    push.NONCE_USED_MARKER
    # => [MARKER]
    padw loc_loadw_le.4
    # => [KEY, MARKER]
    push.USED_NONCES_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, KEY, MARKER]
    exec.native_account::set_map_item dropw
    # => [...]

    # ---- recipient P2ID note carrying amount - feeAmount ----
    # build the recipient on-chain from the target id (note storage at locals 0..1), the serial,
    # and the P2ID script root (note::compute_and_store_recipient, mirrors p2id.masm:105-108)
    padw loc_loadw_le.12 padw loc_loadw_le.8 push.P2ID_NUM_STORAGE_ITEMS locaddr.0
    # => [storage_ptr, num_storage_items, SERIAL_NUM, P2ID_SCRIPT_ROOT, ...]
    exec.note::compute_and_store_recipient
    # => [RECIPIENT, ...]
    loc_load.23 loc_load.22 exec.output_note::create
    # => [note_idx, ...]
    loc_load.20 loc_load.21 sub
    # => [amount - feeAmount, note_idx, ...]
    exec.faucet::create_fungible_asset
    # => [ASSET_KEY, ASSET_VALUE, note_idx, ...]
    dupw.1 dupw.1 exec.faucet::mint
    # => [ASSET_KEY, ASSET_VALUE, note_idx, ...]
    exec.output_note::add_asset
    # => [...]   (the recipient note is emitted as a tx side effect)

    # ---- token_supply += amount (the FULL amount, exactly once) ----
    padw loc_loadw_le.16
    # => [token_supply, max_supply, decimals, token_symbol, ...]
    loc_load.20 add
    # => [new_token_supply, max_supply, decimals, token_symbol, ...]
    push.TOKEN_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [...]
end

#! Extracts and canonically validates the P2ID recipient's Miden AccountId felts from the staged
#! DepositIntent's `remoteRecipient` bytes32 (R-B layout), feeding `apply_mint_effects` (Slice 1).
#!
#! Reads the eight u32-LE-packed `remoteRecipient` limbs at `intent_ptr + REMOTE_RECIPIENT_FELT_OFF`,
#! asserts the 16-byte leading pad is zero, rebuilds the big-endian `prefix`/`suffix` u64s — each
#! through a no-reduction `build_felt` (byte-swap the two limbs, compose `hi*2^32 + lo`, then prove
#! via a `u32split` round-trip that the value did NOT reduce mod the field, mirroring Rust
#! `Felt::try_from`) — then delegates canonical AccountId validation to
#! `miden::protocol::account_id::validate` (suffix low byte == 0, suffix MSB == 0, version == 1).
#!
#! Inputs:  [intent_ptr]
#! Outputs: [recipient_id_suffix, recipient_id_prefix]
#!
#! Where:
#! - intent_ptr is the memory address of the u32-LE-packed DepositIntent preimage.
#! - recipient_id_{suffix,prefix} are the two validated Miden AccountId felts, in the stack order
#!   `apply_mint_effects` consumes ([suffix, prefix]; Rust `account_id_to_felts` is [prefix, suffix]).
#!
#! Panics if:
#! - the remoteRecipient 16-byte leading pad is non-zero (ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE).
#! - a staged remoteRecipient limb is not a valid u32 (ERR_XRESERVE_RECIPIENT_BAD_LIMB).
#! - a rebuilt prefix/suffix u64 reduced mod the field (ERR_XRESERVE_RECIPIENT_NONCANONICAL).
#! - account_id::validate rejects the felts (its ERR_ACCOUNT_ID_* suffix/version constants).
#!
#! Invocation: exec
pub proc extract_recipient_account_id
    push.REMOTE_RECIPIENT_FELT_OFF add
    # => [base]   (base = intent_ptr + REMOTE_RECIPIENT_FELT_OFF; the 8 limbs occupy base+0..7)

    # ---- R-B leading pad: the 16-byte pad (limbs base+0..3) must be exactly zero ----
    dup mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.1 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.2 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    dup add.3 mem_load assertz.err=ERR_XRESERVE_RECIPIENT_OUT_OF_RANGE
    # => [base]

    # ---- prefix = build_felt(lo = limb base+5, hi = limb base+4)  (bytes[16..24], big-endian) ----
    dup add.4 mem_load
    # => [prefix_hi, base]
    dup.1 add.5 mem_load
    # => [prefix_lo, prefix_hi, base]
    exec.build_felt
    # => [prefix, base]

    # ---- suffix = build_felt(lo = limb base+7, hi = limb base+6)  (bytes[24..32], big-endian) ----
    dup.1 add.6 mem_load
    # => [suffix_hi, prefix, base]
    movup.2 add.7 mem_load
    # => [suffix_lo, suffix_hi, prefix]
    exec.build_felt
    # => [suffix, prefix]

    # ---- canonical AccountId validation (suffix low byte == 0, suffix MSB == 0, version == 1) ----
    # delegate to the pinned protocol validator (consumed BY REFERENCE) over a copy of the felts;
    # the originals are the returned [suffix, prefix] apply_mint_effects consumes
    dup.1 dup.1
    # => [suffix, prefix, suffix, prefix]
    exec.account_id::validate
    # => [suffix, prefix]
end

#! The xUSDC mint composition entry (Slice 2): chains the accepted verify stages and the write stage
#! into one supply-gating mint — assert_deposit_intent (D5a) -> assert_mint_amounts (D5b) ->
#! assert_nonce_unused (D5c) -> verify_attestation (D5d) -> extract_recipient_account_id ->
#! apply_mint_effects (D5e) — verify-once then write-once. Fail-closed: any verify / extraction trap
#! aborts the whole tx with NO writes (no nonce SET, no recipient note, no token_supply change), so a
#! failed mint never burns the nonce.
#!
#! Inputs (stack):  [intent_ptr, len_felts, scale_exp]
#! Inputs (advice): [feeAmount(8 limbs), pubkey(9), signature(17)]   (MVP feeAmount = eight zero limbs)
#! Outputs: [pad(16)]
#!
#! Where:
#! - intent_ptr is the memory address of the staged u32-LE-packed DepositIntent preimage.
#! - len_felts is the staged preimage length in felts (D5a structural length relation).
#! - scale_exp is the uint256 -> AssetAmount decimal scale exponent (DEV-5 OPEN; threaded to D5b and
#!   the marshalled `amount` reduction).
#!
#! Panics if:
#! - the faucet is paused (pausable::assert_not_paused, ERR_PAUSABLE_IS_PAUSED) — the CMP-F3 halt gate
#!   (CIR-ADMIN-4; DECISION-CMPF3-MINT-PAUSE-GAP): the custom mint bypasses the deny'd mint policy where
#!   the stock assert_not_paused lives, so this pause check makes a DOM_PAUSER pause halt deposits.
#! - any verify stage (R-MINT-1..14) or the recipient extraction rejects (fail-closed), or the supply
#!   cap is exceeded (R-MINT-15) — no effects are applied on any reject.
#!
#! Invocation: exec
@locals(12)
pub proc mint
    # => [intent_ptr, len_felts, scale_exp]
    # halt gate (R-MINT pause, CMP-F3): a paused faucet must not mint. FIRST (before any verify), mirrors
    # the sibling setters + the stock execute_mint_policy this custom mint bypasses; operand-stack-neutral
    # (reads the FungibleFaucet-installed is_paused slot). See DECISION-CMPF3-MINT-PAUSE-GAP.
    exec.pausable::assert_not_paused
    # => [intent_ptr, len_felts, scale_exp]

    # stash intent_ptr (loc 0) + scale_exp (loc 1); both are reused across the chain + marshal, and
    # the operand stack is kept logically empty between stages (verify_attestation restores the
    # depth-16 floor, so nothing else may sit above it when it runs).
    movup.2 loc_store.1
    # => [intent_ptr, len_felts]
    dup loc_store.0
    # => [intent_ptr, len_felts]

    # ---- VERIFY (verify-once); any trap aborts the whole tx -> no writes reachable ----

    # D5a (R-MINT-1..8): structural parse + domain/identifier compares -> [hook_data_len]
    exec.deposit_intent_parser::assert_deposit_intent
    loc_store.2
    # => []   (loc 2 = hook_data_len, for the D5d keccak extent)

    # D5b (R-MINT-9/10/11): amount/maxFee/feeAmount reduction + bounds (feeAmount from advice)
    loc_load.1 loc_load.0
    # => [intent_ptr, scale_exp]
    exec.deposit_intent_parser::assert_mint_amounts
    # => []

    # D5c (R-MINT-12): nonce replay guard (assert-zero only; the SET is the first D5e write)
    loc_load.0
    exec.deposit_intent_parser::assert_nonce_unused
    # => []

    # D5d (R-MINT-13/14): keccak the 240 + hook_data_len payload, allowlist gate + ECDSA verify
    # (pubkey + signature from advice). len_bytes = DEPOSIT_INTENT_HEADER_FELTS*4 + hook_data_len.
    loc_load.2 push.DEPOSIT_INTENT_HEADER_FELTS mul.4 add
    # => [len_bytes]
    loc_load.0
    # => [intent_ptr, len_bytes]
    exec.attestation_verify::verify_attestation
    # => [pad(16)]   (depth-16 floor restored; operand stack logically empty)

    # ---- MARSHAL apply_mint_effects inputs (deterministic recompute from the UNMUTATED preimage) ----

    # KEY = bytes32_to_key(nonce) (loc 4..7); == the key D5c checked and the one D5e SETs / serials
    loc_load.0 push.NONCE_FELT_OFF add
    exec.load_field_words
    exec.encoding::bytes32_to_key
    loc_storew_le.4 dropw
    # => []

    # recipient AccountId felts from remoteRecipient (loc 8 = suffix, loc 9 = prefix)
    loc_load.0
    exec.extract_recipient_account_id
    # => [recipient_id_suffix, recipient_id_prefix]
    loc_store.8 loc_store.9
    # => []

    # amount = reduce(amount field, scale_exp) (loc 3); == the value D5b verified >= maxFee
    loc_load.1 loc_load.0 push.AMOUNT_FELT_OFF add
    # => [amount_base, scale_exp]
    exec.load_field_words
    # => [U1, U0, scale_exp]
    exec.encoding::uint256_to_asset_amount
    loc_store.3
    # => []

    # ---- WRITE-ONCE: build apply_mint_effects inputs (push bottom-first) and apply the effects ----
    # [amount, feeAmount, KEY, recip_suffix, recip_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]
    push.1
    # => [note_type]   (note_type 1 = public)
    # tag (best-effort routing; NoteTag::with_account_target): top 14 bits of the prefix's HIGH u32.
    # u32split -> [lo, hi] (lo on top); drop lo to keep hi = prefix >> 32, then mask the top 14 bits.
    loc_load.9 u32split drop u32and.0xfffc0000
    # => [tag, note_type]
    push.P2ID_SCRIPT_ROOT
    # => [P2ID_SCRIPT_ROOT, tag, note_type]
    padw loc_loadw_le.4
    # => [SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]   (SERIAL_NUM = the nonce-derived KEY)
    loc_load.9 loc_load.8
    # => [recip_suffix, recip_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]
    padw loc_loadw_le.4
    # => [KEY, recip_suffix, recip_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]
    push.0
    # => [feeAmount, KEY, ...]   (MVP feeAmount == 0: the single recipient note carries the full amount)
    loc_load.3
    # => [amount, feeAmount, KEY, recip_suffix, recip_prefix, SERIAL_NUM, P2ID_SCRIPT_ROOT, tag, note_type]
    exec.apply_mint_effects
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Builds a Miden field element from the two u32-LE-packed limbs of a big-endian u64, PROVING the
#! value did not reduce mod the field (the canonical-range check mirroring Rust `Felt::try_from`;
#! the `miden-agglayer` `eth_address.masm::build_felt` precedent, adapted with a local byte-swap so
#! the faucet library depends on no private 04 export).
#!
#! Inputs:  [lo, hi]
#! Outputs: [felt]
#!
#! Where:
#! - lo, hi are the low / high u32-LE-packed limbs of a big-endian u64 (4 wire bytes each).
#! - felt is the reconstructed field element (hi_be * 2^32 + lo_be).
#!
#! Panics if:
#! - a limb is not a valid u32 (ERR_XRESERVE_RECIPIENT_BAD_LIMB).
#! - the composed u64 reduced mod the field, i.e. it is >= the field modulus
#!   (ERR_XRESERVE_RECIPIENT_NONCANONICAL).
#!
#! Invocation: exec
proc build_felt
    u32assert2.err=ERR_XRESERVE_RECIPIENT_BAD_LIMB
    # => [lo, hi]
    exec.swap_u32_bytes swap exec.swap_u32_bytes swap
    # => [lo_be, hi_be]   (each limb byte-swapped LE -> BE)
    dup.1 dup.1
    # => [lo_be, hi_be, lo_be, hi_be]
    swap mul.0x0100000000 add
    # => [felt, lo_be, hi_be]   (felt = hi_be * 2^32 + lo_be, in the field)
    dup u32split
    # => [felt_lo, felt_hi, felt, lo_be, hi_be]
    movup.3 assert_eq.err=ERR_XRESERVE_RECIPIENT_NONCANONICAL
    # => [felt_hi, felt, hi_be]   (no reduction: low 32 bits round-trip)
    movup.2 assert_eq.err=ERR_XRESERVE_RECIPIENT_NONCANONICAL
    # => [felt]                    (no reduction: high 32 bits round-trip)
end

#! Reverses the byte order of a u32 (little-endian <-> big-endian). A generic u32 primitive (NOT
#! 04-owned domain logic); reimplemented locally because the 04 `encoding::swap_u32_bytes` is a
#! private `proc` and exporting it / adding to 04 is out of this slice's ownership. The caller
#! asserts u32-ness (`build_felt`'s `u32assert2`) before invoking.
#!
#! Inputs:  [value]
#! Outputs: [swapped]
#!
#! Where:
#! - value is a u32; swapped is value with its four bytes reversed.
#!
#! Invocation: exec
proc swap_u32_bytes
    dup u32and.0xff u32shl.24
    # => [part0, value]   (byte 0 -> byte 3)
    dup.1 u32shr.8 u32and.0xff u32shl.16 u32or
    # => [part01, value]  (byte 1 -> byte 2)
    dup.1 u32shr.16 u32and.0xff u32shl.8 u32or
    # => [part012, value] (byte 2 -> byte 1)
    dup.1 u32shr.24 u32or
    # => [swapped, value] (byte 3 -> byte 0)
    swap drop
    # => [swapped]
end

#! Loads the 8 u32-LE-packed limbs of a 32-byte field at `base` into the [W1, W0] word orientation
#! the encoding reducers consume, preserving anything below `base`. Replicates the (private)
#! deposit_intent_parser staging (reduce_uint256_field / assert_nonce_unused nonce load): single-felt
#! loads because the DC-1 felt offsets are not word-aligned (word loads trap UnalignedWordAccess);
#! the reduction / key-hash itself is the 04 `pub proc`, consumed by reference at the call site.
#!
#! Inputs:  [base, ...]
#! Outputs: [W1, W0, ...]
#!
#! Where:
#! - base is the memory address of the field's first packed limb.
#! - W0 is the field's first four packed limbs (wire bytes 0..16), W1 the next four (wire bytes
#!   16..32), each element-0 on top.
#!
#! Invocation: exec
proc load_field_words
    dup add.3 mem_load
    dup.1 add.2 mem_load
    dup.2 add.1 mem_load
    dup.3 mem_load
    # => [W0, base, ...]
    dup.4 add.7 mem_load
    dup.5 add.6 mem_load
    dup.6 add.5 mem_load
    dup.7 add.4 mem_load
    # => [W1, W0, base, ...]
    movup.8 drop
    # => [W1, W0, ...]
end
