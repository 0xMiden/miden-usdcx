# xreserve::xreserve_mint_note_entry
#
# The CMP-B1 note-entry wrapper: `receive_and_mint` — the account-side transport
# shim the production `XReserveMintNote` script `call`s. It stages the note's DepositIntent
# preimage into the ACCOUNT call frame (`active_note::get_storage`; the `receive_and_burn`
# context precedent, fungible.masm:370-403 — `exec` shares the call frame, so the data lands
# exactly where `mint` reads `intent_ptr`), hash-verifies the single fee/pubkey/signature
# attachment against the note-committed attachment commitment (`find_attachment` +
# `write_attachment_to_memory` with count + 11-word size asserts — the network_account_target
# idiom, network_account_target.masm:101-124), re-surfaces the SAME verified advice-map entry
# onto the advice stack (`adv.push_mapval`, used ONLY after the hash check; no advice-map
# mutation in between — the entry is proven to hash to the note-committed commitment), and hands
# `[intent_ptr, len_felts, scale_exp]` to `exec.xreserve_mint::mint` — the ONLY mint-family
# callable root (F1).
#
# A pure TRANSPORT SHIM: it writes no storage, raises no supply, replicates no D5 logic, and
# CANNOT reference the demoted `apply_mint_effects` / `extract_recipient_account_id` (private
# procs are not importable cross-module post-F1). Every gate lives in `mint` (pause, D5a→D5e).
# It IS a new callable account root (#17) — consciously registered in the frozen root-surface
# tripwire (mint_root_surface.rs) and policed by the tree-wide supply write-integrity sweep.
#
# Grounded by canary/mint-note-transport-grounding (executes + commits under MockChain; the canary
# is a v0.15.3 / 0.23.3 artifact and is NOT re-run at the v0.16 pin — the migration's own
# assemble-and-execute gate re-proves this shim end to end. The element-0-first `adv.push_mapval`
# pop order and the
# tampered-advice fail-close are pinned there).

use miden::protocol::active_note
use {NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME} from miden::standards::attachments::network_account_target
use xreserve::xreserve_mint
use {DEPOSIT_INTENT_HEADER_FELTS} from xreserve::encoding::layout

# CONSTANTS
# =================================================================================================

# Absolute account-call-frame address where the DepositIntent preimage is staged for `mint`
# (word-aligned; the proven driver convention — the same value the composition harness stages at).
const INTENT_PTR = 1024

# The mint-note attestation attachment scheme. The Rust constructor declares the same value
# (`XRESERVE_MINT_ATTACHMENT_SCHEME`, cross-language constant parity via constant_parity.rs); a
# scheme mismatch fail-closes in `find_attachment` below.
const XRESERVE_MINT_ATTACHMENT_SCHEME = 1

# The attestation attachment word count: [feeAmount(8), pubkey(16), signature(17), pad(3)]
# = 44 felts = 11 words, matching `mint`'s frozen advice contract order (the pubkey is the
# 16-felt affine form since the v16 migration — vm#3342, MIGRATION-V16-ALPHA2.md S16).
const XRESERVE_MINT_ATTACHMENT_NUM_WORDS = 11

# The DC-5 uint256→AssetAmount decimal scale (`y = floor(x / 10^scale_exp)`), FAUCET-side by
# design: a note-carried scale would let the producer diverge the minted amount from the attested
# amount. DEV-5 ANSWERED: Circle's on-wire deposit `amount` is denominated in 6-decimal smallest
# units and xUSDC is likewise 6-decimal, so the two denominations coincide and NO rescale applies —
# scale 0, `y = floor(x / 10^0) = x`, an identity with no floored dust. (`0` is inside the reducer's
# `[0, SCALE_EXP_MAX=18]` bound.) This constant remains the parameterization point should a
# future deployment pair a wire denomination with a differently-scaled asset; the identity is
# pinned behaviourally by tests/mint_scale_conformance.rs, which drives `receive_and_mint` and
# asserts a Circle-format deposit mints the same number of smallest units.
const DEPOSIT_SCALE_EXP = 0

# The number of felts in a Word — for the indexed attachment-commitment address math
# (`commitment_ptr = commitments_base + sc1_idx * WORD_NUM_ELEMENTS`), mirroring the pinned
# `note::write_indexed_attachment_to_memory`.
const WORD_NUM_ELEMENTS = 4

# ERRORS
# =================================================================================================

# The note storage must carry at least the 60-felt DepositIntent header (D5a re-validates the
# content; this is the transport-shape guard on the kernel-returned item count).
const ERR_XRESERVE_MINT_NOTE_STORAGE_TOO_SHORT = "mint note storage is shorter than the deposit intent header"

# The attestation attachment (fee + candidate pubkey + signature) must be present under the
# mint-note scheme.
const ERR_XRESERVE_MINT_NOTE_ATTACHMENT_MISSING = "mint note attestation attachment is missing"

# Exactly TWO attachments: the scheme-1 attestation + the scheme-2 NetworkAccountTarget routing bind.
const ERR_XRESERVE_MINT_NOTE_ATTACHMENT_COUNT = "mint note must carry exactly two attachments"

# The verified attachment must be exactly 11 words ([feeAmount(8), pubkey(16), signature(17), pad(3)]).
const ERR_XRESERVE_MINT_NOTE_ATTACHMENT_NUM_WORDS = "mint note attachment word count is invalid"

# The scheme-2 NetworkAccountTarget routing attachment (routing-only — never read for effects) must
# be present alongside the attestation.
const ERR_XRESERVE_MINT_NOTE_TARGET_MISSING = "mint note routing target attachment is missing"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the active `XReserveMintNote` and drives the fully-gated attested mint.
#!
#! Stages the note's storage (the u32-LE-packed DepositIntent preimage) into the account call
#! frame at INTENT_PTR, hash-verifies the scheme-1 attestation attachment (selected by its found
#! index) against the note-committed attachment commitment, asserts the scheme-2 routing target is
#! also present (routing-only), re-surfaces the verified elements onto the advice stack
#! in `mint`'s frozen order [feeAmount(8), pubkey(16), signature(17)], and execs
#! `xreserve_mint::mint`. A pure transport shim: no storage writes, no supply arithmetic, no D5
#! logic — every gate lives in `mint`.
#!
#! Locals (@locals(60), word-aligned sub-regions): loc[0..44] hash-verified attachment content
#! ([feeAmount(8), pubkey(16), signature(17), pad(3)]); loc[44..60] attachment commitments list
#! (≤ 4 words; the scheme-1 attestation's commitment is selected by its found index: word at
#! 44 + sc1_idx * WORD_NUM_ELEMENTS).
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - the active note's storage is the DepositIntent preimage (60 header felts + hookData felts).
#! - the active note's attachments are a scheme-1 attestation [feeAmount(8), pubkey(16),
#!   signature(17), pad(3)] and a scheme-2 NetworkAccountTarget routing attachment (routing-only,
#!   not read for effects).
#!
#! Panics if:
#! - the procedure is not called from a note context (active_note::* will fail).
#! - the note storage is shorter than the 60-felt DepositIntent header.
#! - the scheme-1 attestation attachment is missing, the scheme-2 routing target is missing, the
#!   total attachment count is not two, or the attestation is not 11 words.
#! - the attachment advice-map content does not hash to the note-committed attachment
#!   commitment (the pipe_preimage_to_memory assert inside write_attachment_to_memory).
#! - any `mint` gate rejects (pause, D5a..D5e).
#!
#! Invocation: call
@locals(60)
@account_procedure
pub proc receive_and_mint
    # --- stage the DepositIntent preimage into the account call frame ---
    push.INTENT_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    # transport-shape guard: at least the 60-felt header (content is D5a's job)
    dup push.DEPOSIT_INTENT_HEADER_FELTS
    # => [60, num_storage_items, num_storage_items, pad(16)]

    u32assert2.err=ERR_XRESERVE_MINT_NOTE_STORAGE_TOO_SHORT
    u32gte assert.err=ERR_XRESERVE_MINT_NOTE_STORAGE_TOO_SHORT
    # => [num_storage_items, pad(16)]

    # --- locate the scheme-1 attestation attachment; keep sc1_idx for the indexed commitment load ---
    push.XRESERVE_MINT_ATTACHMENT_SCHEME exec.active_note::find_attachment
    # => [is_found, sc1_idx, num_storage_items, pad(16)]

    assert.err=ERR_XRESERVE_MINT_NOTE_ATTACHMENT_MISSING
    # => [sc1_idx, num_storage_items, pad(16)]

    # --- the scheme-2 NetworkAccountTarget routing attachment must also be present (routing-only) ---
    push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME exec.active_note::find_attachment
    # => [is_found, sc2_idx, sc1_idx, num_storage_items, pad(16)]

    assert.err=ERR_XRESERVE_MINT_NOTE_TARGET_MISSING
    drop
    # => [sc1_idx, num_storage_items, pad(16)]

    # --- exactly two attachments total; with both schemes found this is one of each (a doubled
    #     scheme fails the other's find), so no per-scheme count is needed ---
    locaddr.44 exec.active_note::write_attachment_commitments_to_memory
    # => [num_attachments, sc1_idx, num_storage_items, pad(16)]

    eq.2 assert.err=ERR_XRESERVE_MINT_NOTE_ATTACHMENT_COUNT
    # => [sc1_idx, num_storage_items, pad(16)]

    # --- the binding step: hash-verify the scheme-1 attestation content BY ITS INDEX + 11-word check ---
    dup locaddr.0 exec.active_note::write_attachment_to_memory
    # => [num_words, sc1_idx, num_storage_items, pad(16)]

    eq.XRESERVE_MINT_ATTACHMENT_NUM_WORDS assert.err=ERR_XRESERVE_MINT_NOTE_ATTACHMENT_NUM_WORDS
    # => [sc1_idx, num_storage_items, pad(16)]

    # --- surface the scheme-1 attestation map entry to the advice stack (element-0-first pop order):
    #     load its commitment BY INDEX (commitments_base 44 + sc1_idx * WORD_NUM_ELEMENTS), the pinned
    #     note::write_indexed_attachment_to_memory address math ---
    mul.WORD_NUM_ELEMENTS locaddr.44 add
    # => [commitment_ptr, num_storage_items, pad(16)]

    padw movup.4 mem_loadw_le
    # => [ATTACHMENT_COMMITMENT, num_storage_items, pad(16)]

    adv.push_mapval
    # => [ATTACHMENT_COMMITMENT, num_storage_items, pad(16)]
    # advice stack => [feeAmount(8), pubkey(16), signature(17), pad(3)]

    dropw
    # => [num_storage_items, pad(16)]

    # --- hand off to the ONLY mint-family callable root (F1): [intent_ptr, len_felts, scale_exp] ---
    push.DEPOSIT_SCALE_EXP swap
    # => [len_felts, scale_exp, pad(16)]

    push.INTENT_PTR
    # => [intent_ptr, len_felts, scale_exp, pad(16)]

    exec.xreserve_mint::mint
    # => [pad(16)]
end
