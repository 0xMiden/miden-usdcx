# xusdc::canary::mint_effects
#
# Mint-effects grounding canary (P5-01 mint effects). TRIVIAL scratch component that proves the faucet
# write-side kernel primitives EXECUTE AND COMMIT end to end under MockChain on the pinned Miden
# v0.15.3 / assembler 0.23.3 stack, when installed on a FungibleFaucet account alongside the
# standard faucet component. It is NOT the real xreserve_mint proc: it decomposes the mint effects write
# phase into independent single-purpose procs (so each primitive's stack contract is provable in
# isolation) and hard-codes amounts/keys. Proc bodies mirror the live protocol precedent
# mint_and_send in protocol-pin-v0.15.3/.../faucets/fungible.masm:264-364 (token_config read via
# active_account::get_item, write-back via native_account::set_item, asset via
# faucet::create_fungible_asset + faucet::mint, note via output_note::*) and notes/p2id.masm:90
# (P2ID recipient build + note create). The nonce SET mirrors the storage-map canary.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::faucet
use miden::protocol::output_note
use miden::standards::notes::p2id

# CONSTANTS
# =================================================================================================

# The standard FungibleFaucet component installs this value slot holding
# [token_supply, max_supply, decimals, token_symbol]. Hard-coded here exactly as the standard
# faucet does (fungible.masm:26), sanctioned for the self-contained faucet by
# CANONICAL-OWNERSHIP-MAP.md:41. The Rust harness reads the same label.
pub const TOKEN_CONFIG_SLOT = word("miden::standards::faucets::fungible::token_config")

# Map slot standing in for mint effects's usedNonces registry; the Rust harness binds the same label.
pub const USED_SLOT = word("xusdc::canary::mint_effects::used")

# Hard-coded canary values (declared identically in the Rust harness — the passing test IS the
# parity check).
const AMOUNT = 1000
const TAG = 0
const NOTE_TYPE = 1
const SERIAL_NUM = [1, 2, 3, 4]
const TEST_KEY = [11, 12, 13, 14]
const MARKER = [1, 0, 0, 0]

# PUBLIC API
# =================================================================================================

#! Reads the faucet token_config and writes token_supply += AMOUNT back, mirroring mint_and_send's
#! saved-slot-copy + set_item write-back (fungible.masm:264-324). Proves the value-slot
#! read/modify/write primitive on the faucet's token_config slot.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Invocation: call
@locals(4)
pub proc bump_token_supply
    push.TOKEN_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [token_supply, max_supply, decimals, token_symbol, pad(...)]

    loc_storew_le.0
    # => [token_supply, max_supply, decimals, token_symbol, pad(...)]   (cached the full word)

    push.AMOUNT add
    # => [new_token_supply, max_supply, decimals, token_symbol, pad(...)]

    padw loc_loadw_le.0
    # => [token_supply, max_supply, decimals, token_symbol, new_token_supply, max_supply, decimals, token_symbol, pad(...)]

    drop movup.3
    # => [new_token_supply, max_supply, decimals, token_symbol, max_supply, decimals, token_symbol, pad(...)]

    push.TOKEN_CONFIG_SLOT[0..2] exec.native_account::set_item dropw
    # => [max_supply, decimals, token_symbol, pad(...)]

    drop drop drop
    # => [pad(...)]
end

#! Writes the fixed MARKER word at the fixed TEST_KEY in the USED map slot, mirroring the
#! storage-map canary / mint effects's nonce SET. Proves native_account::set_map_item commits.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Invocation: call
pub proc set_nonce_marker
    push.MARKER
    # => [MARKER]

    push.TEST_KEY
    # => [TEST_KEY, MARKER]

    push.USED_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, TEST_KEY, MARKER]

    exec.native_account::set_map_item
    # => [OLD_VALUE]

    dropw
    # => []
end

#! Builds a P2ID recipient note to the target AccountId (passed as [suffix, prefix]), mints AMOUNT
#! of the active faucet's fungible asset, and adds it to the note. Proves p2id::new +
#! faucet::create_fungible_asset + faucet::mint + output_note::add_asset, mirroring
#! mint_and_send:330-363 + p2id.masm:90.
#!
#! Inputs:  [recipient_id_suffix, recipient_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Invocation: call
@locals(2)
pub proc mint_and_emit
    loc_store.0 loc_store.1
    # => [pad(14)]   (local0=suffix, local1=prefix)

    push.SERIAL_NUM push.NOTE_TYPE push.TAG loc_load.1 loc_load.0
    # => [suffix, prefix, tag, note_type, SERIAL_NUM, pad(...)]

    exec.p2id::new
    # => [note_idx, pad(...)]

    push.AMOUNT exec.faucet::create_fungible_asset
    # => [ASSET_KEY, ASSET_VALUE, note_idx, pad(...)]

    dupw.1 dupw.1 exec.faucet::mint
    # => [ASSET_KEY, ASSET_VALUE, note_idx, pad(...)]

    exec.output_note::add_asset
    # => [pad(...)]   (the note is emitted as a tx side effect; the stack returns clean)
end
