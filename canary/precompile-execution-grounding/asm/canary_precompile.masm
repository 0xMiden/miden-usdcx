# xusdc::canary::precompile_execution
#
# Precompile-EXECUTION grounding canary (P5-01). TRIVIAL scratch component that proves the
# Keccak256 and secp256k1-ECDSA-over-keccak precompiles actually EXECUTE (not merely assemble/link)
# end to end under MockChain on the pinned Miden v0.15.3 / assembler 0.23.3 stack. It is NOT the real
# attester allowlist or DepositIntent attestation: it hashes a known input, and verifies one valid
# and one structurally-valid-but-invalid signature triple — exactly the primitives D5d's
# keccak-the-payload + ECDSA-verify-the-attester-key (R-MINT-13/14) build on.
#
# These are DEFERRED-execution precompiles: each driver `emit`s a precompile event whose host
# handler (registered by the stock miden-testing MockChain host, CoreLibrary::handlers()) performs
# the real crypto and returns the result via the advice provider. The drivers therefore read their
# inputs from the advice stack into procedure-local scratch and `exec` the upstream precompile procs;
# proc bodies mirror the live precedent in
# miden-core-lib-0.23.3/asm/crypto/dsa/ecdsa_k256_keccak.masm (the `verify` materialization) and
# .../hashes/keccak256.masm (the `hash` wrapper).

use miden::core::crypto::hashes::keccak256
use miden::core::crypto::dsa::ecdsa_k256_keccak

# CONSTANTS
# =================================================================================================

# Number of bytes hashed by keccak_hash_bytes_canary (a single 256-bit input). Declared identically
# in the Rust harness; the passing test is the masm-rust-constant-parity check.
const KECCAK_INPUT_LEN_BYTES = 32

# PUBLIC API
# =================================================================================================

#! Hashes a known 32-byte input with the Keccak256 precompile and returns the digest.
#!
#! Reads the 8-limb (32-byte) input from the advice stack into local scratch, then drives
#! `keccak256::hash_bytes`, whose host handler computes the real Keccak256 and supplies the digest
#! via advice. Proves the keccak precompile EXECUTES; the returned digest is asserted equal to an
#! INDEPENDENTLY-computed (sha3) known-answer vector by the tx script.
#!
#! Inputs:
#!   Operand stack: [pad(16)]
#!   Advice stack:  [INPUT_U32[8], ...]
#! Outputs:
#!   Operand stack: [DIGEST_U32[8], pad(8)]
#!
#! Where:
#! - INPUT_U32[8] is the 32-byte input packed as eight u32 limbs (4 bytes/limb, little-endian).
#! - DIGEST_U32[8] = Keccak256(INPUT) as eight u32 limbs, least-significant limb on top.
#!
#! Panics if:
#! - the keccak precompile host handler is not registered (no manual wiring under MockChain).
#!
#! Invocation: call
@locals(8)
pub proc keccak_hash_bytes_canary
    # materialize the 32-byte input (8 felts) from advice into locaddr.[0..8]
    adv_pushw loc_storew_le.0 dropw
    adv_pushw loc_storew_le.4 dropw
    # => [pad(16)]

    push.KECCAK_INPUT_LEN_BYTES locaddr.0
    # => [ptr, len_bytes]

    exec.keccak256::hash_bytes
    # => [DIGEST_U32[8], pad(16)]

    # restore the call-return depth of 16: drop 8 pad elements from below the 8-limb digest
    repeat.8
        movup.8 drop
    end
    # => [DIGEST_U32[8], pad(8)]
end

#! Verifies a pre-hashed ECDSA triple with the secp256k1 precompile and returns the boolean result.
#!
#! Reads the public key (9 felts / 33 bytes), the pre-computed message digest (8 felts / 32 bytes),
#! and the signature (17 felts / 65 bytes) from the advice stack into word-aligned local scratch,
#! then drives `ecdsa_k256_keccak::verify_prehash`, whose host handler performs the real ECDSA
#! verification and supplies the result via advice. Returns 1 for a valid triple, 0 for a
#! structurally-valid-but-invalid one (no trap) — the load-bearing accept/reject semantics for
#! R-MINT-14. The triple is generated by INDEPENDENT crates (`k256` keypair+signature).
#!
#! Inputs:
#!   Operand stack: [pad(16)]
#!   Advice stack:  [PK[9], DIGEST[8], SIG[17], ...]
#! Outputs:
#!   Operand stack: [result, pad(15)]
#!
#! Where:
#! - PK[9] is the 33-byte compressed secp256k1 public key packed as nine u32 limbs.
#! - DIGEST[8] is the 32-byte pre-hashed message packed as eight u32 limbs.
#! - SIG[17] is the 65-byte (r || s || v) signature packed as seventeen u32 limbs.
#! - result is 1 if the signature is valid for (PK, DIGEST), 0 otherwise.
#!
#! Panics if:
#! - the ecdsa precompile host handler is not registered (no manual wiring under MockChain).
#! - the public key or signature bytes fail to deserialize (malformed input, distinct from result 0).
#!
#! Invocation: call
@locals(40)
pub proc ecdsa_verify_prehash_canary
    # materialize the compressed public key (9 felts) into locaddr.[0..9]
    adv_pushw loc_storew_le.0 dropw
    adv_pushw loc_storew_le.4 dropw
    adv_push loc_store.8

    # materialize the pre-hashed digest (8 felts) into locaddr.[12..20]
    adv_pushw loc_storew_le.12 dropw
    adv_pushw loc_storew_le.16 dropw

    # materialize the signature (17 felts) into locaddr.[20..37]
    adv_pushw loc_storew_le.20 dropw
    adv_pushw loc_storew_le.24 dropw
    adv_pushw loc_storew_le.28 dropw
    adv_pushw loc_storew_le.32 dropw
    adv_push loc_store.36
    # => [pad(16)]

    locaddr.20 locaddr.12 locaddr.0
    # => [pk_ptr, digest_ptr, sig_ptr, pad(13)]

    exec.ecdsa_k256_keccak::verify_prehash
    # => [result, pad(16)]

    # restore the call-return depth of 16: drop one pad element from below the result
    swap drop
    # => [result, pad(15)]
end

#! Verifies an ECDSA signature over a single-word message with the secp256k1 precompile; TRAPS on a
#! bad signature.
#!
#! Thin pass-through to `ecdsa_k256_keccak::verify`: takes the public-key commitment and the message
#! word on the operand stack and the public key + signature on the advice stack. `verify` keccaks the
#! message internally (host handler), verifies, and `assert`s — so a forged-but-well-formed triple
#! makes the whole transaction FAIL with "ECDSA signature verification failed". This grounds D5d's
#! fail-closed reject path (R-MINT-14). The triple is generated by INDEPENDENT crates (`k256`).
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG, pad(8)]
#!   Advice stack:  [PK[9], SIG[17], ...]
#! Outputs:
#!   Operand stack: [pad(16)]
#!
#! Where:
#! - PK_COMM is Poseidon2(PK[9]); MSG is the single-word message keccak'd internally to 32 bytes.
#! - PK[9] / SIG[17] are the packed public key and signature on the advice stack.
#!
#! Panics if:
#! - the public key does not hash to PK_COMM, or the signature verification fails.
#!
#! Invocation: call
pub proc ecdsa_verify_msg_canary
    exec.ecdsa_k256_keccak::verify
    # => [pad(16)]
end
