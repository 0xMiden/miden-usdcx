# xusdc::canary::storage_map
#
# Storage-MAP grounding canary (P5-01). TRIVIAL scratch component that proves the
# StorageSlot::Map read / write / empty-key primitive end to end under MockChain on the pinned
# Miden v0.15.3 / assembler 0.23.3 stack. It is NOT the real nonce registry or attester
# allowlist: it writes a fixed marker at a fixed key, reads it back, and reads an unset key —
# exactly the shape D5c's replay check (usedNonces[KEY] == EMPTY_WORD) and D5d's allowlist build
# on. Proc bodies mirror the live protocol precedent in
# protocol-pin-v0.15.3/crates/miden-standards/asm/standards/access/rbac.masm (a storage Map used
# as an access-control registry): read via active_account::get_map_item, write via
# native_account::set_map_item, slot bound by hashed name via word("...")[0..2].

use miden::protocol::active_account
use miden::protocol::native_account

# CONSTANTS
# =================================================================================================

# Map storage slot. The slot id is the hash of this namespaced label; the Rust harness binds the
# same string via StorageSlotName::new("xusdc::canary::storage_map::used"). The word("...")[0..2]
# slot-id binding was proven for value slots by the 08 grounding spike (Q4) and is re-proven here
# for a MAP slot.
pub const USED_SLOT = word("xusdc::canary::storage_map::used")

# Fixed test key written by map_write_marker and read back by map_read_test. Declared identically
# in the Rust harness; the passing test is the masm-rust-constant-parity check.
const TEST_KEY = [11, 12, 13, 14]

# A key that is never written — map_read_unset reads it to prove the unset/default return value.
const UNSET_KEY = [21, 22, 23, 24]

# The marker value written at TEST_KEY. The flag lives in the first felt (mirrors rbac.masm's
# SET_MEMBERSHIP = [1, 0, 0, 0]); any value other than EMPTY_WORD works.
const MARKER = [1, 0, 0, 0]

# PUBLIC API
# =================================================================================================

#! Writes the fixed MARKER word at the fixed TEST_KEY in the USED map slot.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - MARKER is the marker value written at TEST_KEY.
#!
#! Panics if:
#! - the USED slot does not exist or is not a map slot.
#! - the invocation does not originate from the native account.
#!
#! Invocation: call
pub proc map_write_marker
    push.MARKER
    # => [MARKER]

    push.TEST_KEY
    # => [TEST_KEY, MARKER]

    push.USED_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, TEST_KEY, MARKER]

    exec.native_account::set_map_item
    # => [OLD_VALUE]

    dropw
    # => []
end

#! Returns the value stored at the fixed TEST_KEY in the USED map slot.
#!
#! Inputs:  [pad(16)]
#! Outputs: [VALUE, pad(12)]
#!
#! Where:
#! - VALUE is the value at TEST_KEY, or EMPTY_WORD if TEST_KEY has not been written.
#!
#! Panics if:
#! - the USED slot does not exist or is not a map slot.
#!
#! Invocation: call
pub proc map_read_test
    push.TEST_KEY
    # => [TEST_KEY]

    push.USED_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, TEST_KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    # drop one pad word from below VALUE to restore the call-return stack depth of 16
    swapw dropw
    # => [VALUE]
end

#! Returns the value stored at the never-written UNSET_KEY in the USED map slot.
#!
#! Inputs:  [pad(16)]
#! Outputs: [VALUE, pad(12)]
#!
#! Where:
#! - VALUE is the value at UNSET_KEY, which is EMPTY_WORD because the key is never written.
#!
#! Panics if:
#! - the USED slot does not exist or is not a map slot.
#!
#! Invocation: call
pub proc map_read_unset
    push.UNSET_KEY
    # => [UNSET_KEY]

    push.USED_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, UNSET_KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    # drop one pad word from below VALUE to restore the call-return stack depth of 16
    swapw dropw
    # => [VALUE]
end
