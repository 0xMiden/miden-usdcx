[Unit]
Description=Independent CCTP incoming deposit worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cctp-worker
Group=cctp-worker
StateDirectory=cctp-worker
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/cctp-deposit-relayer --config /etc/cctp-worker/profile.json --export-filter cctp_deposit_relayer=info
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cctp-worker
MemoryMax=1G
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
