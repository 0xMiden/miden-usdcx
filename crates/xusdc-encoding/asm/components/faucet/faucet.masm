# The xUSDC faucet account component: the account's callable surface, and nothing else.
#
# Everything the faucet can be asked to do from outside goes through one of these two procedures.
# Both live in the xreserve library; this file is what makes them the account's surface, so the set
# of externally reachable procedures is a decision recorded here rather than a side effect of which
# library procedure happens to carry the account-procedure attribute.

pub use {set_attester} from xreserve::attester_admin
pub use {check_policy} from xreserve::mint_policy
