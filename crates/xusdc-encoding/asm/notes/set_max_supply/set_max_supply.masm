# xreserve_set_max_supply_note — the root-pinned set_max_supply admin note script.
#
# The admin surface for the STOCK `set_max_supply` under the network account: a fixed-root note whose
# parameter is CREATOR-COMMITTED in note storage. It stages the note storage into memory, marshals the
# creator's param onto the stack in the proc's Inputs order, and `call`s the
# `ADMIN`-role-gated (via the account Authority) stock
# `miden::standards::faucets::fungible::set_max_supply` (the gate lives in the proc; the note sender is
# kernel-forced, so a creator without the `ADMIN` role traps there). The `call` resolves to the SAME
# proc root the faucet exposes via the FungibleFaucet component re-exports. A scheme-2
# NetworkAccountTarget routing attachment addresses the note at the faucet (routing-only).
#
# Note storage layout (1 felt): [new_max_supply].

use miden::protocol::active_note
use miden::standards::faucets::fungible

# CONSTANTS
# =================================================================================================

const SET_MAX_SUPPLY_NOTE_NUM_ITEMS = 1

# ERRORS
# =================================================================================================

const ERR_XRESERVE_SET_MAX_SUPPLY_NOTE_STORAGE = "set_max_supply note storage item count is invalid"

# PUBLIC INTERFACE
# =================================================================================================

#! Consumes the `set_max_supply` admin note and drives the `ADMIN`-role-gated max-supply write.
#!
#! Stages the creator-committed param (`[new_max_supply]`) into memory at address zero, marshals it
#! onto the stack as `[new_max_supply, pad(15)]`, and `call`s the stock `fungible::set_max_supply`.
#!
#! Requires that the account exposes:
#! - miden::standards::faucets::fungible::set_max_supply procedure.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ARGS is unused.
#!
#! Note storage is assumed to be as follows:
#! - new_max_supply is the new maximum supply as an AssetAmount felt (item 0).
#!
#! Panics if:
#! - the note storage does not carry exactly 1 item.
#! - the max supply is not mutable, the note sender does not hold the `ADMIN` role, or the faucet is paused, or
#!   new_max_supply < token_supply (the stock set_max_supply gate chain).
#!
#! Invocation: dyncall
@note_script
pub proc main
    dropw
    # => [pad(16)]

    push.0 exec.active_note::get_storage
    # => [num_items, pad(16)]

    eq.SET_MAX_SUPPLY_NOTE_NUM_ITEMS assert.err=ERR_XRESERVE_SET_MAX_SUPPLY_NOTE_STORAGE
    # => [pad(16)]

    push.0 mem_load
    # => [new_max_supply, pad(16)]

    call.fungible::set_max_supply
    # => [pad(17)]

    drop
    # => [pad(16)]
end
